
# Generated failure log (tools/sweep-diff.pl input)
.faillog/

# Nested git worktree created by background agents (has its own .git)
.claude/worktrees/
.suitelog/
*~
.suitelog-*/

# A saved SBCL core built INTO the checkout (tools/install-pcl --prefix .).
# PCLSbcl picks up <root>/pcl.core automatically, which is the point — but it
# is a ~60 MB build artifact, never a tracked file.
/pcl.core

# s486b measurement outputs (regenerable: scratch/s486b/measure.pl)
scratch/*/out/

# tools/everyday-smoke.pl's results and per-program work directories.
# The CORPUS is everyday/ and is tracked; this is where a run puts what it
# produced (.out/.err/.rc) and the fresh cwd each program gets.
/.everyday/

# Claude Code's lock file inside the task store, which lives in the repo
# (dot-claude-in-home-dir/README.md).  The tasks and notes are tracked; the
# lock is machine state.
/dot-claude-in-home-dir/tasks/pcl/.lock
/dot-claude-in-home-dir/tasks/pcl/.s470br-note
