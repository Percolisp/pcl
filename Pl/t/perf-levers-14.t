# ─────────────────────────────────────────────────────────────────────────────
# #3220 MECHANISM: a double's `%.15g' text and sprintf's `%.Nf' text are built
# IN PLACE in ONE fresh string -- beyond the digit generation
# (%p-float-digits / %p-scaled-round) each conversion allocates exactly the
# answer (<= 64 bytes for these lengths).  The base built a 15-digit string,
# then SUBSEQs and a CONCATENATE (128-192 bytes), or went through FORMAT.
like(lisp_out(<<'END_LISP'),
(flet ((per (f x) (funcall f x) (let ((b0 (sb-ext:get-bytes-consed))) (funcall f x) (round (- (sb-ext:get-bytes-consed) b0) 100000))))
  (let ((g (compile nil '(lambda (x) (dotimes (i 100000) (%p-float-g15-string x)))))
        (d (compile nil '(lambda (x) (dotimes (i 100000) (%p-float-digits (abs x) 15)))))
        (f (compile nil '(lambda (x) (dotimes (i 100000) (sprintf-format-float-f x 3)))))
        (r (compile nil '(lambda (x) (dotimes (i 100000) (multiple-value-bind (m e) (integer-decode-float x) (%p-scaled-round m e 3)))))))
    (format t "TEXT=~:[big~;small~]~%"
            (and (every (lambda (x) (<= (- (per g x) (per d x)) 64)) (list 1.2345d0 -0.000123d0 1.5d300 123.25d0))
                 (every (lambda (x) (<= (- (per f x) (per r x)) 64)) (list 1.2345d0 123.25d0))))))
END_LISP
     qr/TEXT=small/, '#3220: %.15g and %.3f text cost one string beyond the digit generation');

answers(<<'END_SRC', <<'END_EXP', '#3220 answers: float stringification and sprintf/printf %g %e %f %.0f %.15g %s %d %x with widths, flags and precisions over ties, powers of ten, denormals, huge / tiny values, Inf, NaN and the integer-valued doubles');
my @v = (0.1+0.2, 1e21, 1e-7, 2**53, 1/3, 1e15, 3.0, 1/7, 0, 1.5, 2.5, -2.5, 123456.789, 1e100, 1e-100,
         9**9**9, -9**9**9, 1e300*1e10, 0.000123456, 99999999999999.9, 999999999999999.9, 1e16, 1.23e-5,
         -1234.5678, 5e-324, 1.7976931348623157e308, 0.5, 100, 1e14, 12345678901234567, 0.1, -0.1, 1e-4, 9.999999999999999e-5,
         1e5, 123.456e10, 3.14159265358979, -1e-300, 4.35, 0.045, 1e-5, 2**63, -2**62);
my $nan = 9**9**9 / 9**9**9;
push @v, $nan;
for my $x (@v) {
  print "s[", $x, "] q[$x] ";
  printf("%g|%e|%f|%.0f|%.15g|%s|%5.2f|%-8.3e|%+g|%.3f|%.10f|%.20f|%.1f\n",
         $x, $x, $x, $x, $x, $x, $x, $x, $x, $x, $x, $x, $x);
}
for my $x (1.5, 2.7, -3.9, 1e10, 255.5) { printf("%d %s %x %.0f\n", $x, $x, $x, $x) }
print 0.1+0.2, " ", 1e21, " ", 3.0, " ", 1/7, " ", -1/7, " ", 1e15, " ", 1e-5, "\n";
my $c = 0; for my $i (1..2000) { my $x = sqrt($i) * 1.5; $c++ if sprintf('%.0f', $x) eq $x; $c += length("$x") } print "$c\n";
print join(",", map { $_ / 8 } 1..20), "\n";
print join(",", map { sprintf("%.2f", $_ / 3) } -5..5), "\n";
print join(",", map { sprintf("%.0f", $_ + 0.5) } -4..4), "\n";
printf("%s %s %s\n", 1e-4, 1.0e-4 * 10, 0.00001234);
printf("%.30f|%.25g|%.17g\n", 1e-20, 1/3, 0.1);
printf("[%08.3f] [%-10.2f] [% f] [%+.2e]\n", 3.14159, 2.5, 1.5, 12345.678);
END_SRC
