# pcl — run a Perl script (or inline code) through PCL, like `perl`.
#
#   pcl script.pl [args...]      run a script
#   pcl -e 'code'  [args...]     run inline code   (-E is an alias of -e)
#   pcl -c script.pl             syntax-check only
#   pcl --clear-cache            wipe the cached compiled modules AND the cached runtime cores, then exit
#   pcl --make-core              (re)build the cached runtime core now, then exit
#
# A "core" is a memory image of SBCL with the PCL runtime preloaded; running
# from it skips re-loading the runtime (~1s → ~0.1s).  It is a pure speed
# cache, and since s439 it is the DEFAULT: the first run compiles the runtime
# into ~/.pcl-cache/core/ and every later run uses it; the core's name is a
# hash of the runtime source + the SBCL version, so an edit or an upgrade
# simply produces a new one (tools/lib/PCLSbcl.pm, the ONE SBCL command
# builder every PCL runner shares).  --make-core only forces that build early.
# (`pcl` itself transpiles the script fresh every run; compiling a script ONCE
# into a .fasl or a binary is `pl2cl --bundle` / `pl2cl --executable`, and
# `pcl`'s own caching tiers are still Phase 6.)  See `pcl --help`.
#
# Phase 1 of docs/pcl-rollout-plan.md: Tier-0 "transpile-and-run" only — the main
# script is transpiled fresh on every run (no main-script FASL). The module cache
# (use/require) still applies underneath, with its own mtime freshness check.
# Caching tiers (--cache / --fasl) are Phase 6; user test support is Phase 4.

use v5.20;
use strict;
use warnings;
use Getopt::Long qw(:config pass_through require_order no_ignore_case bundling);
use File::Basename qw(dirname basename);
use Cwd qw(abs_path);
use File::Temp qw(tempfile);
use FindBin;
use lib "$FindBin::RealBin/tools/lib";
use PCLSbcl ();   # the ONE builder of an SBCL command line (task #344; cached core s439)
use PCLPaths ();  # the ONE Perl-side reading of $PCL_CACHE_DIR (task #1303)

# The ONE root resolver (task #1302).  $FindBin::RealBin above is the
# BOOTSTRAP — it finds tools/lib so that this line can run; every later path
# derivation goes through root(), which also honours $PCL_ROOT.
my $ROOT    = PCLPaths::root($0);
my $PL2CL   = "$ROOT/pl2cl";
my $RUNTIME = "$ROOT/cl/pcl-runtime.lisp";

# ---- options -------------------------------------------------------------
my ($inline, $check_only, $make_core, $clear_cache, $verbose, $want_help);
my ($cache_info, $want_version, $no_cache);
my (@inc_dirs, @use_mods, $warnings_flag);

GetOptions(
  'e|E=s'       => \$inline,         # inline code; -E is a plain alias of -e
  'I=s@'        => \@inc_dirs,        # prepend dir(s) to @INC
  'M=s@'        => \@use_mods,        # `use Module` before the script
  'c'           => \$check_only,      # syntax-check only
  'w'           => \$warnings_flag,   # accepted; PCL warning behaviour is fixed (no-op)
  'clear-cache' => \$clear_cache,
  'cache-info'  => \$cache_info,
  'no-cache'    => \$no_cache,        # forwarded to pl2cl; there is no second mechanism
  'make-core'   => \$make_core,
  'version'     => \$want_version,
  'v|verbose'   => \$verbose,
  'h|help'      => \$want_help,
) or die usage();

print(usage()), exit 0 if $want_help;

my $cache_dir = PCLPaths::cache_root();

# ---- one-shot maintenance actions (no script needed) ---------------------
if ($want_version) { print version_info(); exit 0 }
if ($clear_cache)  { clear_cache(); exit 0 }
if ($cache_info)   { cache_info();  exit 0 }
if ($make_core)    { make_core();   exit 0 }

# ---- figure out the source + the script's own @ARGV ----------------------
my $source = (!defined $inline && @ARGV) ? shift(@ARGV) : undef;
my @script_args = @ARGV;          # everything left belongs to the script

die usage() unless defined $inline || defined $source;
if (defined $source && !-f $source) {
  die "pcl: can't open script \"$source\": No such file or directory\n";
}

# ---- transpile to a temp .lisp (Tier 0) ----------------------------------
my $lisp = transpile($source, $inline);

if ($check_only) {
  my $name = defined $source ? $source : '-e';
  say "$name syntax OK";
  unlink $lisp;
  exit 0;
}

# ---- run --------------------------------------------------------------------
exec_sbcl($lisp, \@script_args);   # never returns

# ===========================================================================
# Helpers
# ===========================================================================

# Build the `use`/`no` line for one -M argument, matching perl(1) semantics:
#   Module            → use Module;
#   Module=a,b        → use Module split(/,/,q{a,b});  (i.e. import a, b)
#   -Module           → no Module;
#   -Module=a,b       → no Module split(/,/,q{a,b});
sub _use_line_for_M {
  my ($spec) = @_;
  my $verb = 'use';
  if ($spec =~ s/^-//) { $verb = 'no'; }
  if ($spec =~ /^([\w:]+)=(.*)$/s) {
    my ($mod, $imports) = ($1, $2);
    # Perl passes the import list as split(/,/, "...").  Emit explicit
    # quoted args so the module's import() sees the same list.
    my @args = split /,/, $imports, -1;
    my $list = join(', ', map { my $a = $_; $a =~ s/(['\\])/\\$1/g; "'$a'" } @args);
    return "$verb $mod ($list);\n";
  }
  return "$verb $spec;\n";
}

# Transpile $source (a file) or $inline (a code string), honouring -M.
# Returns the path to a temp .lisp (cleaned up at exit).
sub transpile {
  my ($source, $inline) = @_;

  my $tmp = mktmp('.lisp');

  # -M Module  →  prepend `use Module;` lines. If any are present (or we're in
  # -e mode), assemble the full source text and transpile that; otherwise
  # transpile the file directly so line numbers and the source dir are preserved.
  # Match perl's -M semantics:
  #   -MModule              → use Module;
  #   -MModule=arg1,arg2    → use Module split(/,/,q{arg1,arg2});
  #   -M-Module             → no Module;        (leading '-')
  #   -M-Module=arg1,arg2   → no Module split(...);
  my $use_prefix = join('', map { _use_line_for_M($_) } @use_mods);

  my @inc_args = map { ("-I", $_) } ($ROOT, @inc_dirs);   # -I dirs ride pl2cl's @INC

  my $src_path;          # the .pl file we hand to pl2cl
  my @cleanup;
  if (defined $inline) {
    $src_path = mktmp('.pl');
    write_file($src_path, $use_prefix . $inline . "\n");
    push @cleanup, $src_path;
  }
  elsif ($use_prefix ne '') {
    # File + -M: prepend the use-lines into a temp copy, but keep the original
    # directory on @INC (-I) so the script's own `use`/`do` still resolve.
    $src_path = mktmp('.pl');
    write_file($src_path, $use_prefix . slurp($source));
    push @inc_args, "-I", dirname(abs_path($source));
    push @cleanup, $src_path;
  }
  else {
    $src_path = $source;
  }

  say STDERR "pcl: transpiling $src_path" if $verbose;
  # --no-cache is pl2cl's own flag (it emits `(setf pcl::*pcl-skip-cache* t)`
  # into the preamble); forwarding it is the whole implementation — a second
  # mechanism here would be a second answer to the same question (rule 11).
  my $rc = run('perl', @inc_args, $PL2CL, ($no_cache ? '--no-cache' : ()),
               $src_path, { stdout => $tmp });
  unlink @cleanup;

  if ($rc != 0) {
    unlink $tmp;
    exit($rc >> 8 || 1);           # pl2cl already wrote the error to stderr
  }
  register_cleanup($tmp);
  return $tmp;
}

# Build the SBCL command and exec it (replacing this process so the script's
# exit code becomes pcl's). @ARGV is injected as a fresh vector of raw strings;
# warnings/verbose load chatter is muffled so only the program's own output shows.
# (SBCL-version policing lives in the runtime itself — the first form of
# cl/pcl-runtime.lisp warns on a too-old host; no extra process here.)
sub exec_sbcl {
  my ($lisp, $args) = @_;

  my $argv_form = '(setf pcl::@ARGV '
    . cl_string_vector(@$args) . ')';

  my $quiet_load = sub {
    my ($file) = @_;
    return '(let ((*load-verbose* nil) (*load-print* nil)'
         . ' (*compile-verbose* nil) (*compile-print* nil))'
         . ' (handler-bind ((warning #\'muffle-warning))'
         . qq{ (load #P"$file"}.')))';
  };

  # The prefix (--core placement, stack size, banner flags) comes from
  # tools/lib/PCLSbcl.pm like every other PCL runner's: an explicit $PCL_CORE
  # wins, else the installed or the CACHED core (built on first use), else the
  # runtime is loaded from source.  In that last case the --load is swapped for
  # this tool's quiet load so compile notes do not reach the user's terminal —
  # the same file, the same flags, only muffled.
  my @cmd = ('sbcl', PCLSbcl::sbcl_prefix(runtime => $RUNTIME, core => $ENV{PCL_CORE}));
  for my $i (0 .. $#cmd - 1) {
    if ($cmd[$i] eq '--load' && $cmd[$i + 1] eq $RUNTIME) {
      splice @cmd, $i, 2, '--eval', $quiet_load->($RUNTIME);
      last;
    }
  }
  push @cmd, '--eval', $argv_form;
  push @cmd, '--eval', $quiet_load->($lisp);

  say STDERR "pcl: exec @cmd" if $verbose;
  exec { $cmd[0] } @cmd or die "pcl: cannot exec sbcl: $!\n";
}

# Build (or rebuild) the cached runtime core now.  The same core every run
# picks up by itself on first use; this only does it early and says where.
sub make_core {
  my $c = PCLSbcl::cached_core($RUNTIME, force => 1)
    or die "pcl: core build failed (see the .failed marker in " . PCLSbcl::core_cache_dir() . ")\n";
  say "pcl: cached runtime core is $c";
}

sub clear_cache {
  # Remove cached compiled modules AND the cached runtime cores; the next run
  # rebuilds what it needs.  A module entry is three files under modules/ —
  # the transpiled .lisp, its compiled .fasl, and since task #1261 the .deps
  # DEPENDENCY MANIFEST that decides whether the other two are still valid.
  # (The flat `$cache_dir/*.lisp|*.fasl` glob is kept for entries written
  # before #1261 moved them into modules/.)
  my @files = (glob("\Q$cache_dir\E/modules/*"),
               glob("\Q$cache_dir\E/*.fasl"), glob("\Q$cache_dir\E/*.lisp"));
  my $n = @files ? unlink(@files) : 0;
  my $k = PCLSbcl::clear_cached_cores();
  # …and the transpile-time prototype facts (task #560), which live under the
  # same root and are keyed the same way.
  require lib; lib->import("$ROOT");
  require Pl::ProtoCache;
  my $p = Pl::ProtoCache::clear();
  say "pcl: cleared $n cached module file(s) from $cache_dir, $p prototype entr(y|ies) from "
    . Pl::ProtoCache::cache_dir() . " and $k runtime core file(s) from "
    . PCLSbcl::core_cache_dir();
}

# ---- pcl --version -------------------------------------------------------

# Four numbers, because "which PCL is this" has four answers that can disagree:
# the release, the cache GENERATION (which decides whether a cached module
# transpile is reused), the SBCL that will run the code, and the PPI that will
# parse it.  A bug report needs all four.
sub version_info {
  return join("\n",
    "pcl (PCL) " . pcl_version(),
    "cache generation: " . cache_generation(),
    sbcl_version(),
    "PPI " . ppi_version()) . "\n";
}

# An INSTALLED tree carries a VERSION file written by tools/install-pcl; a
# checkout answers `git describe`.  Neither: say so plainly — a guessed
# version is worse than none in a bug report.
sub pcl_version {
  if (open my $fh, '<', "$ROOT/VERSION") {
    my $v = <$fh>; close $fh;
    chomp $v if defined $v;
    return $v if defined $v && length $v;
  }
  if (-d "$ROOT/.git" || -f "$ROOT/.git") {
    my $v = qx{git -C \Q$ROOT\E describe --tags --always 2>/dev/null};
    chomp $v if defined $v;
    return "$v (git checkout)" if defined $v && length $v;
  }
  return "unknown (no VERSION file, and not a git checkout)";
}

# THE generation string lives in cl/pcl-runtime.lisp and has exactly one
# reader, Pl::ProtoCache::generation (task #560) — never copied.
sub cache_generation {
  require lib; lib->import("$ROOT");
  require Pl::ProtoCache;
  return Pl::ProtoCache::generation();
}

sub sbcl_version {
  my $v = qx{sbcl --version 2>/dev/null};
  chomp $v if defined $v;
  return (defined $v && length $v) ? $v : "SBCL (not on PATH)";
}

sub ppi_version {
  my $v = eval { require PPI; $PPI::VERSION };
  return defined $v ? $v : "(not installed)";
}

# ---- pcl --cache-info ----------------------------------------------------

# The one diagnostic for "PCL did not notice my change": where the cache is,
# what is in it, which core this run would use, and the compile policy in
# force.  The last of those is resolved by the RUNTIME (two directory lists,
# realpath'd at call time), so this asks the runtime rather than re-deriving
# it — one resolver, rule 11.  Measured cost of that question: ~0.2 s with a
# saved core, which is the price of any `pcl` run.
sub cache_info {
  my $src = PCLPaths::cache_root_source() eq 'env'
          ? 'from $PCL_CACHE_DIR' : 'default: $HOME/.pcl-cache';
  say "Cache directory: $cache_dir  ($src)";
  if (my $problem = PCLPaths::cache_dir_problem($cache_dir)) {
    say "  UNSAFE: $problem -- PCL refuses to use it.  chmod 700 $cache_dir";
  }
  print_kinds();
  say core_line();
  say "Compile policy (as the runtime resolves it):";
  print runtime_cache_info();
}

# Size and count per kind.  modules/ is broken down by extension because the
# three files of an entry answer different questions: the .lisp is the
# transpile, the .deps its dependency manifest (what makes it valid), the
# .fasl the compiled form, and a .failed marker means a compile that did not
# work and is not retried for an hour.
sub print_kinds {
  for my $kind (qw(modules proto core xs)) {
    my @f = grep { -f $_ } glob("\Q$cache_dir\E/$kind/*");
    my $bytes = 0; $bytes += -s $_ for @f;
    if (!@f) { say sprintf("  %-9s (empty)", "$kind/"); next }
    my $extra = '';
    if ($kind eq 'modules') {
      my %n;
      for my $f (@f) { $n{$1}++ if $f =~ /\.(lisp|fasl|deps|failed)$/ }
      $extra = sprintf("  %d transpiles, %d fasls, %d manifests, %d failed",
                       map { $n{$_} // 0 } qw(lisp fasl deps failed));
    }
    say sprintf("  %-9s %5d files, %9s%s", "$kind/", scalar(@f),
                human_bytes($bytes), $extra);
  }
  return 1;
}

sub human_bytes {
  my ($b) = @_;
  return "$b B" if $b < 1024;
  my @u = qw(KB MB GB);
  my $n = $b / 1024;
  for my $u (@u) {
    return sprintf("%.1f %s", $n, $u) if $n < 1024 || $u eq 'GB';
    $n /= 1024;
  }
}

# Which core this run would use, and why — asked of PCLSbcl, the ONE builder
# of an SBCL command line, rather than re-deriving its five-step order here.
sub core_line {
  my @cmd = PCLSbcl::sbcl_prefix(runtime => $RUNTIME, core => $ENV{PCL_CORE});
  my ($core) = map { $cmd[$_ + 1] } grep { $cmd[$_] eq '--core' } 0 .. $#cmd - 1;
  return "Core for this run: none -- the runtime is loaded from source"
       . ($ENV{PCL_NO_CORE} ? " (PCL_NO_CORE=1)" : " (no core could be built)")
    unless defined $core;
  my $why = $ENV{PCL_CORE} && $core eq $ENV{PCL_CORE} ? "named by \$PCL_CORE"
          : index($core, "$cache_dir/core/") == 0     ? "the cached core, built on first use"
          :                                             "the installed core, built by tools/install-pcl";
  return "Core for this run: $core\n  ($why)";
}

# The compile policy, printed by the runtime that resolves it.
sub runtime_cache_info {
  my @cmd = ('sbcl', PCLSbcl::sbcl_prefix(runtime => $RUNTIME, core => $ENV{PCL_CORE}),
             '--eval', '(pcl::p-cache-info)');
  my $out = qx{@{[ join ' ', map { quotemeta } @cmd ]} 2>/dev/null};
  # In source mode the runtime announces itself as it loads; that is the
  # loader talking, not the answer.
  $out =~ s/^(?:PCL Runtime loaded|;.*)\n//gm if defined $out;
  return "  (could not ask the runtime)\n" unless defined $out && $out =~ /\S/;
  $out =~ s/^/  /gm;
  return $out;
}

# ---- small utilities -----------------------------------------------------

# Format a list of strings as a CL adjustable vector literal of raw strings.
sub cl_string_vector {
  my @parts = map { '"' . cl_escape($_) . '"' } @_;
  my $n = scalar @parts;
  return "(make-array $n :adjustable t :fill-pointer $n"
       . ($n ? " :initial-contents (list @parts)" : "")
       . ")";
}

sub cl_escape {
  my ($s) = @_;
  $s =~ s/\\/\\\\/g;
  $s =~ s/"/\\"/g;
  return $s;
}

# Run a command. Last arg may be a {stdout => path} hashref to redirect stdout.
# Returns the raw $? value.
sub run {
  my @args = @_;
  my $opts = (ref $args[-1] eq 'HASH') ? pop @args : {};
  if (my $out = $opts->{stdout}) {
    my $pid = fork // die "fork: $!";
    if ($pid == 0) {
      open(STDOUT, '>', $out) or die "pcl: cannot write $out: $!\n";
      exec { $args[0] } @args or die "pcl: cannot exec $args[0]: $!\n";
    }
    waitpid($pid, 0);
    return $?;
  }
  system { $args[0] } @args;
  return $?;
}

sub slurp {
  my ($path) = @_;
  open my $fh, '<', $path or die "pcl: cannot read $path: $!\n";
  local $/; my $c = <$fh>; close $fh; return $c;
}

sub write_file {
  my ($path, $content) = @_;
  open my $fh, '>', $path or die "pcl: cannot write $path: $!\n";
  print $fh $content; close $fh;
}

sub mktmp {
  my ($suffix) = @_;
  my ($fh, $name) = tempfile("pcl_${$}_XXXX", TMPDIR => 1, SUFFIX => $suffix);
  close $fh;
  return $name;
}

{
  my @to_clean;
  sub register_cleanup { push @to_clean, @_ }
  END { unlink @to_clean if @to_clean }
}

sub usage {
  return <<'USAGE';
Usage: pcl [options] script.pl [script-args...]
       pcl [options] -e 'code'  [script-args...]

Runs a Perl script (or inline code) by transpiling it to Common Lisp and
executing it under SBCL. Works like `perl` for the Perl subset PCL supports.

Options:
  -e CODE        run inline CODE (like perl -e)
  -E CODE        alias of -e
  -I DIR         prepend DIR to @INC (repeatable)
  -M MODULE      `use MODULE` before running (repeatable)
  -c             syntax-check only: transpile, print "syntax OK", exit
  -w             accepted for compatibility (PCL's warning behaviour is fixed)
  -v, --verbose  print the underlying sbcl command pcl runs
  --version      print the PCL, cache-generation, SBCL and PPI versions
  -h, --help     this message

Caches:
  PCL caches two things, both purely for speed and neither able to change a
  result: a saved SBCL core with the PCL runtime compiled in (startup ~1 s ->
  ~0.1 s), and, per module you `use`, its transpiled Common Lisp plus a
  compiled fasl.  A cached module is re-transpiled when its own file changes,
  and also when any module whose prototypes or exports its parse read changes.
  Everything lives under PCL_CACHE_DIR (below), in a directory PCL creates
  with mode 0700 -- a cached module is code, so PCL refuses to load out of a
  directory anybody else could write to.

  --cache-info   Print where the cache is, what is in it, which core this run
                 would use, and the compile policy in effect.  The one
                 diagnostic for "PCL did not notice my change".
  --no-cache     This run reads and writes no module cache -- the one-flag
                 answer to "is it the cache?".
  --make-core    Build the cached runtime core now, then exit.  Every run
                 builds and uses one BY DEFAULT (the first use compiles it;
                 the core is named by a hash of the runtime + the SBCL
                 version, so an edit or an upgrade simply makes a new one) --
                 this flag only does the build early.
  --clear-cache  Remove everything PCL made under PCL_CACHE_DIR -- the cached
                 modules (.lisp / .fasl / .deps), the transpiler's prototype
                 facts and the saved cores -- then exit.  The next run
                 rebuilds what it needs.  XS artifacts are NOT a cache and are
                 left alone: they are installed by tools/pcl-xs-install and
                 removed by its --clean.

Notes:
  * Every run of `pcl` transpiles your script fresh; only `use`/`require`d
    modules are cached (caching the script itself is Phase 6 of
    docs/pcl-rollout-plan.md).  To compile a script ONCE, use the compiler
    directly: `pl2cl --executable -o prog prog.pl` saves a binary that runs
    the program, and `pl2cl --bundle -o prog.fasl prog.pl` a .fasl that runs
    it when loaded.  Neither embeds the module closure yet, so both still
    read this PCL tree at run time for a `require` that misses the cache and
    for the pack/mro/warnings extensions (docs/single-binary-plan.md).
  * --make-core / --clear-cache / --no-cache only affect speed, never results.

Environment:
  PCL_CACHE_DIR         The root of every per-user cache: the compiled modules,
                        the prototype facts, the saved cores and the XS
                        artifacts (default ~/.pcl-cache).
  PCL_COMPILE_DIRS      Colon-separated directories, PERL5LIB syntax: a module
                        whose source lies under one of them is compiled to
                        native code and cached.  `*` = every directory.  UNSET
                        = perl's installed library directories plus PCL's own
                        lib/ -- so a module you are EDITING is cached as text,
                        never as an opaque fasl.
  PCL_NO_COMPILE_DIRS   Same syntax; a module under one of these is NEVER
                        compiled.  Wins over PCL_COMPILE_DIRS on any match;
                        `*` = compile nothing.  (PCL_NO_FASL_CACHE=1 is the
                        kept alias of exactly that.)
  PCL_CORE=path         Use THIS saved core instead of the cached one.
  PCL_NO_CORE=1         Never build or use the cached core (an installed core
                        still counts).

  _PCL_RUNTIME_         SET BY PCL, not read by it -- the one honest signal
                        that Perl code is running under PCL.  Its value is the
                        version `pcl --version` prints, so
                        `if ($ENV{_PCL_RUNTIME_}) {...}` is the test and
                        `print "PCL $ENV{_PCL_RUNTIME_}"` says which.
                        It is SYNTHETIC -- present in %ENV, exists, keys, each
                        and every %ENV copy, and absent from the real
                        environment -- so a CHILD PROCESS DOES NOT INHERIT IT
                        ($^X is real perl; a perl child that saw it would
                        believe it runs under PCL).  A PCL child sets its own.
USAGE
}
