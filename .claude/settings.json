{
  "permissions": {
    "allow": [
      "Bash(sed:*)",
      "Bash(./clt:*)",
      "Bash(emacs:*)",
      "Bash(.claude/hooks/fmtlisp:*)",
      "Bash(perl .claude/hooks/split-lisp.pl:*)",
      "Bash(grep:*)",
      "Bash(perl:*)",
      "Bash(prove:*)",
      "Bash(perl sweep-perl-tests.pl:*)",
      "Bash(./pl2cl:*)",
      "Bash(sbcl:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(echo:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-lisp.sh"
          }
        ]
      }
    ]
  }
}
