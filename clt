#!/usr/bin/env perl
# clt — compile a single perl-tests/*.t file to CL, save as /tmp/<name>.lisp.
#
# Usage:  ./clt loopctl          # or: ./clt loopctl.t
#
# Generates /tmp/<name>.lisp  (transpiled CL code)
# Prints the lisp file path to stderr, content to stdout.

use strict;
use warnings;
use File::Basename qw(dirname);
use Cwd qw(abs_path);

my $name = shift or die "Usage: $0 <test-name>\n";
$name =~ s/\.t$//;

my $root  = abs_path(dirname($0));
my $lisp  = "/tmp/$name.lisp";
my $tests = "$root/perl-tests";

chdir $tests or die "chdir $tests: $!\n";
my $rc = system("perl -I$root $root/pl2cl --no-cache --lenient-ppi $name.t >$lisp 2>/tmp/$name.pl2cl.err");
if ($rc != 0) {
    my $err = do { local $/; open(my $f,'<',"/tmp/$name.pl2cl.err") or die; <$f> };
    print STDERR "Transpile failed:\n$err";
    exit 1;
}

print STDERR "$lisp\n";
open(my $fh, '<', $lisp) or die "read $lisp: $!\n";
print while <$fh>;
