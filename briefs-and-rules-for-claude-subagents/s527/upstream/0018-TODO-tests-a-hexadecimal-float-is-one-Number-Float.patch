From 5be090dbdd63f45987821f6e0f07460c01146e12 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 24 Oct 2026 20:47:35 +0300
Subject: [PATCH 18/85] TODO tests: a hexadecimal float is one Number::Float

perl 5.22 added hexadecimal floating point literals, and
perl -e 'print 0x1.8p+1' prints 3.  PPI splits 0x1.8p+1 into a Hex
number, a Float, a Word, an operator and a number.  A control keeps
0x1.8 (no exponent, so 0x1 concatenated with 8) starting with 0x1.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/07_token.t | 31 ++++++++++++++++++++++++++++++-
 1 file changed, 30 insertions(+), 1 deletion(-)

diff --git a/t/07_token.t b/t/07_token.t
index 65e33c5a..8e1367df 100644
--- a/t/07_token.t
+++ b/t/07_token.t
@@ -8,7 +8,7 @@ sub dies_on_incomplete_bx { $] >= 5.031002 }
 use if !(-e 'META.yml'), "Test::InDistDir";
 use lib 't/lib';
 use PPI::Test::pragmas;
-use Test::More tests => 594 + (warns_on_misplaced_underscore() ? 2 : 0 ) + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 611 + (warns_on_misplaced_underscore() ? 2 : 0 ) + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use File::Spec::Functions qw( catdir );
 use PPI ();
@@ -213,6 +213,35 @@ HEX: {
 	}
 }
 
+HEX_FLOAT: {
+	# perl 5.22+ hexadecimal floating point: perl -e 'print 0x1.8p+1'
+	# prints 3.  The binary exponent (p) is required; without it, 0x1.8
+	# is 0x1 concatenated with 8.
+	TODO: {
+		local $TODO = 'a hexadecimal float is split into several tokens';
+		my @tests = (
+			{ code => '0x1.8p+1',  value => 3 },
+			{ code => '0x.8p1',    value => 1 },
+			{ code => '0x1p-3',    value => 0.125 },
+			{ code => '0x1_0.8p0', value => 16.5 },
+			{ code => '0X1P2',     value => 4 },
+		);
+		foreach my $test ( @tests ) {
+			my $code = $test->{code};
+			my $T = PPI::Tokenizer->new( \$code );
+			my $token = $T->get_token;
+			isa_ok($token, 'PPI::Token::Number::Float');
+			is($token->content, $code, "'$code' is one token");
+			is($token->literal, $test->{value}, "literal('$code') is $test->{value}");
+		}
+	}
+	my $code = '0x1.8';
+	my $T = PPI::Tokenizer->new( \$code );
+	my $token = $T->get_token;
+	isa_ok($token, 'PPI::Token::Number::Hex');
+	is($token->content, '0x1', "'0x1.8' (no exponent) starts with the hex number 0x1");
+}
+
 OCTAL: {
 	my @tests = (
 		{ code => '0o10', parsed => '0o10', value => 8 },
-- 
