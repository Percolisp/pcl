From 436169bb2c5425f5dc1adb71f16bbfaae5fdfd52 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Thu, 29 Oct 2026 00:56:08 +0200
Subject: [PATCH 50/99] TODO test: *: is a glob

$: names a scalar, so *: is the glob that holds it; *::foo stays the
glob main::foo.  One row marked TODO and a control.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 91c3cadd..19baf037 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 177 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 179 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -1353,3 +1353,15 @@ TODO: {
         ok( grep( $_ eq $want, @t ), "$code: $desc" ) or diag "got: @t";
     }
 }
+
+# §26, the colon: $: names a scalar, so *: is a glob, while *::foo stays the
+# glob main::foo.
+TODO: {
+    local $TODO = 'PCL §26: A glob whose NAME is punctuation or a digit run is split into two operators';
+    my @t = map { short_class($_) } toks('*X = *:;');
+    ok( grep( $_ eq 'Symbol=*:', @t ), '*: is one glob' ) or diag "got: @t";
+}
+{
+    my @t = map { short_class($_) } toks('*X = *::foo;');
+    ok( grep( $_ eq 'Symbol=*::foo', @t ), '*::foo stays one glob (control)' ) or diag "got: @t";
+}
