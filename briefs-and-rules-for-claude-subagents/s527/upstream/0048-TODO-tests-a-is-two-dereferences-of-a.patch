From 59e0c3b9d66a6cc070cd06ca5bff8f40d18df837 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Thu, 29 Oct 2026 00:49:31 +0200
Subject: [PATCH 48/89] TODO tests: $$$a is two dereferences of $a

perl reads $$$a as ${${$a}}; PPI lexes the magic $$ (the process id)
followed by $a.  The rows are those of upstream PR #428 (Perl-Critic/PPI,
fixing issue #60), plus $$$$b, which perl reads as three dereferences;
marked TODO.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_token_magic.t | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/t/ppi_token_magic.t b/t/ppi_token_magic.t
index eaface90..128ac1fd 100644
--- a/t/ppi_token_magic.t
+++ b/t/ppi_token_magic.t
@@ -4,7 +4,7 @@
 
 use lib 't/lib';
 use PPI::Test::pragmas;
-use Test::More tests => 42 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 52 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 use Helper 'safe_new';
@@ -54,3 +54,19 @@ PUNCTUATION_ARRAY: {
 	my ($tok) = grep { $_->significant } $doc->tokens;
 	is( ($tok ? ref($tok) . '=' . $tok->content : ''), 'PPI::Token::Magic=@?', '@? is one Magic token' );
 }
+
+TRIPLE_DOLLAR: {
+	local $TODO = '$$$a is lexed as the magic $$ and $a';
+	my $document = safe_new \"my \$x = \$\$\$a;";
+	my $casts = $document->find( 'PPI::Token::Cast' ) || [];
+	is( scalar(@$casts), 2, '$$$a produces two Cast tokens' );
+	is( $casts->[0] && $casts->[0]->content, '$', 'first Cast is $' );
+	is( $casts->[1] && $casts->[1]->content, '$', 'second Cast is $' );
+	my $symbols = $document->find( 'PPI::Token::Symbol' ) || [];
+	my @non_x = grep { $_->content ne '$x' } @$symbols;
+	is( scalar(@non_x), 1, '$$$a produces one non-$x Symbol' );
+	is( $non_x[0] && $non_x[0]->content, '$a', 'the Symbol is $a' );
+	$document = safe_new \"my \$y = \$\$\$\$b;";
+	$casts = $document->find( 'PPI::Token::Cast' ) || [];
+	is( scalar(@$casts), 3, '$$$$b produces three Cast tokens' );
+}
