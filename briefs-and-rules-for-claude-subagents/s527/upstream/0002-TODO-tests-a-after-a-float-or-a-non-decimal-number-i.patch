From 62f45f310596220c79d936dc40054679a8215a5f Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 24 Oct 2026 20:31:25 +0300
Subject: [PATCH 02/93] TODO tests: a - after ], a float or a non-decimal
 number is subtraction

perl -e 'my @x=(5,9); print $x[1]-2, " ", 1.5-0.5, " ", 0x10-1, "\n"'
prints "7 1 15": after a term the - is the binary operator.  PPI reads
the - and its digits as one negative Number (or a dashed Word, for
(1)-length) after a closing ], after a Float, Exp, Hex, Octal or Binary
number, and -- the existing TODO -- after a closing ).

The plan grows by 21 (seven cases, each three tests through safe_new).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_token_operator.t | 23 ++++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/t/ppi_token_operator.t b/t/ppi_token_operator.t
index 45839322..ef1edc1a 100644
--- a/t/ppi_token_operator.t
+++ b/t/ppi_token_operator.t
@@ -4,7 +4,7 @@
 
 use lib 't/lib';
 use PPI::Test::pragmas;
-use Test::More tests => 3073 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 3094 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 use PPI::Singletons qw( %KEYWORDS %OPERATOR );
@@ -727,4 +727,25 @@ OPERATORS_PLUS_MINUS: {
         local $TODO = "(1)-2 not parsed correctly";
         is( ref $ops, 'ARRAY', "found operator $op" );
     }
+
+    # A closing ] ends a term as a closing ) does, and so does a number of
+    # any kind, so the - after it is the subtraction operator.
+    TODO: {
+        local $TODO = "a - after ], a float or a non-decimal number is lexed as a negative number";
+        my @more = (
+            '$x[1]', '2',
+            '1.5',   '2',
+            '1e3',   '2',
+            '0x10',  '2',
+            '010',   '2',
+            '0b1',   '2',
+            '(1)',   'length',
+        );
+        for ( my $i = 0; $i < @more; $i += 2 ) {
+            my $code = "$more[$i]-$more[$i + 1]";
+            my $doc  = safe_new \$code;
+            my $ops  = $doc->find('Token::Operator') || [];
+            is( join( ',', map { $_->content } @$ops ), '-', "$code has one - operator" );
+        }
+    }
 }
