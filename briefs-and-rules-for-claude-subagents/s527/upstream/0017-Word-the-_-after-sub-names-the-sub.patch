     my @st  = $doc->schildren;
     is( scalar @st, 2,
@@ -994,8 +993,7 @@ TODO: {
         'the `_` naming the sub is a Token::Word, not Token::Magic' );
 }
 # The forward declaration is the same shape.
-TODO: {
