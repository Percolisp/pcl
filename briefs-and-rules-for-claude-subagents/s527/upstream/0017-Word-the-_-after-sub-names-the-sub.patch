From 8cefefce083749fe9a2bd3e9745366c0e08c64f3 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 24 Oct 2026 20:46:24 +0300
Subject: [PATCH 17/23] Word: the _ after sub names the sub
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A lone _ is the stat filehandle everywhere but right after sub, where
perl reads it as the sub's name.  Both paths that class a lone _ now
ask one helper, so sub _ { ... } and sub _; build a Statement::Sub.

Fixes PCL §31 in t/ppi_bugs_pcl.t.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Token/Word.pm | 16 +++++++++++++---
 t/ppi_bugs_pcl.t      |  6 ++----
 t/ppi_statement_sub.t | 13 +++++--------
 3 files changed, 20 insertions(+), 15 deletions(-)

diff --git a/lib/PPI/Token/Word.pm b/lib/PPI/Token/Word.pm
index 38ed04d3..ecfc3e12 100644
--- a/lib/PPI/Token/Word.pm
+++ b/lib/PPI/Token/Word.pm
@@ -177,9 +177,10 @@ sub __TOKENIZER__on_char {
 		$t->{line_cursor}++;
 		$t->{class} = $t->{token}->set_class( 'Label' );
 
-	# If not a label, '_' on its own is the magic filehandle
+	# If not a label, '_' on its own is the magic filehandle, unless it
+	# names a sub
 	} elsif ( $word eq '_' ) {
-		$t->{class} = $t->{token}->set_class( 'Magic' );
+		$t->{class} = $t->{token}->set_class( __underscore_class($t) );
 
 	}
 
@@ -313,7 +314,7 @@ sub __TOKENIZER__commit {
 				$token_class = 'Word';
 			}
 		} elsif ( $word eq '_' ) {
-			$token_class = 'Magic';
+			$token_class = __underscore_class($t);
 		} else {
 			$token_class = 'Word';
 		}
@@ -346,6 +347,15 @@ sub __current_token_is_attribute {
 	);
 }
 
+# The class of a lone `_`: right after `sub` it names the sub
+# (sub _ { ... }); anywhere else it is the stat filehandle.
+sub __underscore_class {
+	my ( $t ) = @_;
+	my ( $prev ) = $t->_previous_significant_tokens(1);
+	return 'Word' if $prev and $prev->isa('PPI::Token::Word') and $prev->content eq 'sub';
+	return 'Magic';
+}
+
 1;
 
 =pod
