-				'PPI::Token::Structure' => ']',
-				'PPI::Token::Operator' => '%',
-				'PPI::Token::Number' => '-1',
-			]
-		);
-		test_statement(
-			'length($k)*length($k)',
-			[
-				'PPI::Token::Word' => 'length',
-				'PPI::Structure::List' => '($k)',
-				'PPI::Token::Structure' => '(',
-				'PPI::Statement::Expression' => '$k',
-				'PPI::Token::Symbol' => '$k',
-				'PPI::Token::Structure' => ')',
-				'PPI::Token::Operator' => '*',
-				'PPI::Token::Word' => 'length',
-				'PPI::Structure::List' => '($k)',
-				'PPI::Token::Structure' => '(',
