-		);
-	}
+	test_statement(
+		'7%-3',
+		[
+			'PPI::Token::Number' => '7',
+			'PPI::Token::Operator' => '%',
+			'PPI::Token::Number' => '-3',
+		]
+	);
+	test_statement(
+		'$x[0]%-1',
+		[
+			'PPI::Token::Symbol' => '$x',
+			'PPI::Structure::Subscript' => '[0]',
+			'PPI::Token::Structure' => '[',
+			'PPI::Statement::Expression' => '0',
+			'PPI::Token::Number' => '0',
+			'PPI::Token::Structure' => ']',
+			'PPI::Token::Operator' => '%',
+			'PPI::Token::Number' => '-1',
+		]
+	);
+	test_statement(
+		'length($k)*length($k)',
+		[
+			'PPI::Token::Word' => 'length',
+			'PPI::Structure::List' => '($k)',
+			'PPI::Token::Structure' => '(',
+			'PPI::Statement::Expression' => '$k',
+			'PPI::Token::Symbol' => '$k',
+			'PPI::Token::Structure' => ')',
+			'PPI::Token::Operator' => '*',
+			'PPI::Token::Word' => 'length',
+			'PPI::Structure::List' => '($k)',
+			'PPI::Token::Structure' => '(',
+			'PPI::Statement::Expression' => '$k',
+			'PPI::Token::Symbol' => '$k',
+			'PPI::Token::Structure' => ')',
+		]
+	);
 
 	# A scalar filehandle is not a term: what follows it is the first
 	# element of the list (perl -e 'print $fh %h' prints the hash).
