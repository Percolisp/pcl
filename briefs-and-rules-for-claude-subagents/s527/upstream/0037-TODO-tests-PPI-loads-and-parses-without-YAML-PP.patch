From 6613fff5d07a9483db77bf364200e4bcfc4be754 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sun, 25 Oct 2026 21:56:03 +0200
Subject: [PATCH 37/70] TODO tests: PPI loads and parses without YAML::PP

PPI::Document has `use YAML::PP ();` at its top, so PPI cannot be
loaded at all on a machine without YAML::PP -- although YAML::PP is
used only to read $ENV{PPI_CUSTOM_FEATURE_INCLUDES}.  The test refuses
YAML/PP.pm with an @INC hook and loads PPI, parses a document, and then
sets the variable and expects an error that names YAML/PP.pm.

Found when PCL vendored this branch: the first CI run on a stock Ubuntu
runner failed in PPI's load.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_document_optional_yaml.t | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)
 create mode 100644 t/ppi_document_optional_yaml.t

diff --git a/t/ppi_document_optional_yaml.t b/t/ppi_document_optional_yaml.t
new file mode 100644
index 00000000..c8735ada
--- /dev/null
+++ b/t/ppi_document_optional_yaml.t
@@ -0,0 +1,32 @@
+#!/usr/bin/perl
+
+# PPI loads and parses without YAML::PP.  YAML::PP is needed only to read
+# $ENV{PPI_CUSTOM_FEATURE_INCLUDES}, so a machine without it must still be
+# able to use PPI; with the variable set, the error says what is missing.
+
+BEGIN {
+	# Refuse YAML::PP, as on a machine that does not have it installed.
+	unshift @INC, sub {
+		die "Can't locate YAML/PP.pm (refused by $0)\n" if $_[1] eq 'YAML/PP.pm';
+		return;
+	};
+}
+
+use lib 't/lib';
+use PPI::Test::pragmas;
+use Test::More tests => 3 + ( $ENV{AUTHOR_TESTING} ? 1 : 0 );
+
+our $TODO;
+
+delete $ENV{PPI_CUSTOM_FEATURE_INCLUDES};
+
+TODO: {
+	local $TODO = 'PPI::Document loads YAML::PP when it is compiled';
+	ok( eval { require PPI; 1 }, 'PPI loads without YAML::PP' ) or diag $@;
+	my $doc = eval { PPI::Document->new( \'my $x = 1;' ) };
+	ok( $doc && $doc->serialize eq 'my $x = 1;', '... and parses a document' );
+	local $ENV{PPI_CUSTOM_FEATURE_INCLUDES} = 'MyStrict: {signatures: perl}';
+	my $ok = eval { PPI::Document->new( \'use MyStrict;' ); 1 };
+	like( $ok ? '' : $@, qr{YAML/PP\.pm},
+		'... and PPI_CUSTOM_FEATURE_INCLUDES without YAML::PP says YAML::PP is missing' );
+}
