From 176ab5fe7dd1077dd90534a80091ff4aa5a91be4 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 24 Oct 2026 20:38:39 +0300
Subject: [PATCH 08/55] TODO test: @? is one Magic token

Every punctuation variable name is an array name too, and perl -e
'@? = (1,2); print scalar(@?)' prints 2.  PPI lexes @? as a Cast and
an Operator.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_token_magic.t | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/t/ppi_token_magic.t b/t/ppi_token_magic.t
index 93fb4a88..64512c7f 100644
--- a/t/ppi_token_magic.t
+++ b/t/ppi_token_magic.t
@@ -4,7 +4,7 @@
 
 use lib 't/lib';
 use PPI::Test::pragmas;
-use Test::More tests => 39 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 42 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 use Helper 'safe_new';
@@ -46,3 +46,14 @@ END_PERL
 		is( $token->symbol, $name, $remk || "The symbol is $name" );
 	}
 }
+
+PUNCTUATION_ARRAY: {
+	# Every punctuation variable name is an array name too: perl -e
+	# '@? = (1,2); print scalar(@?)' prints 2.
+	TODO: {
+		local $TODO = '@? is lexed as a Cast and an Operator';
+		my $doc = safe_new \'@? = (1,2);';
+		my ($tok) = grep { $_->significant } $doc->tokens;
+		is( ($tok ? ref($tok) . '=' . $tok->content : ''), 'PPI::Token::Magic=@?', '@? is one Magic token' );
+	}
+}
