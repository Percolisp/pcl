From ac62cb8593b4e980b582d5e705e84108d5289840 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 31 Oct 2026 09:56:52 +0200
Subject: [PATCH 94/99] TODO tests: CORE::__END__ / CORE::__DATA__ start an End
 / Data statement
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl ends the code at CORE::__END__ and CORE::__DATA__ exactly as at the
bare spellings (toke.c yyl_data_handle via yyl_word_or_keyword):

    printf %s "print 1;\nCORE::__END__\nnot code\n" | perl    # 1

The tokenizer already makes both a Separator; the Lexer still picks the
statement class by the bare spelling, so the Separator sits in a plain
PPI::Statement.  Two TODO rows (PCL §44); plan 298 -> 300.
---
 t/ppi_bugs_pcl.t | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 35f96fde..6c6f8641 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 298 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 300 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -1668,6 +1668,16 @@ TODO: {
         ok( grep( $_ eq "Separator=CORE::$m", @t ), "CORE::$m is a Separator" ) or diag "got: @t";
     }
 }
+TODO: {
+    local $TODO = 'PCL §44: the CORE:: spelling sits in a plain Statement';
+    for my $m (qw(__END__ __DATA__)) {
+        my $doc = PPI::Document->new(\"print 1;\nCORE::$m\nnot code\n");
+        my @s = map { ref $_ } $doc->schildren;
+        ( my $want = $m ) =~ s/_//g;
+        is( $s[-1], 'PPI::Statement::' . ucfirst lc $want,
+            "CORE::$m starts the same statement as $m" ) or diag "got: @s";
+    }
+}
 
 # §45 -- `&` where a term is expected is the code sigil even before a
 # space and a block (toke.c yyl_ampersand): `& {sub { print "ok\n" }};`
