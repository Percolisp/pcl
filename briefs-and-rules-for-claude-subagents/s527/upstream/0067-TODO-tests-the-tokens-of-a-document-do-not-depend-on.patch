From bd99765fe424ed825d0f2d54960a15af9c63bc3f Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Thu, 29 Oct 2026 00:53:35 +0200
Subject: [PATCH 67/93] TODO tests: the tokens of a document do not depend on
 $/

The tokenizer splits its source on "\n" and then chomps a few pieces
(the rest of a comment line, the rest of the __END__ and __DATA__
lines); chomp removes $/, so in slurp mode -- $/ undefined, which is
what code that has just read the source is likely to have -- a trailing
comment keeps its newline and the newline after __DATA__ / __END__
becomes a Comment, and serialize gains a line.

Two TODO rows: the token list of a snippet with a trailing comment and
a __DATA__ section is the same with $/ undefined and with $/ = "\r\n"
as with the default.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 6ddb9a18..b81d09ee 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 251 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 253 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -1610,3 +1610,23 @@ is_deeply( [ stmts("use feature 'try';\ntry { a() } catch (\$e) { b() }\nd();\n"
               . ( $row ? " (PCL \x{a7}5)" : " (control)" ) );
     }
 }
+
+# §13, the whole of it: the tokens of a document do not depend on the
+# caller's $/.  In slurp mode ($/ undefined, as code that has just read
+# the source is likely to be) a trailing comment absorbs its newline and
+# the newline after __DATA__ / __END__ becomes a Comment.
+{
+    my $src = "# c\nx; # d\n__DATA__\nfoo\n";
+    my $tokens = sub {
+        join '|', map { short_class(ref $_) . '=' . $_->content }
+                  PPI::Document->new(\$src)->tokens;
+    };
+    my $plain   = $tokens->();
+    my $slurped = do { local $/; $tokens->() };
+    my $crlf    = do { local $/ = "\r\n"; $tokens->() };
+    TODO: {
+        local $TODO = 'PCL §13: Tokenization of a trailing __END__/__DATA__ section depends on $/';
+        is( $slurped, $plain, 'the tokens are the same when $/ is undef' );
+        is( $crlf,    $plain, 'the tokens are the same when $/ is "\r\n"' );
+    }
+}
