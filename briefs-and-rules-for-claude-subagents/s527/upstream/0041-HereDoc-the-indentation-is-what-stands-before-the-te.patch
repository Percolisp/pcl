From 3ed5f8839db87e0dafd1c3d3985db30cea645992 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Thu, 29 Oct 2026 00:30:31 +0200
Subject: [PATCH 41/57] HereDoc: the indentation is what stands before the
 terminator
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl strips, from every line of an indented here-doc, the whitespace that
stands before the terminator on its terminator line.  _indent took
^(\s*) of the whole line, which also counts a terminator that itself
begins with whitespace (<<~' EOF') and the newline of an empty one
(<<~''), so the body was left unstripped, or stripped one character too
far, and serialize() added the over-count back.  The indentation is now
the line minus its trailing newline (absent when the line ends the
document) minus the terminator.  The indentation is matched and stripped
as a literal (\Q...\E), not as a pattern.

Fixes PCL §30 in t/ppi_bugs_pcl.t.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Token/HereDoc.pm | 17 +++++++++++------
 t/ppi_bugs_pcl.t         |  6 ++----
 t/ppi_token_heredoc.t    |  3 +--
 3 files changed, 14 insertions(+), 12 deletions(-)

diff --git a/lib/PPI/Token/HereDoc.pm b/lib/PPI/Token/HereDoc.pm
index b2bbaab4..cc363b73 100644
--- a/lib/PPI/Token/HereDoc.pm
+++ b/lib/PPI/Token/HereDoc.pm
@@ -152,13 +152,18 @@ sub _is_terminator {
 
 sub _indent {
 	my ( $self, $token ) = @_;
-	my ($indent) = $token->{_terminator_line} =~ /^(\s*)/;
-	return $indent;
+	# The indentation is what stands before the terminator on its line.  Not
+	# ^(\s*) of the line: that also counts a terminator which itself begins
+	# with whitespace (<<~' EOF'), and the newline of an empty one (<<~'').
+	# The line has no newline when it ends the document.
+	my $line = $token->{_terminator_line};
+	$line =~ s/\n\z//;
+	return substr( $line, 0, length($line) - length( $token->{_terminator} ) );
 }
 
 sub _is_match_indent {
 	my ( $self, $token, $indent ) = @_;
-	return (grep { /^$indent/ || $_ eq "\n" } @{$token->{_heredoc}}) == @{$token->{_heredoc}};
+	return (grep { /^\Q$indent\E/ || $_ eq "\n" } @{$token->{_heredoc}}) == @{$token->{_heredoc}};
 }
 
 
@@ -250,7 +255,7 @@ sub __TOKENIZER__on_char {
 					last;
 				}
 
-				s/^$indent// for @heredoc, $token->{_terminator_line};
+				s/^\Q$indent\E// for @heredoc, $token->{_terminator_line};
 			}
 
 			# The HereDoc is now fully parsed
@@ -289,10 +294,10 @@ sub __TOKENIZER__on_char {
 		$token->{_indentation} = $indent;
 		if ( $self->_is_match_indent( $token, $indent ) ) {
 			# Remove indent from here-doc as much as possible
-			s/^$indent// for @heredoc;
+			s/^\Q$indent\E// for @heredoc;
 		}
 
-		s/^$indent// for $token->{_terminator_line};
+		s/^\Q$indent\E// for $token->{_terminator_line};
 	}
 
 	# Set a hint for PPI::Document->serialize so it can
diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 9eb1ab7d..92e8b3cd 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -927,8 +927,7 @@ TODO: {
 # indentation (and `<<~''` counts the NEWLINE); _is_match_indent then fails and
 # the body is left unstripped — or, when the body is indented as far as the
 # over-count, it is stripped one character too many.
-TODO: {
-    local $TODO = 'PCL §30: An indented here-doc\'s INDENTATION is ^(\s*) of the whole terminator line, so a delimiter that begins with whitespace (or is empty) over-counts';
+{
     for my $c (
       # [ source, what heredoc() should give, label ]
       [ "print <<~' EOF'\n  some data\n   EOF\n", "some data\n",
@@ -959,8 +958,7 @@ TODO: {
 }
 # The second face of the same bug: serialize() rebuilds each body line as
 # `indentation . line`, so the over-count is ADDED and the document grows.
-TODO: {
-    local $TODO = 'PCL §30: An indented here-doc\'s INDENTATION is ^(\s*) of the whole terminator line, so a delimiter that begins with whitespace (or is empty) over-counts';
+{
     my $src = "print <<~' EOF'\n  some data\n   EOF\n";
     my $doc = PPI::Document->new(\$src);
     is( $doc->serialize, $src,
diff --git a/t/ppi_token_heredoc.t b/t/ppi_token_heredoc.t
index d35c38dd..0772e4a8 100644
--- a/t/ppi_token_heredoc.t
+++ b/t/ppi_token_heredoc.t
@@ -400,8 +400,7 @@ h	{
 	# The indentation is what stands BEFORE the terminator on its line, so a
 	# terminator that itself begins with whitespace, or is empty, does not
 	# count towards it (perl strips the same).
-TODO: {
-	local $TODO = 'the indentation is ^(\s*) of the whole terminator line';
+{
 h	{
 		name     => 'Single-quoted terminator beginning with a space (indented).',
 		content  => "my \$heredoc = <<~' HERE';\n\t\tLine 1\n\t\tLine 2\n\t\t HERE\n",
