From 2e44b939a186eb78163ea43b45d9fc41ac18e414 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 31 Oct 2026 10:09:34 +0200
Subject: [PATCH 99/99] Lexer: the class feature builds its statements
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Under the class feature (perl 5.38) `class NAME [VERSION] [ATTRS]
BLOCK` / `class NAME;` declare a package, `method NAME BLOCK` a sub,
`field VAR [ATTRS] [= EXPR];` a variable and `ADJUST BLOCK` a phaser
block (perly.y: KW_CLASS, KW_METHOD_named, KW_FIELD, PHASER):

    perl -E 'use v5.38; use experimental "class"; class P { field $v = 1; method get { $v } } say P->new->get'
    # 1

The Lexer built one plain statement from `class P { ... }` and the
statement after it.  Under the feature, class / field / ADJUST now pick
PPI::Statement::Package / ::Variable / ::Scheduled and `method NAME`
takes the sub detection, which makes it a PPI::Statement::Sub (an
anonymous `method { }` stays an expression).  The braces after the
name are a Block through the existing Package / Sub rules.

These are the statement classes of upstream PR #346 (Perl-Critic/PPI,
by toddr-bot, fixing issue #299), taken for the Lexer half; that PR
also changes the tokenizer (attributes after method / field) which
this commit does not need for the rows here.  Without the feature the
four words stay ordinary words.

Fixes PCL §53 in t/ppi_bugs_pcl.t.
---
 lib/PPI/Lexer.pm | 26 ++++++++++++++++++++------
 t/ppi_bugs_pcl.t |  3 +--
 2 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/lib/PPI/Lexer.pm b/lib/PPI/Lexer.pm
index a2976c07..83410c4a 100644
--- a/lib/PPI/Lexer.pm
+++ b/lib/PPI/Lexer.pm
@@ -382,6 +382,14 @@ my %STATEMENT_CLASSES = (
 	'CORE::__END__'  => 'PPI::Statement::End',
 );
 
+# The statements of the class feature (perl 5.38; perly.y KW_CLASS,
+# KW_FIELD, PHASER), only under the feature
+my %CLASS_FEATURE_STATEMENTS = (
+	'class'  => 'PPI::Statement::Package',
+	'field'  => 'PPI::Statement::Variable',
+	'ADJUST' => 'PPI::Statement::Scheduled',
+);
+
 sub _statement {
 	my ($self, $Parent, $Token) = @_;
 	# my $self   = shift;
@@ -428,12 +436,18 @@ sub _statement {
 
 	# Is it a token in our known classes list
 	my $content = $Token->content;
-	# try and defer open a compound statement only under their feature
+	# try and defer open a compound statement only under their feature;
+	# under the class feature class declares a package, field a variable
+	# and ADJUST a phaser block (method is a sub, below) -- the shapes of
+	# upstream PR #346
+	my $features = $self->{features_stack}[-1] || {};
 	my $class =
-	  ( ( $content eq 'try' or $content eq 'defer' )
-		and ( $self->{features_stack}[-1] || {} )->{$content} )
+	  ( ( $content eq 'try' or $content eq 'defer' ) and $features->{$content} )
 	  ? 'PPI::Statement::Compound'
+	  : ( $features->{class} and $CLASS_FEATURE_STATEMENTS{$content} )
+	  ? $CLASS_FEATURE_STATEMENTS{$content}
 	  : $STATEMENT_CLASSES{$content};
+	my $is_method = $features->{class} && $content eq 'method';
 
 	if ( $class ) {
 		# Is the next significant token a =>
@@ -519,8 +533,8 @@ sub _statement {
 	# If it's a token in our list, use that class
 	return $class if $class;
 
-	# Handle the more in-depth sub detection
-	if ( $is_lexsub || $content eq 'sub' ) {
+	# Handle the more in-depth sub detection (a method NAME is a sub too)
+	if ( $is_lexsub || $content eq 'sub' || $is_method ) {
 		# Read ahead to the next significant token
 		my $Next;
 		while ( $Next = $self->_get_token ) {
@@ -532,7 +546,7 @@ sub _statement {
 
 			# Got the next significant token
 			my $sclass = $STATEMENT_CLASSES{$Next->content};
-			if ( $sclass and $sclass eq 'PPI::Statement::Scheduled' ) {
+			if ( !$is_method and $sclass and $sclass eq 'PPI::Statement::Scheduled' ) {
 				$self->_rollback( $Next );
 				return 'PPI::Statement::Scheduled';
 			}
diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 6f6a6c4e..f0d843a4 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -1853,8 +1853,7 @@ for my $code ( 'my @t = map { $_ => 1 } @x;', 'my @u = map { lc($_) => 1 } @x;'
 # §53 -- the class feature (perl 5.38): `class NAME BLOCK`, `field`,
 # `method NAME BLOCK` and `ADJUST BLOCK` are statements that end at their
 # block, and `class NAME :isa(PARENT)` takes an attribute, not a label.
-TODO: {
-    local $TODO = 'PCL §53: the class syntax builds no statements of its own';
+{
     my @s = stmts(q{use feature 'class'; class P { field $v = 1; method get { $v } } print P->new->get;});
     is( scalar(@s), 3, 'class NAME BLOCK ends at its block' ) or diag join "\n", @s;
     # the shapes of upstream PR #346: class a package, method a sub, field a
-- 
