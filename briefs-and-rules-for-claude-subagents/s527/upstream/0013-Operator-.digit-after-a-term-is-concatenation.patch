From a39e723d30dd35d6834b5ac7f5926b09586c1755 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 24 Oct 2026 20:43:18 +0300
Subject: [PATCH 13/99] Operator: .digit after a term is concatenation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A . followed by a digit starts a number like .5 only where a term is
expected.  After a term -- $_.2, $y[$i].3, "a".5, 1 .5 -- it is the
concatenation operator, as perl reads it.

Fixes PCL §28 in t/ppi_bugs_pcl.t.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Token/Operator.pm |  4 +++-
 t/ppi_bugs_pcl.t          |  6 ++----
 t/ppi_token_operator.t    | 25 +++++++++++--------------
 3 files changed, 16 insertions(+), 19 deletions(-)

diff --git a/lib/PPI/Token/Operator.pm b/lib/PPI/Token/Operator.pm
index 9e93e72b..d5ef4220 100644
--- a/lib/PPI/Token/Operator.pm
+++ b/lib/PPI/Token/Operator.pm
@@ -78,7 +78,9 @@ sub __TOKENIZER__on_char {
 
 	# Handle the special case of a .1234 decimal number
 	if ( $content eq '.' ) {
-		if ( $char =~ /^[0-9]$/ ) {
+		# .5 is a number only in TERM position; after a term ($x.2) it is
+		# the concatenation operator
+		if ( $char =~ /^[0-9]$/ and $t->_opcontext ne 'operator' ) {
 			# This is a decimal number
 			$t->{class} = $t->{token}->set_class('Number::Float');
 			return $t->{class}->__TOKENIZER__on_char( $t );
diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 3e67c83c..caca44b4 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -832,16 +832,14 @@ TODO: {
 # `$_ . 2` (perl -MO=Deparse says so).  PPI leaves NO operator in the stream at
 # all, so a consumer sees two juxtaposed terms.  A space or a non-digit on the
 # right fixes it — the bug needs the digit adjacent.
-TODO: {
-    local $TODO = 'PCL §28: $x.2 — a . followed by a digit after a term is lexed as a Number::Float, so the concatenation OPERATOR disappears';
+{
     my $doc = PPI::Document->new(\'my $x = $_.2;');
     ok( !(grep { $_->isa('PPI::Token::Number') && $_->content eq '.2' } $doc->tokens),
         '`$_.2` should lex as Operator(.) + Number(2), not one Number::Float' )
         or diag "got: " . join(' ', map { short_class(ref $_) . "[" . $_->content . "]" }
                                     grep { $_->significant } $doc->tokens);
 }
-TODO: {
-    local $TODO = 'PCL §28: $x.2 — a . followed by a digit after a term is lexed as a Number::Float, so the concatenation OPERATOR disappears';
+{
     my $doc = PPI::Document->new(\'my $z = $y[1].3;');
     ok( (grep { $_->isa('PPI::Token::Operator') && $_->content eq '.' } $doc->tokens),
         '`].3` should carry a concatenation operator' )
diff --git a/t/ppi_token_operator.t b/t/ppi_token_operator.t
index 109d9c12..b6cc0f5f 100644
--- a/t/ppi_token_operator.t
+++ b/t/ppi_token_operator.t
@@ -755,20 +755,17 @@ DOT_DIGIT_AFTER_A_TERM: {
     # After a term, .2 is the concatenation operator and the number 2:
     # perl -e '$_ = 1; print $_.2' prints 12.  Where a term is expected
     # .5 is the number 0.5.
-    TODO: {
-        local $TODO = '.digit after a term is lexed as a Number::Float';
-        my @concat = (
-            'my $x = $_.2;'      => 'Operator=.,Number=2',
-            'my $z = $y[$i].3;'  => 'Operator=.,Number=3',
-            'my $s = "a".5;'     => 'Operator=.,Number=5',
-        );
-        for ( my $i = 0; $i < @concat; $i += 2 ) {
-            my $doc = safe_new \$concat[$i];
-            my @t = grep { $_->isa('PPI::Token::Operator') && $_->content eq '.' or $_->isa('PPI::Token::Number') }
-                $doc->tokens;
-            my $got = join ',', map { my $c = ref $_; $c =~ s/^PPI::Token:://; "$c=" . $_->content } @t;
-            is( $got, $concat[$i + 1], "tokens of $concat[$i]" );
-        }
+    my @concat = (
+        'my $x = $_.2;'      => 'Operator=.,Number=2',
+        'my $z = $y[$i].3;'  => 'Operator=.,Number=3',
+        'my $s = "a".5;'     => 'Operator=.,Number=5',
+    );
+    for ( my $i = 0; $i < @concat; $i += 2 ) {
+        my $doc = safe_new \$concat[$i];
+        my @t = grep { $_->isa('PPI::Token::Operator') && $_->content eq '.' or $_->isa('PPI::Token::Number') }
+            $doc->tokens;
+        my $got = join ',', map { my $c = ref $_; $c =~ s/^PPI::Token:://; "$c=" . $_->content } @t;
+        is( $got, $concat[$i + 1], "tokens of $concat[$i]" );
     }
     my $doc = safe_new \'my $x = .5;';
     my ($num) = grep { $_->isa('PPI::Token::Number') } $doc->tokens;
-- 
