From 063c917aef66255d8acdcbe05207cb9c20b5ceb5 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Tue, 3 Nov 2026 21:21:23 +0200
Subject: [PATCH 108/127] TODO tests: the attributes of a lexical sub
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl reads the attribute list of a lexical sub (my sub NAME, our sub
NAME, state sub NAME) as it reads a named sub's -- toke.c yyl_sub takes
the same path after the name:

    perl -e 'use feature "lexical_subs"; no warnings; my $x = 43; my sub y :prototype() {$x} print y, "\n"'
    # 43

PPI's __TOKENIZER__is_an_attribute accepts `sub NAME :` only when sub
starts the statement, so after my / our / state the : is an Operator and
the attribute name a Word -- and the prototype is lost.

Four rows inside a new PCL §60 TODO block (my, state, our, a second
attribute after a prototype) and three controls (a named sub, a variable
declaration's attribute, the ternary : after an anonymous sub).
Plan 336 -> 343.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 4f2e09ea..67dc7dcc 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 336 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 343 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -1971,3 +1971,29 @@ for my $code ( 'my @c = map {; { $_, 1 } } @l;', 'my @c = do { { $_, 1 } };' ) {
     my @c = bracket_classes( $code, '{' );
     is( $c[1], 'PPI::Structure::Block', "$code: a block where perl starts a statement (control)" );
 }
+
+# §60 -- the attributes of a LEXICAL sub: after `my sub NAME` (and `our` /
+# `state`) a `:` starts the attribute list as after `sub NAME` (toke.c
+# yyl_sub, the same path for both):
+# `my $x = 43; my sub y :prototype() {$x} print y, "\n"` prints 43.
+TODO: {
+    local $TODO = 'PCL §60: the attribute after my sub NAME is an Operator and a Word';
+    for my $case ( [ 'my sub y :prototype() {$x}', 'Attribute=prototype()' ],
+                   [ 'state sub z :prototype($) { 1 }', 'Attribute=prototype($)' ],
+                   [ 'our sub w :lvalue { $v }', 'Attribute=lvalue' ],
+                   [ 'my sub u :prototype($) :lvalue { $v }', 'Attribute=lvalue' ] ) {
+        my ( $code, $want ) = @$case;
+        my @t = map { short_class($_) } toks($code);
+        ok( grep( $_ eq $want, @t ), "$code: the attribute is an Attribute" ) or diag "got: @t";
+    }
+}
+for my $case ( [ 'sub n :prototype($) { 1 }', 'Attribute=prototype($)' ],
+               [ 'my $x : shared = 1;', 'Attribute=shared' ] ) {
+    my ( $code, $want ) = @$case;
+    my @t = map { short_class($_) } toks($code);
+    ok( grep( $_ eq $want, @t ), "$code: the attribute is an Attribute (control)" ) or diag "got: @t";
+}
+{
+    my @t = map { short_class($_) } toks('my $r = $c ? sub { 1 } : 2;');
+    ok( !grep( /^Attribute/, @t ), 'a ternary : after sub { } is an Operator (control)' ) or diag "got: @t";
+}
