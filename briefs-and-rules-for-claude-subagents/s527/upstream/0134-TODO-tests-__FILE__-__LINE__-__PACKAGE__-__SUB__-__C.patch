From ff1cd0e7b37a4f5902ae639e693255d27c5ce7e6 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 21 Nov 2026 18:05:53 +0200
Subject: [PATCH 134/139] TODO tests: __FILE__, __LINE__, __PACKAGE__, __SUB__,
 __CLASS__ end a term
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl's lexer returns __FILE__, __LINE__ and __PACKAGE__ (and __SUB__,
__CLASS__ under their features) as a whole term and expects an operator
after it (toke.c: FUN0OP / FUN0 set PL_expect = XOPERATOR), as it does
after time or wantarray:

    perl -e 'print __LINE__-1, " ", __FILE__.1, " ", __LINE__.5, "\n"'
    # 0 -e1 15

PPI's term-end table (%NO_OPERAND) knows the builtins that take no
operand but not these five words, so a - or a . before a digit after
them starts a number: __LINE__-1 is Word Number<-1>, __FILE__.1 is Word
Number::Float<.1>; and __LINE__ %h is the hash %h.

Eleven rows inside a new PCL §68 TODO block and seven controls (time-1,
a spaced minus, a comma before -1, a bare -1, x, / and ->).  Plan
459 -> 477.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 30 +++++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 6e511187..b6cf5bc1 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 459 +($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 477 +($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -2238,3 +2238,31 @@ for my $case ( [ 'my $r = [ { "abc", 1 } ];', 'PPI::Structure::Constructor' ], [
     my @c = bracket_classes( $code, '{' );
     is( $c[0], $want, "$code: $want (control)" );
 }
+
+# §68 -- __FILE__, __LINE__, __PACKAGE__, __SUB__ and __CLASS__ take no
+# operand: each is a whole term (toke.c FUN0OP / FUN0: PL_expect =
+# XOPERATOR after it), so what follows is an operator -- a - before a
+# digit subtracts, a . before a digit concatenates, a % or a * is the
+# arithmetic operator:
+# `print __LINE__-1, " ", __FILE__.1, "\n";` prints `0 -e1` under -e.
+TODO: {
+    local $TODO = q{PCL §68: after __FILE__ / __LINE__ / __PACKAGE__ / __SUB__ / __CLASS__ a sign or a dot is read as part of a number};
+    for my $case ( [ q{print __LINE__-1;}, q{Operator=-} ], [ q{my $l = __LINE__ -1;}, q{Operator=-} ],
+                   [ q{is( $@, sprintf("%d", __LINE__ -1) );}, q{Operator=-} ],
+                   [ q{my $n = __PACKAGE__-1;}, q{Operator=-} ], [ q{my $n = __SUB__-1;}, q{Operator=-} ],
+                   [ q{my $n = __CLASS__-1;}, q{Operator=-} ], [ q{print __FILE__.1;}, q{Operator=.} ],
+                   [ q{print __FILE__ .1;}, q{Operator=.} ], [ q{print __LINE__.5;}, q{Operator=.} ],
+                   [ q{print __LINE__ %h;}, q{Operator=%} ], [ q{print __LINE__ *f();}, q{Operator=*} ] ) {
+        my ( $code, $want ) = @$case;
+        my @t = map { short_class($_) } toks($code);
+        ok( grep( $_ eq $want, @t ), "$code: $want after the term" ) or diag "got: @t";
+    }
+}
+for my $case ( [ q{print time-1;}, q{Operator=-} ], [ q{print __LINE__ - 1;}, q{Operator=-} ],
+               [ q{print __LINE__, -1;}, q{Number=-1} ], [ q{print -1;}, q{Number=-1} ],
+               [ q{print __LINE__ x2;}, q{Operator=x} ], [ q{print __LINE__ / 2;}, q{Operator=/} ],
+               [ q{print __PACKAGE__->can("f");}, q{Operator=->} ] ) {
+    my ( $code, $want ) = @$case;
+    my @t = map { short_class($_) } toks($code);
+    ok( grep( $_ eq $want, @t ), "$code: $want (control)" ) or diag "got: @t";
+}
