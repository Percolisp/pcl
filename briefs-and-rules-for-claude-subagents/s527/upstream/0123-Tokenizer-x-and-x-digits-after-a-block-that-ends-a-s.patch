From e45f69ab900af010eb6a40ef4d8378cedfdb372c Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sun, 8 Nov 2026 20:41:30 +0200
Subject: [PATCH 123/127] Tokenizer: x and x<digits> after a block that ends a
 statement are words
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl's x is the repetition operator only under XOPERATOR (toke.c,
yylex: case 'x'), and after the } of a block that opens a statement or
takes a list (BEGIN { }, sub NAME { }, map { }, a bare block) perl does
not expect an operator.  _current_x_is_operator now asks
_after_statement_block -- the rule _minus_starts_term and the / and <
decisions already use -- so sub x3 { } x3() and map { } x3() call x3,
and sub x { } x calls x (PCL §19's statement-start row).

_after_statement_block learns the two block shapes it missed, for all
four of its callers: a sub definition whose body follows a prototype or
attributes (sub f ($) { }, sub f :lvalue { }; _before_sub_decorations
steps back to the NAME, or to sub for an anonymous sub, a term), and a
block after the ) of a compound statement's condition, a foreach list or
a named sub's signature (_paren_heads_statement_block; toke.c: an XBLOCK
pushes XSTATE), so if (1) { } -e $f is a filetest.

Fixes PCL §63.  Removes the TODO marker of its eleven rows and of the
statement-start row of the catalogue section on a sub named x (19b),
which the same rule fixes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Tokenizer.pm | 65 +++++++++++++++++++++++++++++++++++++++++++-
 t/ppi_bugs_pcl.t     |  6 ++--
 2 files changed, 66 insertions(+), 5 deletions(-)

diff --git a/lib/PPI/Tokenizer.pm b/lib/PPI/Tokenizer.pm
index 528c3689..8bf73167 100644
--- a/lib/PPI/Tokenizer.pm
+++ b/lib/PPI/Tokenizer.pm
@@ -947,14 +947,72 @@ sub _after_statement_block {
 	return '' if !$close->isa('PPI::Token::Structure') or $close->content ne '}';
 	my $kind = $self->_curly_kind($cursor);
 	return '' if !$kind or $kind ne 'block';
-	my ( $prev ) = $self->_significant_before( $self->_matching_curly($cursor) );
+	my ( $prev, $at ) = $self->_before_sub_decorations(
+		$self->_significant_before( $self->_matching_curly($cursor) ) );
 	return 1 if !$prev or $prev->isa('PPI::Token::Label')
 		or $prev->isa('PPI::Token::Format');
 	my $content = $prev->content;
 	return 1 if $prev->isa('PPI::Token::Structure') and ( $content eq ';' or $content eq '}' );
+	return $self->_paren_heads_statement_block($at)
+		if $prev->isa('PPI::Token::Structure') and $content eq ')';
 	return $prev->isa('PPI::Token::Word') && $content ne 'sub' && $content ne 'return';
 }
 
+# The token before the { of a sub's body may be its prototype or its
+# attributes (sub f ($) { }, sub f :lvalue { }); step back over them to the
+# sub's NAME (a definition, after which a statement starts) or to sub itself
+# (an anonymous sub, a term).  Takes and returns ( token, index ).
+sub _before_sub_decorations {
+	my ( $self, $prev, $at ) = @_;
+	my $attr = '';
+	while ( $prev ) {
+		if ( $prev->isa('PPI::Token::Attribute') ) {
+			$attr = 1;
+		} elsif ( $attr and $prev->isa('PPI::Token::Operator') and $prev->content eq ':' ) {
+			$attr = '';
+		} elsif ( !$prev->isa('PPI::Token::Prototype') ) {
+			last;
+		}
+		( $prev, $at ) = $self->_significant_before($at);
+	}
+	return ( $prev, $at );
+}
+
+# True when the ) at index $cursor closes the condition of a compound
+# statement (if, elsif, unless, while, until, for, foreach -- also with a
+# loop variable) or the signature of a named sub, so the { after it opens a
+# block after which a statement starts (toke.c: an XBLOCK pushes XSTATE).
+my %PAREN_BLOCK_WORD = map { $_ => 1 } qw( if elsif unless while until for foreach );
+my %LOOP_VARIABLE_DECL = map { $_ => 1 } qw( my our state );
+
+sub _paren_heads_statement_block {
+	my ( $self, $cursor ) = @_;
+	my $tokens = $self->{tokens};
+	my $depth  = 1;
+	while ( --$cursor >= 0 ) {
+		my $token = $tokens->[$cursor];
+		next if !$token->isa('PPI::Token::Structure');
+		$depth++ if $token->content eq ')';
+		$depth-- if $token->content eq '(';
+		last if !$depth;
+	}
+	return '' if $cursor < 0;
+	my ( $prev, $at ) = $self->_before_sub_decorations( $self->_significant_before($cursor) );
+	return '' if !$prev;
+	if ( $prev->isa('PPI::Token::Symbol') ) {
+		( $prev, $at ) = $self->_significant_before($at);
+		( $prev, $at ) = $self->_significant_before($at)
+			if $prev and $prev->isa('PPI::Token::Word') and $LOOP_VARIABLE_DECL{ $prev->content };
+		return $prev && $prev->isa('PPI::Token::Word')
+			&& ( $prev->content eq 'for' or $prev->content eq 'foreach' );
+	}
+	return '' if !$prev->isa('PPI::Token::Word');
+	return 1 if $PAREN_BLOCK_WORD{ $prev->content };
+	my ( $sub ) = $self->_significant_before($at);
+	return $sub && $sub->isa('PPI::Token::Word') && $sub->content eq 'sub'
+		&& $prev->content ne 'sub';
+}
+
 # True where a * can only open a glob name: at the start of the document,
 # where the operator context says an operand follows, or after local or
 # return, which take a term.
@@ -1133,9 +1191,14 @@ sub _current_x_is_operator {
 
 	return !$self->__current_token_is_forced_word('x') if $prev->isa('PPI::Token::Word');
 
+	# After the } of a block that ends a statement (sub x3 { } x3();) or
+	# takes a list (map { } x3()) perl expects a statement or a term, and
+	# x is the repetition operator only where it expects an operator
+	# (toke.c: case 'x' tests PL_expect == XOPERATOR), so x, x3 are words.
 	return (!$prev->isa('PPI::Token::Operator') || $X_CAN_FOLLOW_OPERATOR{$prev})
 		&& (!$prev->isa('PPI::Token::Structure') || $X_CAN_FOLLOW_STRUCTURE{$prev})
 		&& !$prev->isa('PPI::Token::Label')
+		&& !$self->_after_statement_block
 	;
 }
 
diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 85ea99c1..cbf77ac0 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -466,8 +466,7 @@ TODO: {
 # whenever the previous token is a sub definition's closing brace, which is
 # exactly how a sub named `x` is called with neither parens nor arguments.
 # perl's own t/op/lexsub.t writes `{ my sub x {…} x }` twice.
-TODO: {
-    local $TODO = 'PCL §19: A call to a sub named x after a list operator is lexed as the repetition operator';
+{
     my $doc = PPI::Document->new(\'sub x { print "PKG\n" } x');
     my ($op) = grep { $_->isa('PPI::Token::Operator') && $_->content eq 'x' }
                $doc->tokens;
@@ -2095,8 +2094,7 @@ for my $case ( [ 'print -e::foo;', 'Operator=-e' ], [ 'print - Foo::bar;', 'Word
 # a compound statement's block or a map / grep / sort block it expects a
 # statement or a term, so the word is a call:
 # `sub x3 { print "called\n" } x3();` prints called.
-TODO: {
-    local $TODO = 'PCL §63: x<digits> after a statement block is lexed as the repetition operator';
+{
     for my $code ( 'sub x3 { 1 } x3();', 'sub x64 { 1 } x64 1;', 'my @m = map { 1 } x3();',
                    'BEGIN { 1 } x3();', '{ 1 } x3();', 'if (1) { 2 } x3();',
                    'for my $i (1) { } x3();', 'sub z :lvalue { 1 } x3();',
-- 
