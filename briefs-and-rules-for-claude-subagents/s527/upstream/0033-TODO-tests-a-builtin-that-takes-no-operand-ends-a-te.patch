From df9e06cb1f8471c278f93b61e22173d21845eb10 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sun, 25 Oct 2026 21:41:39 +0200
Subject: [PATCH 33/55] TODO tests: a builtin that takes no operand ends a term

perl -e 'print time.2' prints the time with a 2 appended, and
`time %.5e1` is a modulo: time, wait, wantarray, fork, getppid and the
other builtins without an operand are a whole term, so the tokenizer is
in operator position after them.  PPI makes .2 a number, -1 a negative
number, *f a glob and %. a magic hash there.  A control pins time before
=> as a word.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 54d0ae24..04bc669b 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 149 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 155 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -1237,3 +1237,27 @@ TODO: {
         ok( grep( $_ eq $want, @t ), "$code: $desc" ) or diag "got: @t";
     }
 }
+
+# §55, a builtin that takes no operand is a whole TERM: time, wait,
+# wantarray, fork, getppid, ... (perl -e 'print time.2' prints the time
+# with a 2 appended; `time %.5e1` is a modulo).  After one of them the
+# tokenizer is in operator position.
+{
+    my @rows = (
+        [ '$t = time %.5e1;', 'Operator=%', 'after time % is modulo' ],
+        [ '$t = time.2;',     'Operator=.', 'after time . concatenates' ],
+        [ '$t = wait-1;',     'Operator=-', 'after wait - subtracts' ],
+        [ '$t = time %~$y;',  'Operator=%', 'after time %~ is modulo of a complement' ],
+        [ '$t = time*f();',   'Operator=*', 'after time * multiplies' ],
+    );
+    TODO: {
+        local $TODO = 'PCL §55: a builtin that takes no operand does not end a term';
+        for my $r (@rows) {
+            my ( $code, $want, $desc ) = @$r;
+            my @t = map { short_class($_) } toks($code);
+            ok( grep( $_ eq $want, @t ), "$code: $desc" ) or diag "got: @t";
+        }
+    }
+    my @t = map { short_class($_) } toks('my %h = (time => 1);');
+    ok( grep( $_ eq 'Word=time', @t ), 'time before => stays a word (control)' ) or diag "got: @t";
+}
