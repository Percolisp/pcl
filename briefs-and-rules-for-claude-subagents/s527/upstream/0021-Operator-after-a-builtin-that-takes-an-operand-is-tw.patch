From e309445bf2822207c3bcd3f79a909c8166fc5304 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 24 Oct 2026 20:58:45 +0300
Subject: [PATCH 21/99] Operator: ~~ after a builtin that takes an operand is
 two complements
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The term-position test for ~~ now also answers yes after a builtin
named in %KEYWORDS that takes an operand (print ~~$y, return ~~@a),
unless it is a method name after ->; after one that takes none (time,
wantarray, ...) it stays the smart match.

Completes PCL §21 in t/ppi_bugs_pcl.t (its print ~~$y spelling).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Token/Operator.pm | 34 +++++++++++++++++++++++++++-------
 t/ppi_token_operator.t    | 19 ++++++++-----------
 2 files changed, 35 insertions(+), 18 deletions(-)

diff --git a/lib/PPI/Token/Operator.pm b/lib/PPI/Token/Operator.pm
index d5ef4220..c29e181c 100644
--- a/lib/PPI/Token/Operator.pm
+++ b/lib/PPI/Token/Operator.pm
@@ -41,7 +41,7 @@ L<PPI::Token> and L<PPI::Element> classes.
 
 use strict;
 use PPI::Token ();
-use PPI::Singletons '%OPERATOR';
+use PPI::Singletons qw' %OPERATOR %KEYWORDS ';
 
 our $VERSION = '1.292';
 
@@ -66,12 +66,8 @@ sub __TOKENIZER__on_char {
 		return 1;
 	}
 	# Where a term is expected, ~~ is two bitwise complements (~~$y), not
-	# the smart match.  Only a known operand position counts (or the start
-	# of the document): after a match or a method name _opcontext cannot
-	# say, and those take ~~.
-	if ( $content eq '~' and $char eq '~'
-		and ( $t->_opcontext eq 'operand' or !$t->_last_significant_token )
-	) {
+	# the smart match.
+	if ( $content eq '~' and $char eq '~' and __term_expected($t) ) {
 		return $t->_finalize_token->__TOKENIZER__on_char( $t );
 	}
 	return 1 if $OPERATOR{ $content . $char };
@@ -110,6 +106,30 @@ sub __TOKENIZER__on_char {
 	$t->_finalize_token->__TOKENIZER__on_char( $t );
 }
 
+# Builtins that take no operand: after one of them an operator follows
+# (time ~~ @a is a smart match).
+my %NO_OPERAND = map { $_ => 1 } qw(
+	time times wait wantarray fork getppid getlogin
+	getgrent gethostent getnetent getprotoent getpwent getservent
+	endgrent endhostent endnetent endprotoent endpwent endservent
+	setgrent setpwent
+);
+
+# Is a TERM expected where the tokenizer now stands?  Only what is known
+# counts: after an operator, an opening bracket or a ; (_opcontext), at the
+# start of the document, and after a builtin that takes an operand (print,
+# return, ...).  After a match, a method name or a user's word it cannot
+# say, and the answer is no.
+sub __term_expected {
+	my ( $t ) = @_;
+	my ( $prev, $prevprev ) = $t->_previous_significant_tokens(2);
+	return 1 if !$prev;
+	return 1 if $t->_opcontext eq 'operand';
+	return '' if !$prev->isa('PPI::Token::Word');
+	return '' if $prevprev and $prevprev->isa('PPI::Token::Operator') and $prevprev->content eq '->';
+	return $KEYWORDS{ $prev->content } && !$NO_OPERAND{ $prev->content };
+}
+
 1;
 
 =pod
diff --git a/t/ppi_token_operator.t b/t/ppi_token_operator.t
index 5c5b7b6d..7e12e3ff 100644
--- a/t/ppi_token_operator.t
+++ b/t/ppi_token_operator.t
@@ -753,17 +753,14 @@ TERM_INITIAL_COMPLEMENTS: {
     # After a builtin that takes an operand, a term is expected too
     # (print ~~$y numifies $y); after one that takes none (time,
     # wantarray) the ~~ is the smart match.
-    TODO: {
-        local $TODO = '~~ after a builtin list operator is lexed as a smart match';
-        my @after_listop = (
-            'print ~~$y;'            => '~,~',
-            'return ~~@a;'           => '~,~',
-        );
-        for ( my $i = 0; $i < @after_listop; $i += 2 ) {
-            my $doc = safe_new \$after_listop[$i];
-            my $ops = $doc->find('Token::Operator') || [];
-            is( join( ',', map { $_->content } @$ops ), $after_listop[$i + 1], "operators of $after_listop[$i]" );
-        }
+    my @after_listop = (
+        'print ~~$y;'            => '~,~',
+        'return ~~@a;'           => '~,~',
+    );
+    for ( my $i = 0; $i < @after_listop; $i += 2 ) {
+        my $doc = safe_new \$after_listop[$i];
+        my $ops = $doc->find('Token::Operator') || [];
+        is( join( ',', map { $_->content } @$ops ), $after_listop[$i + 1], "operators of $after_listop[$i]" );
     }
     my @no_operand = (
         'my $r = time ~~ @a;'        => '=,~~',
