From 3ddbee5e279598bf6664fa66ed34105c78505e2c Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Thu, 29 Oct 2026 00:37:44 +0200
Subject: [PATCH 42/85] TODO tests: a - that starts a term after a filehandle
 or a block
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl reads a - as the start of a term in the filehandle slot of
print $fh LIST when whitespace stands before it and none after it
(perl -e 'print $fh -1' prints -1 to $fh; print $fh -e $f is a filetest),
and after the } of a block that ends a statement or takes a list
(BEGIN { 1 } -e _, { 1 } -e $f, sort { $a <=> $b } -1, 2).  PPI's
operator context makes it a subtraction there.  Four rows marked TODO
beside the three existing §22 and §35 rows; three controls pin a spaced
- after the handle, a - after an anonymous sub and a - after a subscript
as subtractions.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 37 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 36 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 92e8b3cd..6b30b870 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 157 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 164 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -1268,3 +1268,38 @@ TODO: {
     ok( grep( $_ eq 'Magic=%^H', @t ), '`%^H` stays one Magic token (control)' )
         or diag "got: @t";
 }
+
+# §22 and §35, the rest of the rule.  perl reads a - as the start of a TERM
+# (toke.c: PL_expect = XTERM) in two places where PPI's operator context says
+# subtraction: in the filehandle slot of print $fh LIST, when whitespace
+# stands before the - and none after it (perl -e 'print $fh -1' prints -1 to
+# $fh), and after the } of a block that ends a statement or takes a list
+# (BEGIN { 1 } -e $f, { 1 } -e $f, sort { $a <=> $b } -1, 2).
+TODO: {
+    local $TODO = 'PCL §22/§35: a - that starts a term is lexed as a subtraction';
+    my @rows = (
+        [ 'print $fh -1;',                'Number=-1',   'print $fh -1 prints the number -1 to $fh' ],
+        [ '{ 1 } -e $f;',                 'Operator=-e', 'a filetest after a bare block' ],
+        [ 'END { 1 } -e $f;',             'Operator=-e', 'a filetest after an END block' ],
+        [ '@s = sort { $a <=> $b } -1, 2;', 'Number=-1', 'sort BLOCK -1, 2 sorts the number -1' ],
+    );
+    for my $r (@rows) {
+        my ( $code, $want, $desc ) = @$r;
+        my @t = map { short_class($_) } toks($code);
+        ok( grep( $_ eq $want, @t ), "$code: $desc" ) or diag "got: @t";
+    }
+}
+# The controls: a spaced - after the handle, a - after an anonymous sub and a
+# - after a subscript stay subtractions.
+{
+    my @rows = (
+        [ 'print $fh - e $f;',       'Word=e',     'print $fh - e $f subtracts a call of e (control)' ],
+        [ 'my $s = sub { 1 } - 1;',  'Operator=-', 'an anonymous sub minus 1 subtracts (control)' ],
+        [ '$x = $h{a} -1;',          'Operator=-', 'a subscript minus 1 subtracts (control)' ],
+    );
+    for my $r (@rows) {
+        my ( $code, $want, $desc ) = @$r;
+        my @t = map { short_class($_) } toks($code);
+        ok( grep( $_ eq $want, @t ), "$code: $desc" ) or diag "got: @t";
+    }
+}
