@@ -2449,8 +2449,7 @@ for my $case ( [ q{my $n = 7%12;}, q{Operator=%} ], [ q{my $n = $x %12;}, q{Oper
 # filetest, stat and lstat (toke.c reads _ as a plain word; op.c's ck_ftst
 # gives the bareword _ its meaning there); elsewhere a bareword _ is the
 # string "_" (`my $v = _;`), or a call when a sub _ is declared.
-TODO: {
-    local $TODO = q{PCL §73: _ where perl reads a name is lexed as the stat filehandle};
+{
     for my $code ( q{sub _ { "x" } print _(), "y";}, q{print _("text");}, q{print _ ("text");},
                    q{my %h = (_ => 1);}, q{my $v = __PACKAGE__->_();}, q{my $v = $o->_;},
                    q{my @l = sort _ @x;}, q{my $v = $h{_};},
diff --git a/t/ppi_statement_sub.t b/t/ppi_statement_sub.t
index 9f379a03..d457a773 100644
--- a/t/ppi_statement_sub.t
+++ b/t/ppi_statement_sub.t
@@ -288,7 +288,8 @@ sub test_subs {
 
 SUB_NAMED_UNDERSCORE: {
 	# `_` after `sub` is the sub's name: perl -e 'sub _ { "x" } print _()'
-	# prints x.  Anywhere else a lone `_` is the stat filehandle.
+	# prints x.  As the operand of a filetest, stat or lstat a lone `_` is
+	# the stat filehandle.
 	for my $code ( 'sub _ { "x" } print 1;', 'sub _; print 1;', 'sub _ { "x" }' ) {
 		my $doc = safe_new \$code;
 		my ($sub) = $doc->schildren;
