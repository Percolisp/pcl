From 7bd8dfcd2516566b7df5c61b18277517e79dd64d Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sun, 1 Nov 2026 03:58:43 +0200
Subject: [PATCH 100/119] TODO tests: the ( after a method named if or while
 holds its arguments
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A word after -> is a method name: toke.c reads it where it expects an
operator, never as a keyword, so a method may be named like a condition
keyword and its ( is the argument list, as after any method name:

    perl -e 'sub F::if { "if$_[1]" } print F->if(1), "\n"'
    # if1

The Lexer's _round looks the word up in its keyword table without
asking whether it follows ->, so $f->if(1), ->elsif(, ->unless(,
->while( and ->until( build a PPI::Structure::Condition (->for( and
->foreach( come out a List only because the ForLoop check reblesses a
For with fewer than two statements).  Template Toolkit's generated
grammar calls $factory->if(...) and $factory->while(...).

Five rows inside a new PCL §58 TODO block, and a control: the parens
of if (...) / elsif (...) stay conditions.  Plan 304 -> 310.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index f0d843a4..47f976b3 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 304 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 310 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -1909,3 +1909,19 @@ for my $code ( 'my @t = map { $_ => 1 } @x;', 'my @u = map { lc($_) => 1 } @x;'
     my @t = map { short_class($_) } toks('{ my sub s { 1 } s(1); } s/a/b/;');
     is( $t[-2], 'Regexp::Substitute=s/a/b/', 'after the block of my sub s, s/a/b/ substitutes again' ) or diag "got: @t";
 }
+
+# §58 -- a METHOD named like a condition keyword: a word after -> is a
+# method name (toke.c reads it where it expects an operator), so the ( after
+# it holds the method's arguments, as after any other method name:
+# `sub F::if { "if$_[1]" } print F->if(1)` prints if1.
+TODO: {
+    local $TODO = 'PCL §58: the ( after a method named if / elsif / unless / while / until is a Condition';
+    for my $kw (qw(if elsif unless while until)) {
+        my @c = bracket_classes( "\$f->$kw(1);", '(' );
+        is( $c[0], 'PPI::Structure::List', "\$f->$kw(1): the ( after a method named $kw is a List" );
+    }
+}
+{
+    my @c = bracket_classes( 'if ($x) { 1 } elsif ($y) { 2 }', '(' );
+    is( "@c", 'PPI::Structure::Condition PPI::Structure::Condition', 'if (...) / elsif (...): conditions (control)' );
+}
