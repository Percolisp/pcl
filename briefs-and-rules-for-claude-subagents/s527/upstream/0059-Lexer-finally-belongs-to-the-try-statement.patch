From 4e021b91b9881e8e551114482b3cfb70b420325d Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Thu, 29 Oct 2026 00:37:04 +0200
Subject: [PATCH 59/70] Lexer: finally belongs to the try statement
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl's grammar (perly.y, the try rule) reads try BLOCK catch (VAR) BLOCK
and an optional finally BLOCK as one statement that needs no ;.
_continues stopped the try compound after the catch block, so finally
{ ... } started a new, unterminated statement that swallowed the next
one.  The try branch now continues after the try block on catch or
finally, after the catch block on finally, and ends after the finally
block -- which also covers Syntax::Keyword::Try's try BLOCK finally
BLOCK.

Regression pair 60_try_finally (the plans of 08_regression.t and
25_increment.t enumerate the directory).  Fixes PCL §18 in
t/ppi_bugs_pcl.t (three rows).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Lexer.pm                         | 22 ++++--
 t/08_regression.t                        |  2 +-
 t/25_increment.t                         |  2 +-
 t/data/08_regression/60_try_finally.code |  5 ++
 t/data/08_regression/60_try_finally.dump | 99 ++++++++++++++++++++++++
 t/ppi_bugs_pcl.t                         |  6 +-
 6 files changed, 122 insertions(+), 14 deletions(-)
 create mode 100644 t/data/08_regression/60_try_finally.code
 create mode 100644 t/data/08_regression/60_try_finally.dump

diff --git a/lib/PPI/Lexer.pm b/lib/PPI/Lexer.pm
index 5bdeb9de..daae6b4d 100644
--- a/lib/PPI/Lexer.pm
+++ b/lib/PPI/Lexer.pm
@@ -910,17 +910,23 @@ sub _continues {
 	}
 
 	if ( $type eq 'try' and $LastChild->presumed_features->{try} ) {
+		# try BLOCK catch (VAR) BLOCK
+		# try BLOCK catch (VAR) BLOCK finally BLOCK
+		# try BLOCK finally BLOCK                    (Syntax::Keyword::Try)
 		return 1 if not $LastChild->isa('PPI::Structure::Block');
 
+		# The block after a finally ends the statement
 		my $NextLast = $Statement->schild(-2);
-		return ''
-		  if $NextLast
-		  and $NextLast->isa('PPI::Token')
-		  and $NextLast->isa('PPI::Token::Word')
-		  and $NextLast->content eq 'catch';
-
-		return 1    #
-		  if $Token->isa('PPI::Token::Word') and $Token->content eq 'catch';
+		my $after =
+		  ( $NextLast and $NextLast->isa('PPI::Token::Word') )
+		  ? $NextLast->content
+		  : '';
+		return '' if $after eq 'finally';
+
+		# Only a catch (after the try block) or a finally will do
+		return '' if not $Token->isa('PPI::Token::Word');
+		return 1 if $Token->content eq 'finally';
+		return 1 if $Token->content eq 'catch' and $after ne 'catch';
 
 		return '';
 	}
