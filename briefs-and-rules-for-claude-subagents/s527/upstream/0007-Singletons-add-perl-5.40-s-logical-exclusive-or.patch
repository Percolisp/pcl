From 21394cc363589cef1af1f86fbf5b59d0fe38f39f Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 24 Oct 2026 20:37:51 +0300
Subject: [PATCH 07/93] Singletons: add ^^, perl 5.40's logical exclusive or
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The plan of t/ppi_token_operator.t grows by 8: two of its loops
enumerate %OPERATOR.  Fixes PCL §16 in t/ppi_bugs_pcl.t.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Singletons.pm  |  2 +-
 t/ppi_bugs_pcl.t       |  3 +--
 t/ppi_token_operator.t | 11 ++++-------
 3 files changed, 6 insertions(+), 10 deletions(-)

diff --git a/lib/PPI/Singletons.pm b/lib/PPI/Singletons.pm
index 1190214e..a2d74bcd 100644
--- a/lib/PPI/Singletons.pm
+++ b/lib/PPI/Singletons.pm
@@ -20,7 +20,7 @@ our %OPERATOR = map { $_ => 1 } (
 	=~ !~ * / % x . << >>
 	< > <= >= lt gt le ge
 	== != <=> eq ne cmp ~~
-	& | ^ && || // .. ...
+	& | ^ ^^ && || // .. ...
 	&. |. ^. ~.
 	? :
 	= **= += -= .= *= /= %= x= &= |= ^= <<= >>= &&= ||= //=
diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 964ea616..812c72e1 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -419,8 +419,7 @@ TODO: {
 #
 # 5.40 added `^^`.  PPI emits Operator('^') twice, which is a different
 # expression (bitwise XOR applied twice) and cannot be told apart from one.
-TODO: {
-    local $TODO = 'PCL §16: perl 5.40\'s ^^ (logical XOR) is tokenized as two ^ operators';
+{
     my @t = toks('my $r = $a ^^ $b;');
     ok( grep(/^PPI::Token::Operator=\^\^$/, @t),
         '^^ should be one logical-XOR operator token' )
diff --git a/t/ppi_token_operator.t b/t/ppi_token_operator.t
index bb2b4f98..0f94b9d9 100644
--- a/t/ppi_token_operator.t
+++ b/t/ppi_token_operator.t
@@ -4,7 +4,7 @@
 
 use lib 't/lib';
 use PPI::Test::pragmas;
-use Test::More tests => 3150 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 3158 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 use PPI::Singletons qw( %KEYWORDS %OPERATOR );
@@ -721,10 +721,7 @@ OPERATORS_PLUS_MINUS: {
 
 LOGICAL_XOR: {
     # perl 5.40: $a ^^ $b is the logical exclusive or (there is no ^^=)
-    TODO: {
-        local $TODO = "^^ is lexed as two ^ operators";
-        my $doc = safe_new \'my $r = $a ^^ $b;';
-        my $ops = $doc->find('Token::Operator') || [];
-        is( join( ',', map { $_->content } @$ops ), '=,^^', '^^ is one operator' );
-    }
+    my $doc = safe_new \'my $r = $a ^^ $b;';
+    my $ops = $doc->find('Token::Operator') || [];
+    is( join( ',', map { $_->content } @$ops ), '=,^^', '^^ is one operator' );
 }
-- 
