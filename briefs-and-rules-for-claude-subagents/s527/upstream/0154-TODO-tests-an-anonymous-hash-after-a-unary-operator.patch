From fabedb6184ac7fb64bdaee9b791bcd7b87f6e019 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 28 Nov 2026 03:26:57 +0200
Subject: [PATCH 154/157] TODO tests: an anonymous hash after a unary operator

After an operator, a \ or a named unary operator such as defined or ref,
perl expects a term, and a { there is always an anonymous hash (toke.c
yyl_leftcurly: under XTERM the { is HASHBRACK, whatever follows it):

    perl -e 'my @l = (3, 4); print "no\n" if not { map { $_ => 1 } @l }->{5}'   # no

PPI's _curly makes the { a block after every operator but the ones its
table names (= ||= &&= //= || && // ? : , => +), and after defined and
ref, so not { map { ... } @l }->{5} is a block holding the map, with a
subscript after it.

Ten rows inside a new PCL section 78 TODO block -- not, !, -, ~, \,
defined, ref, and, a concatenation, and the map body after not -- and
thirteen controls that were right: the blocks of do, sub, eval, map,
grep and sort after an operator or in a list, a condition's block, a
bare block, a dereference block after an operator and a glob's, and the
hashes after +, = and return.  Plan 664 -> 687.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 40 +++++++++++++++++++++++++++++++++++++++-
 1 file changed, 39 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index e1ee6216..8d4e88be 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 664 +($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 687 +($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -2606,3 +2606,41 @@ for my $case ( [ q{my $r = [<4 5>];}, q{QuoteLike::Readline=<4 5>} ],
     my @t = map { short_class($_) } toks($code);
     ok( grep( $_ eq $want, @t ), squash($code) . ": $want (control)" ) or diag "got: @t";
 }
+
+# §78 -- after an operator, a \ or a named unary operator such as defined
+# and ref, perl expects a term, and a { there is always an anonymous hash
+# (toke.c yyl_leftcurly: under XTERM the { is HASHBRACK, whatever follows
+# it): `my @l = (3, 4); print "no" if not { map { $_ => 1 } @l }->{5}`
+# prints no.  PPI made the { a block after every operator but the few its
+# table names (= || && // ? : , => +), and after these words.
+TODO: {
+    local $TODO = q{PCL §78: an anonymous hash after a unary operator is lexed as a block};
+    for my $code ( 'print 1 if not { a => 1 }->{b};', 'my $y = !{ a => 1 }->{b};',
+                   'my $y = -{ a => 2 }->{a};', 'my $y = ~{ a => 2 }->{a};',
+                   'my $y = \{ a => 2 };', 'my $y = defined { a => 2 }->{a};',
+                   'my $y = ref { a => 2 };', 'my $y = 1 and { a => 1 }->{a};',
+                   'my $y = $x . { a => 1 }->{a};', 'my $y = not { map { $_ => 1 } @l }->{4};' ) {
+        my @c = bracket_classes( $code, '{' );
+        is( $c[0], 'PPI::Structure::Constructor', "$code: the { is an anonymous hash" );
+    }
+}
+# The controls: after do, sub, eval, map, grep and sort, after the ) of a
+# condition, at a statement's start and after a dereferencing sigil the {
+# opens a block; after + = and return it was already a hash.
+for my $case ( [ 'my $x = not do { 1 };', 'PPI::Structure::Block' ],
+               [ 'my $y = !sub { 0 }->();', 'PPI::Structure::Block' ],
+               [ 'my $y = !eval { 0 };', 'PPI::Structure::Block' ],
+               [ 'my @m = map { $_ * 2 } @l;', 'PPI::Structure::Block' ],
+               [ 'my @g = grep { $_ } @l;', 'PPI::Structure::Block' ],
+               [ 'my @s = sort { $b <=> $a } @l;', 'PPI::Structure::Block' ],
+               [ 'if ($x) { 1 }', 'PPI::Structure::Block' ],
+               [ '1; { print 1 }', 'PPI::Structure::Block' ],
+               [ 'my $n = 1 + @{$r};', 'PPI::Structure::Block' ],
+               [ '*{"x"} = sub { 1 };', 'PPI::Structure::Block' ],
+               [ 'my $y = +{ a => 2 }->{a};', 'PPI::Structure::Constructor' ],
+               [ 'my $y = { a => 2 };', 'PPI::Structure::Constructor' ],
+               [ 'return { a => 2 };', 'PPI::Structure::Constructor' ] ) {
+    my ( $code, $want ) = @$case;
+    my @c = bracket_classes( $code, '{' );
+    is( $c[0], $want, "$code: the first { is a " . short_class($want) . ' (control)' );
+}
