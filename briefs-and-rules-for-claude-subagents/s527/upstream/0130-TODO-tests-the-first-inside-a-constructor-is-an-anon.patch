From c1189f77a8b244164fb5edf9241481b5b8a0e88b Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sun, 15 Nov 2026 22:10:52 +0200
Subject: [PATCH 130/133] TODO tests: the first { inside a constructor is an
 anonymous hash
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl expects a term after the [ of an anonymous array (and after the {
of an anonymous hash), and where it expects a term a { is always an
anonymous hash (toke.c yyl_leftcurly: XTERM makes HASHBRACK); the
look-ahead that tells a block from a hash runs only where a statement
or a block may start:

    perl -e 'my $r = [ { \1, "abc" }, { $x, 1 } ]; print ref $r->[0], ref $r->[1], "\n"'
    # HASHHASH

PPI's _curly sends the first { of a statement inside a constructor to
the statement-start look-ahead, which knows a hash only by a literal
and a comma after the {, so [ { \1, "abc" } ] holds a Block and its
statement becomes a Compound.

Seven rows inside a new PCL §67 TODO block and eight controls (a
literal and a comma, an empty {}, the blocks of do, sub, eval, map and
grep inside a constructor, a statement-start block).  Plan 437 -> 452.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 29 ++++++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 19601846..4dbd84c9 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 437 +($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 452 +($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -2191,3 +2191,30 @@ for my $code ( 'print $s x 3;', 'print STDOUT x 3;', 'print C x3;', 'print "a" x
     my @t = map { short_class($_) } toks($code);
     ok( grep( /^Operator=x$/, @t ), "$code: the x operator (control)" ) or diag "got: @t";
 }
+
+# §67 -- the first { inside an anonymous array or hash constructor is an
+# anonymous hash, whatever follows it: perl expects a term after [ (and
+# after the { of an anonymous hash), and where it expects a term a { is
+# always an anonymous hash (toke.c yyl_leftcurly: XTERM makes HASHBRACK;
+# the look-ahead that tells a block from a hash runs only where a
+# statement or a block may start):
+# `my $r = [ { \1, "abc" } ]; print ref $r->[0];` prints HASH.
+TODO: {
+    local $TODO = 'PCL §67: the first { inside a constructor is lexed as a block unless a literal and a comma follow';
+    for my $case ( [ 'my @t = ( [ { \1 , "abc" } => "x" ] );', 0 ], [ 'my $r = [ { $x, 1 } ];', 0 ],
+                   [ 'my $r = [ { foo(), 1 } ];', 0 ], [ 'my $r = [ { %h } ];', 0 ],
+                   [ 'my $r = [ { %$h, a => 1 } ];', 0 ], [ 'my $r = [ { lc($x), 1 } ];', 0 ],
+                   [ 'my $r = { { %$h } => 1 };', 1 ] ) {
+        my ( $code, $i ) = @$case;
+        my @c = bracket_classes( $code, '{' );
+        is( $c[$i], 'PPI::Structure::Constructor', "$code: the { inside the constructor is an anonymous hash" );
+    }
+}
+for my $case ( [ 'my $r = [ { "abc", 1 } ];', 'PPI::Structure::Constructor' ], [ 'my $r = [ {} ];', 'PPI::Structure::Constructor' ],
+               [ 'my $r = [ do { "abc", 1 } ];', 'PPI::Structure::Block' ], [ 'my $r = [ sub { 1 } ];', 'PPI::Structure::Block' ],
+               [ 'my $r = [ eval { 1 } ];', 'PPI::Structure::Block' ], [ 'my $r = [ map { $_ } @l ];', 'PPI::Structure::Block' ],
+               [ 'my $r = [ grep { $_, 1 } @l ];', 'PPI::Structure::Block' ], [ '{ $x, 1 };', 'PPI::Structure::Block' ] ) {
+    my ( $code, $want ) = @$case;
+    my @c = bracket_classes( $code, '{' );
+    is( $c[0], $want, "$code: $want (control)" );
+}
