From a45973532af5c58c4f8fe2a198cae09cb1d58d33 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 24 Oct 2026 20:45:26 +0300
Subject: [PATCH 16/93] TODO tests: sub _ is a Statement::Sub named _

perl -e 'sub _ { "x" } print _()' prints x: the _ after sub names the
sub.  PPI lexes it as the magic filehandle, builds no Statement::Sub,
and joins the following statement to the block.  A control keeps the
filetest operand _ magic.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_statement_sub.t | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/t/ppi_statement_sub.t b/t/ppi_statement_sub.t
index 7b193b39..8eacdb95 100644
--- a/t/ppi_statement_sub.t
+++ b/t/ppi_statement_sub.t
@@ -4,7 +4,7 @@
 
 use lib 't/lib';
 use PPI::Test::pragmas;
-use Test::More tests => 1297 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 1312 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 use PPI::Singletons qw( %KEYWORDS );
@@ -285,3 +285,20 @@ sub test_subs {
 
 	return;
 }
+
+SUB_NAMED_UNDERSCORE: {
+	# `_` after `sub` is the sub's name: perl -e 'sub _ { "x" } print _()'
+	# prints x.  Anywhere else a lone `_` is the stat filehandle.
+	TODO: {
+		local $TODO = 'the _ naming a sub is lexed as the magic filehandle';
+		for my $code ( 'sub _ { "x" } print 1;', 'sub _; print 1;', 'sub _ { "x" }' ) {
+			my $doc = safe_new \$code;
+			my ($sub) = $doc->schildren;
+			ok( $sub && $sub->isa('PPI::Statement::Sub'), "$code: a Statement::Sub" );
+			is( ( $sub && $sub->isa('PPI::Statement::Sub') ? $sub->name : '' ), '_', "$code: named _" );
+		}
+	}
+	my $doc = safe_new \'print -f _;';
+	my ($u) = grep { $_->content eq '_' } $doc->tokens;
+	isa_ok( $u, 'PPI::Token::Magic', 'the filetest operand _' );
+}
