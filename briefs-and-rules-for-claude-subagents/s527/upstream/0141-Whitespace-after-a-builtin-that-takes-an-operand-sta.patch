From d27d0c3721be641b990ea04f576ac3af24c3ffbe Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 21 Nov 2026 20:16:22 +0200
Subject: [PATCH 141/157] Whitespace: / after a builtin that takes an operand
 starts a match
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl reads a / as a match wherever it expects a term (toke.c yyl_slash:
scan_pat unless PL_expect is XOPERATOR), and after a builtin that takes
an operand it expects one.  The / arm of PPI::Token::Whitespace now
asks _term_expected -- the rule the <, x and ~~ decisions already use --
after a Word, in place of its own short word list (return split if
unless grep map, all of which _term_expected covers): print /x/,
sin /;/, length /b/, join /,/, @a, print // ? 1 : 0, and the when,
while, until and for modifiers read the whole pattern, and the ; or #
inside it is pattern text.  After a method name (P->new->split / 3), a
builtin that takes no operand (time / 2) or a user's word the / still
divides.

Two neighbours of the same question:

  * a // after a builtin whose operand may be left out -- getc pop pos
    readline readlink readpipe shift undef umask, toke.c's UNIDOR, where
    perl expects a term OR the defined-or (XTERMORDORDOR) -- stays the
    defined-or: my $x = shift // 7;
  * in the filehandle slot of print $fh LIST (whitespace before the /,
    none after it) a / starts the list's first term, as for perl
    (toke.c, case '$': "e.g. print $fh /.../"); print $fh / 2 divides.

_term_expected learns that a Word spelled like an operator or a
quote-like operator (x, lt, s, y) is a user's sub, not a builtin that
takes an operand (in term position toke.c sends KEY_x to just_a_word):
otherwise the closing / of a pattern mis-read after a user's word,
`ok /x/, 1`, would open a second match.  One more control row for it.

Fixes PCL §71 (its eighteen rows); the two `while` rows of section 11
pass with it, and its user-sub rows (ok /x/) stay TODO -- only a
declaration says that ok takes a list.  Plan 558 -> 559.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Token/Whitespace.pm | 43 ++++++++++++++++++++++---------------
 lib/PPI/Tokenizer.pm        |  6 +++++-
 t/ppi_bugs_pcl.t            | 17 +++++++--------
 3 files changed, 39 insertions(+), 27 deletions(-)

diff --git a/lib/PPI/Token/Whitespace.pm b/lib/PPI/Token/Whitespace.pm
index 1ef856d7..4fed0581 100644
--- a/lib/PPI/Token/Whitespace.pm
+++ b/lib/PPI/Token/Whitespace.pm
@@ -131,15 +131,12 @@ my %CLASSMAP = (
 	32       => 'Whitespace',             # A normal space
 );
 
-# Words (functions and keywords) after which a following / is
-# almost certainly going to be a regex
-my %MATCHWORD = map { $_ => 1 } qw{
-  return
-  split
-  if
-  unless
-  grep
-  map
+# The builtins after which perl reads // as the defined-or although it
+# expects a term (toke.c UNIDOR: PL_expect = XTERMORDORDOR), so that
+# my $x = shift // 7 works.  After every other builtin that takes an
+# operand a // is an empty match (split //, $s).
+my %UNIDOR = map { $_ => 1 } qw{
+  getc pop pos readline readlink readpipe shift undef umask
 };
 
 sub __TOKENIZER__on_line_start {
@@ -384,8 +381,14 @@ sub __TOKENIZER__on_char {
 		return 'Operator' if $prev->isa('PPI::Token::Operator') and $t->_after_term;
 		return 'Regexp::Match' if $prev->isa('PPI::Token::Operator');
 
-		# After a symbol
-		return 'Operator' if $prev->isa('PPI::Token::Symbol');
+		# After a symbol a term has ended -- except in the filehandle slot
+		# of print $fh LIST, where a / with no space, = or / after it
+		# starts the list (toke.c, case '$': print $fh /.../)
+		if ( $prev->isa('PPI::Token::Symbol') ) {
+			return 'Operator' if !$t->_after_scalar_filehandle;
+			return substr( $t->{line}, $t->{line_cursor} + 1, 1 ) =~ m{\A[^\s=/]\z}
+				? 'Regexp::Match' : 'Operator';
+		}
 		if ( $prec eq ']' and $prev->isa('PPI::Token::Structure') ) {
 			return 'Operator';
 		}
@@ -414,12 +417,18 @@ sub __TOKENIZER__on_char {
 		# (BEGIN { } /x/, grep { } /x/), a term starts
 		return 'Regexp::Match' if $t->_after_statement_block;
 
-		# Functions and keywords
-		if (
-			$MATCHWORD{$prec}
-			and
-			$prev->isa('PPI::Token::Word')
-		) {
+		# After a builtin that takes an operand perl expects a term, and a
+		# / starts a match (toke.c yyl_slash: scan_pat where PL_expect is
+		# not XOPERATOR) -- print /x/, 1 while /x/g, sin /;/, split /,/.
+		# Except a // after a builtin whose operand may be left out:
+		# perl expects a term or the defined-or there (XTERMORDORDOR,
+		# toke.c UNIDOR), so my $x = shift // 7 is the defined-or.  After
+		# a method name, a builtin that takes no operand (time / 2) or a
+		# user's word _term_expected says no, and the / divides.
+		if ( $prev->isa('PPI::Token::Word') and $t->_term_expected ) {
+			( my $word = $prec ) =~ s/^CORE:://;
+			return 'Operator' if $UNIDOR{$word}
+				and substr( $t->{line}, $t->{line_cursor} + 1, 1 ) eq '/';
 			return 'Regexp::Match';
 		}
 
diff --git a/lib/PPI/Tokenizer.pm b/lib/PPI/Tokenizer.pm
index 5fed9fe5..f6be465b 100644
--- a/lib/PPI/Tokenizer.pm
+++ b/lib/PPI/Tokenizer.pm
@@ -87,7 +87,7 @@ use PPI::Token      ();
 use PPI::Exception  ();
 use PPI::Exception::ParserRejection ();
 use PPI::Document ();
-use PPI::Singletons qw' %KEYWORDS %NO_OPERAND ';
+use PPI::Singletons qw' %KEYWORDS %NO_OPERAND %OPERATOR %QUOTELIKE ';
 
 our $VERSION = '1.292';
 
@@ -1186,6 +1186,10 @@ sub _term_expected {
 	return '' if $prevprev and $prevprev->isa('PPI::Token::Operator') and $prevprev->content eq '->';
 	my $word = $prev->content;
 	$word =~ s/^CORE:://;
+	# A word spelled like an operator or a quote-like operator -- x, lt,
+	# s, y -- is a user's sub where PPI makes it a Word (toke.c: in
+	# term position KEY_x goes to just_a_word)
+	return '' if $OPERATOR{$word} or $QUOTELIKE{$word};
 	return $KEYWORDS{$word} && !$NO_OPERAND{$word};
 }
 
diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 09a4c6ee..d9724162 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 558 +($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 559 +($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -201,8 +201,8 @@ TODO: {
 # because a `(…)` group inside the pattern puts PPI back in term position — so
 # the CLOSING delimiter starts a match of its own and swallows the rest of the
 # FILE into one token.
-TODO: {
-    local $TODO = 'PCL §11: /PATTERN/ after a paren-less WORD is tokenized as division';
+# (The modifiers are builtins that take an operand: fixed with PCL §71.)
+{
     my $src = '1 while /(a+b?)x/g;' . "\n" . 'print "next\n";';
     my $doc = PPI::Document->new(\$src);
     my @st  = $doc ? $doc->schildren : ();
@@ -210,8 +210,7 @@ TODO: {
         '`1 while /(a+b?)x/g;` must not swallow the following statement' )
         or diag "statements: " . join(' | ', map { my $c = $_->content; $c =~ s/\n/\\n/g; $c } @st);
 }
-TODO: {
-    local $TODO = 'PCL §11: /PATTERN/ after a paren-less WORD is tokenized as division';
+{
     my @t = toks('1 while /b(?{$n++})c/g;');
     ok( grep(/^PPI::Token::Regexp::Match=/, @t),
         '/…/ after the `while` statement modifier should be a match' )
@@ -2362,8 +2361,7 @@ for my $case ( [ q{{} print 1;}, 'PPI::Structure::Constructor' ], [ qq{{ # c\n}
 # filehandle slot of print $fh /x/ (whitespace before the /, none after)
 # the / starts the list too.  After a method name the / divides, also
 # when the method is called split or map.
-TODO: {
-    local $TODO = q{PCL §71: / after a builtin that takes an operand is lexed as division};
+{
     for my $case ( [ q{print /x/, 1;}, q{/x/} ], [ q{print/x/;}, q{/x/} ],
                    [ q{print "m" when /x/;}, q{/x/} ], [ q{$n++ while /x/g;}, q{/x/g} ],
                    [ q{$n++ until /x/;}, q{/x/} ], [ q{push @r, $_ for /(\w)/g;}, q{/(\w)/g} ],
@@ -2389,7 +2387,8 @@ TODO: {
 # name, a variable, a subscript or print $fh with a space after the / is a
 # division; a // after a builtin whose operand may be left out (shift, pop,
 # undef, pos: toke.c UNIDOR, XTERMORDORDOR) is the defined-or; split, grep,
-# map, return and the if / unless modifiers were right.
+# map, return and the if / unless modifiers were right; after a word spelled
+# like an operator -- x, a user's sub, here a constant -- the / divides.
 for my $case ( [ q{my $t = time / 2;}, q{Operator=/} ], [ q{my $n = wantarray / 2;}, q{Operator=/} ],
                [ q{my $n = $o->print / 2;}, q{Operator=/} ], [ q{my $n = $h{a} / 2;}, q{Operator=/} ],
                [ q{print $fh / 2;}, q{Operator=/} ], [ q{$x /= 2;}, q{Operator=/=} ],
@@ -2399,7 +2398,7 @@ for my $case ( [ q{my $t = time / 2;}, q{Operator=/} ], [ q{my $n = wantarray /
                [ q{my @c = split //, $s;}, q{Regexp::Match=//} ], [ q{my @c = split /,/, $s;}, q{Regexp::Match=/,/} ],
                [ q{my @g = grep /x/, @a;}, q{Regexp::Match=/x/} ], [ q{my @m = map /(x)/, @a;}, q{Regexp::Match=/(x)/} ],
                [ q{return /x/;}, q{Regexp::Match=/x/} ], [ q{print 1 if /x/;}, q{Regexp::Match=/x/} ],
-               [ q{print 1 unless /x/;}, q{Regexp::Match=/x/} ] ) {
+               [ q{print 1 unless /x/;}, q{Regexp::Match=/x/} ], [ q{my $n = 2 * x / 2;}, q{Operator=/} ] ) {
     my ( $code, $want ) = @$case;
     my @t = map { short_class($_) } toks($code);
     ok( grep( $_ eq $want, @t ), "$code: $want (control)" ) or diag "got: @t";
