From eb16e9d26c94674f04a426296c8ac224921f4f10 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Thu, 29 Oct 2026 00:51:39 +0200
Subject: [PATCH 49/70] Unknown: $$ before a $, a word or a { is a dereference
 cast
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl reads $$$a as ${${$a}} and $${$ref} as ${${$ref}}; PPI lexed the
magic $$ (the process id) followed by $a, and then structured the braces
of $${$ref} as a hash subscript of $$.  When the $ arm sees $$ followed by
a $, a word character or a {, the first $ is now a Cast and the rest is
tokenized again: $$$a is Cast Cast Symbol, $$$$b three Casts and a
Symbol, $${$ref} Cast Cast Block.  $$ alone, $$ + 1 and "$$" stay the
process id, $${^MATCH} is Cast + Magic as before.

This is upstream PR #428 (Perl-Critic/PPI, by toddr-bot, fixing issue
#60), taken as it stands and widened by the { case; its regression pair
is renumbered 55 here.

Fixes PCL §1 in t/ppi_bugs_pcl.t.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Token/Unknown.pm                         |  8 ++++++++
 t/08_regression.t                                |  2 +-
 t/25_increment.t                                 |  2 +-
 t/data/08_regression/55_triple_dollar_deref.code |  1 +
 t/data/08_regression/55_triple_dollar_deref.dump | 11 +++++++++++
 t/ppi_bugs_pcl.t                                 |  6 ++----
 t/ppi_token_magic.t                              |  1 -
 7 files changed, 24 insertions(+), 7 deletions(-)
 create mode 100644 t/data/08_regression/55_triple_dollar_deref.code
 create mode 100644 t/data/08_regression/55_triple_dollar_deref.dump

diff --git a/lib/PPI/Token/Unknown.pm b/lib/PPI/Token/Unknown.pm
index 07a17fcd..481807f2 100644
--- a/lib/PPI/Token/Unknown.pm
+++ b/lib/PPI/Token/Unknown.pm
@@ -138,6 +138,14 @@ sub __TOKENIZER__on_char {
 		}
 
 		if ( $MAGIC{ $c . $char } ) {
+			if ( $char eq '$' ) {
+				my $after = substr( $t->{line}, $t->{line_cursor} + 1, 1 );
+				if ( $after ne '' and $after =~ /[\w\${]/ ) {
+					# $$$var, $$$$var or $${EXPR}: the first $ is a dereference cast
+					$t->{class} = $t->{token}->set_class( 'Cast' );
+					return $t->_finalize_token->__TOKENIZER__on_char( $t );
+				}
+			}
 			# Magic variable
 			$t->{class} = $t->{token}->set_class( 'Magic' );
 			return 1;
