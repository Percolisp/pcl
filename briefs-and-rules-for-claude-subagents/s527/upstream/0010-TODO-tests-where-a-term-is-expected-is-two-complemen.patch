From af5345e978a86dde3bd8e38802ea2cd7c512cff6 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 24 Oct 2026 20:40:32 +0300
Subject: [PATCH 10/57] TODO tests: ~~ where a term is expected is two
 complements

perl -e '$y = "3"; print ~~$y' prints 3: in term position ~~ is two
bitwise complements (the "numify" idiom perl's own t/op/bop.t uses),
but PPI always lexes it as the smart match.  Three controls keep the
smart match after a term: a scalar, a match, and a method call.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_token_operator.t | 30 +++++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/t/ppi_token_operator.t b/t/ppi_token_operator.t
index 0f94b9d9..1cc56046 100644
--- a/t/ppi_token_operator.t
+++ b/t/ppi_token_operator.t
@@ -4,7 +4,7 @@
 
 use lib 't/lib';
 use PPI::Test::pragmas;
-use Test::More tests => 3158 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 3173 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 use PPI::Singletons qw( %KEYWORDS %OPERATOR );
@@ -725,3 +725,31 @@ LOGICAL_XOR: {
     my $ops = $doc->find('Token::Operator') || [];
     is( join( ',', map { $_->content } @$ops ), '=,^^', '^^ is one operator' );
 }
+
+TERM_INITIAL_COMPLEMENTS: {
+    # Where a term is expected, ~~ is two bitwise complements -- the
+    # "numify" idiom: perl -e '$y = "3"; print ~~$y' prints 3.  Where an
+    # operator is expected it is the smart match.
+    my @operators = (
+        'my $r = $x ~~ @a;'          => '=,~~',
+        'my $r = (/X/ ~~ @a);'       => '=,~~',
+        'my $r = $o->name ~~ @a;'    => '=,->,~~',
+    );
+    TODO: {
+        local $TODO = '~~ where a term is expected is lexed as a smart match';
+        my @complements = (
+            'is(~~$y, 3);'           => '~,~,,',
+            'my $v = $a[~~2];'       => '=,~,~',
+        );
+        for ( my $i = 0; $i < @complements; $i += 2 ) {
+            my $doc = safe_new \$complements[$i];
+            my $ops = $doc->find('Token::Operator') || [];
+            is( join( ',', map { $_->content } @$ops ), $complements[$i + 1], "operators of $complements[$i]" );
+        }
+    }
+    for ( my $i = 0; $i < @operators; $i += 2 ) {
+        my $doc = safe_new \$operators[$i];
+        my $ops = $doc->find('Token::Operator') || [];
+        is( join( ',', map { $_->content } @$ops ), $operators[$i + 1], "operators of $operators[$i]" );
+    }
+}
