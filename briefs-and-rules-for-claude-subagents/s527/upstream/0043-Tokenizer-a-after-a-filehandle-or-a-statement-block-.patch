From 5b822dea1c34d4e279c72536c1e1cf4790f25e29 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Thu, 29 Oct 2026 00:41:07 +0200
Subject: [PATCH 43/89] Tokenizer: a - after a filehandle or a statement block
 starts a term
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl reads a - as the start of a term (toke.c: PL_expect = XTERM) where
PPI's operator context said subtraction:

  * in the filehandle slot of print $fh LIST, when whitespace stands
    before the - and neither whitespace nor = nor > after it -- the rule
    toke.c applies there: print $fh -e $f is a filetest and
    print $fh -1 prints -1, both to $fh, while print $fh - 1 and
    print $fh -= 1 stay operators;
  * after the } of a block that opens a statement (a bare block, a
    labelled one) or follows a word (BEGIN, END, sort, map, grep, a sub's
    name): BEGIN { 1 } -e $f, sort { $a <=> $b } -1, 2.  A block after sub
    is an anonymous sub and one after return or an operator an anonymous
    hash, both terms, so a - after them still subtracts.

The scan for a } 's matching { moves out of _curly_kind into
_matching_curly, which the new _after_statement_block uses too;
_curly_kind's answers are unchanged.  _after_scalar_filehandle also sees
the whitespace while the Whitespace token before the - is still being
built, which is where the - is decided.

Fixes PCL §22 §35 in t/ppi_bugs_pcl.t.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Token/Whitespace.pm |  2 +-
 lib/PPI/Tokenizer.pm        | 70 +++++++++++++++++++++++++++++++------
 t/ppi_bugs_pcl.t            | 12 +++----
 3 files changed, 65 insertions(+), 19 deletions(-)

diff --git a/lib/PPI/Token/Whitespace.pm b/lib/PPI/Token/Whitespace.pm
index 614ddf8a..107afbfd 100644
--- a/lib/PPI/Token/Whitespace.pm
+++ b/lib/PPI/Token/Whitespace.pm
@@ -410,7 +410,7 @@ sub __TOKENIZER__on_char {
 	} elsif ( $char == 45 ) { # $char eq '-'
 		# Look for an obvious operator operand context
 		my $context = $t->_opcontext;
-		if ( $context eq 'operator' ) {
+		if ( $context eq 'operator' and !$t->_minus_starts_term ) {
 			return 'Operator';
 		} else {
 			# More logic needed
diff --git a/lib/PPI/Tokenizer.pm b/lib/PPI/Tokenizer.pm
index bd43ddd5..355b59be 100644
--- a/lib/PPI/Tokenizer.pm
+++ b/lib/PPI/Tokenizer.pm
@@ -813,7 +813,10 @@ sub _after_scalar_filehandle {
 	my $self = shift;
 	my ( $prev, $op ) = $self->_previous_significant_tokens(2);
 	return '' if !$prev or !$prev->isa('PPI::Token::Symbol') or $prev->content !~ /^\$/;
-	my $last = $self->_last_token;
+	# The whitespace is the last token, or, when a Whitespace token is still
+	# being built (the tokenizer deciding what starts after it), that one.
+	my $last = ( $self->{token} and $self->{token}->isa('PPI::Token::Whitespace') )
+		? $self->{token} : $self->_last_token;
 	return '' if !$last or !$last->isa('PPI::Token::Whitespace');
 	return $op && $op->isa('PPI::Token::Word') && $FILEHANDLE_LISTOP{ $op->content };
 }
@@ -875,15 +878,7 @@ sub _significant_before {
 #   undef        no matching { (an unbalanced })
 sub _curly_kind {
 	my ( $self, $cursor ) = @_;
-	my $tokens = $self->{tokens};
-	my $depth  = 1;
-	while ( --$cursor >= 0 ) {
-		my $token = $tokens->[$cursor];
-		next if !$token->isa('PPI::Token::Structure');
-		$depth++ if $token->content eq '}';
-		$depth-- if $token->content eq '{';
-		last if !$depth;
-	}
+	$cursor = $self->_matching_curly($cursor);
 	return if $cursor < 0;
 	my ( $prev, $at ) = $self->_significant_before($cursor);
 	return 'block' if !$prev;
@@ -902,6 +897,61 @@ sub _curly_kind {
 	return 'block';
 }
 
+# The index of the { that the } at index $cursor closes, or -1.
+sub _matching_curly {
+	my ( $self, $cursor ) = @_;
+	my $tokens = $self->{tokens};
+	my $depth  = 1;
+	while ( --$cursor >= 0 ) {
+		my $token = $tokens->[$cursor];
+		next if !$token->isa('PPI::Token::Structure');
+		$depth++ if $token->content eq '}';
+		$depth-- if $token->content eq '{';
+		last if !$depth;
+	}
+	return $cursor;
+}
+
+# A - starts a term although the token before it would end one (perl reads
+# it in term position, toke.c's XTERM) in two places:
+#   * the filehandle slot of print $fh LIST (_after_scalar_filehandle), when
+#     neither whitespace nor = nor > follows the -: print $fh -1 and
+#     print $fh -e $f print to $fh; print $fh - 1 subtracts;
+#   * after the } of a block that ends a statement or takes a list
+#     (_after_statement_block): BEGIN { 1 } -e $f, sort { ... } -1, 2.
+sub _minus_starts_term {
+	my $self = shift;
+	if ( $self->_after_scalar_filehandle ) {
+		my $next = substr $self->{line}, $self->{line_cursor} + 1, 1;
+		return $next ne '' && $next !~ /[\s=>]/;
+	}
+	return $self->_after_statement_block;
+}
+
+# True when the previous significant token is the } of a block after which
+# perl expects a term: a block that opens a statement (its { follows
+# nothing, a ; or a }, or a label) or a block that follows a word, as after
+# BEGIN, END, sort, map, grep or print.  After sub the block is an
+# anonymous sub and after return an anonymous hash, both terms; a { after
+# an operator or a ( opens an anonymous hash too (_curly_kind says 'block'
+# for all of these, so they are told apart here).
+sub _after_statement_block {
+	my $self   = shift;
+	my $tokens = $self->{tokens};
+	my $cursor = $#$tokens;
+	$cursor-- while $cursor >= 0 and !$tokens->[$cursor]->significant;
+	return '' if $cursor < 0;
+	my $close = $tokens->[$cursor];
+	return '' if !$close->isa('PPI::Token::Structure') or $close->content ne '}';
+	my $kind = $self->_curly_kind($cursor);
+	return '' if !$kind or $kind ne 'block';
+	my ( $prev ) = $self->_significant_before( $self->_matching_curly($cursor) );
+	return 1 if !$prev or $prev->isa('PPI::Token::Label');
+	my $content = $prev->content;
+	return 1 if $prev->isa('PPI::Token::Structure') and ( $content eq ';' or $content eq '}' );
+	return $prev->isa('PPI::Token::Word') && $content ne 'sub' && $content ne 'return';
+}
+
 # True when the token before the current one ends a term (_ends_term_at),
 # except in the scalar-filehandle slot of print $fh LIST, where the next
 # token starts the list (_after_scalar_filehandle).
diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 6b30b870..52fb0be9 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -572,8 +572,7 @@ TODO: {
 # is no competing reading to protect: `-e` cannot be a binary operator at all,
 # and `$n -e $b` is a perl syntax error.  Adjacency is the discriminator —
 # `print $fh - e $f` really IS `-(e($f))`, and perl honours the space.
-TODO: {
-    local $TODO = 'PCL §22: A filetest after a SCALAR filehandle is split into - + WORD';
+{
     my $doc = PPI::Document->new(\'print $fh -e $f;');
     my @ops = grep { $_->isa('PPI::Token::Operator') } $doc->tokens;
     ok( (grep { $_->content eq '-e' } @ops),
@@ -582,8 +581,7 @@ TODO: {
                                     grep { $_->significant } $doc->tokens);
 }
 # The block-handle form splits the same way…
-TODO: {
-    local $TODO = 'PCL §22: A filetest after a SCALAR filehandle is split into - + WORD';
+{
     my $doc = PPI::Document->new(\'print {$x} -e $f;');
     my @ops = grep { $_->isa('PPI::Token::Operator') } $doc->tokens;
     ok( (grep { $_->content eq '-e' } @ops),
@@ -1063,8 +1061,7 @@ for my $src ('1.5-0.5;', '1e3-1;') {
 # §35 -- a filetest right after a `BEGIN { … }` block is split into Operator(-)
 # + Word, although the block's `}` ends the statement and `-e` starts a new
 # one.  perl: `BEGIN { 1 } -e _; print "x\n"` prints x.
-TODO: {
-    local $TODO = 'PCL §35: A filetest right after a BEGIN { … } block on the same line is split into - + WORD';
+{
     my $doc = PPI::Document->new(\'BEGIN { 1 } -e _; print "x\n";');
     my @ops = grep { $_->isa('PPI::Token::Operator') } $doc->tokens;
     ok( (grep { $_->content eq '-e' } @ops),
@@ -1275,8 +1272,7 @@ TODO: {
 # stands before the - and none after it (perl -e 'print $fh -1' prints -1 to
 # $fh), and after the } of a block that ends a statement or takes a list
 # (BEGIN { 1 } -e $f, { 1 } -e $f, sort { $a <=> $b } -1, 2).
-TODO: {
-    local $TODO = 'PCL §22/§35: a - that starts a term is lexed as a subtraction';
+{
     my @rows = (
         [ 'print $fh -1;',                'Number=-1',   'print $fh -1 prints the number -1 to $fh' ],
         [ '{ 1 } -e $f;',                 'Operator=-e', 'a filetest after a bare block' ],
