From 61817c99fe2360f11576fbf7b619643468af641e Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Thu, 29 Oct 2026 01:00:15 +0200
Subject: [PATCH 53/99] Tokenizer: a nameless parameter only inside a signature
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Under the signatures feature the $ arm (and the @ and % arms) read a $
before ) , or = as a nameless parameter wherever the feature was on, so
$) $, and $= -- the effective group id, the output field separator, the
page length -- were split everywhere, and the stray ) closed structures
that were still open (a sub's block ended at my $x = $)).  The test is
now _in_signature: the feature is on AND the innermost open bracket
before the token is a ( after sub or sub NAME (attributes allowed
between).  The backward scan stops at the first unmatched opener or at a
; outside brackets.

Fixes PCL §32 in t/ppi_bugs_pcl.t.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Token/Unknown.pm |  6 +++---
 lib/PPI/Tokenizer.pm     | 41 ++++++++++++++++++++++++++++++++++++++++
 t/ppi_bugs_pcl.t         |  9 +++------
 3 files changed, 47 insertions(+), 9 deletions(-)

diff --git a/lib/PPI/Token/Unknown.pm b/lib/PPI/Token/Unknown.pm
index cee102a8..8c2fe7ea 100644
--- a/lib/PPI/Token/Unknown.pm
+++ b/lib/PPI/Token/Unknown.pm
@@ -132,7 +132,7 @@ sub __TOKENIZER__on_char {
 
 		# Is it a nameless arg in a signature?
 		my %noname = ( ')' => 1, '=' => 1, ',' => 1 );
-		if ( $noname{$char} and $t->_current_token_has_signatures_active ) {
+		if ( $noname{$char} and $t->_in_signature ) {
 			$t->{class} = $t->{token}->set_class('Symbol');
 			return $t->_finalize_token->__TOKENIZER__on_char($t);
 		}
@@ -184,7 +184,7 @@ sub __TOKENIZER__on_char {
 		}
 
 		# Is it a nameless arg in a signature?
-		if ( $char eq ')' and $t->_current_token_has_signatures_active ) {
+		if ( $char eq ')' and $t->_in_signature ) {
 			$t->{class} = $t->{token}->set_class('Symbol');
 			return $t->_finalize_token->__TOKENIZER__on_char($t);
 		}
@@ -235,7 +235,7 @@ sub __TOKENIZER__on_char {
 		}
 
 		# Is it a nameless arg in a signature?
-		if ( $char eq ')' and $t->_current_token_has_signatures_active ) {
+		if ( $char eq ')' and $t->_in_signature ) {
 			$t->{class} = $t->{token}->set_class('Symbol');
 			return $t->_finalize_token->__TOKENIZER__on_char($t);
 		}
diff --git a/lib/PPI/Tokenizer.pm b/lib/PPI/Tokenizer.pm
index 4e98a664..5a25404a 100644
--- a/lib/PPI/Tokenizer.pm
+++ b/lib/PPI/Tokenizer.pm
@@ -965,6 +965,47 @@ sub _glob_name_expected {
 	return $self->_opcontext eq 'operand';
 }
 
+# True when the signatures feature is on AND the tokenizer stands inside a
+# signature: the innermost open bracket before the current token is a ( that
+# follows sub (an anonymous sub) or sub NAME, with any attributes between.
+# Only there is a $, @ or % before ) , or = a nameless parameter; anywhere
+# else $) $, $= are the magic variables.  The scan is bounded: it stops at
+# the first unmatched opener, or at a ; outside brackets.
+sub _in_signature {
+	my $self = shift;
+	return '' if !$self->_current_token_has_signatures_active;
+	my $tokens = $self->{tokens};
+	my $depth  = 0;
+	my $cursor = $#$tokens;
+	for ( ; $cursor >= 0; $cursor-- ) {
+		my $token = $tokens->[$cursor];
+		next if !$token->isa('PPI::Token::Structure');
+		my $c = $token->content;
+		if ( $c eq ')' or $c eq ']' or $c eq '}' ) {
+			$depth++;
+			next;
+		}
+		return '' if $c eq ';' and !$depth;
+		next if $c eq ';';
+		if ( $depth ) {
+			$depth--;
+			next;
+		}
+		return '' if $c ne '(';
+		last;
+	}
+	return '' if $cursor < 0;
+	my ( $prev, $at ) = $self->_significant_before($cursor);
+	while ( $prev and ( $prev->isa('PPI::Token::Attribute')
+		or ( $prev->isa('PPI::Token::Operator') and $prev->content eq ':' ) ) ) {
+		( $prev, $at ) = $self->_significant_before($at);
+	}
+	return '' if !$prev or !$prev->isa('PPI::Token::Word');
+	return 1 if $prev->content eq 'sub';
+	( $prev ) = $self->_significant_before($at);
+	return $prev && $prev->isa('PPI::Token::Word') && $prev->content eq 'sub';
+}
+
 # True when the token before the current one ends a term (_ends_term_at),
 # except in the scalar-filehandle slot of print $fh LIST, where the next
 # token starts the list (_after_scalar_filehandle).
diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index ec647ce2..24d2c2cf 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -999,8 +999,7 @@ TODO: {
 # is split EVERYWHERE -- and the stray `)` reaches the lexer, which uses it to
 # close a structure.  `$(` is not affected, and without the pragma `$)` is a
 # single Magic token.
-TODO: {
-    local $TODO = 'PCL §32: $) is tokenized as Symbol:$ + Structure:) ANYWHERE once the signatures feature is on';
+{
     my $src = qq{use v5.36;\nmy \$e = \$);\n};
     my $doc = PPI::Document->new(\$src);
     my ($tok) = grep { $_->content eq '$)' } $doc->tokens;
@@ -1013,8 +1012,7 @@ TODO: {
     my $doc = PPI::Document->new(\$src);
     my @unmatched = grep { $_->isa('PPI::Statement::UnmatchedBrace') }
                     $doc->schildren;
-    TODO: {
-        local $TODO = 'PCL §32: $) is tokenized as Symbol:$ + Structure:) ANYWHERE once the signatures feature is on';
+    {
         is( scalar @unmatched, 0,
             '`$)` inside a nested block leaves no UnmatchedBrace statements' );
     }
@@ -1369,8 +1367,7 @@ TODO: {
 # signatures feature is on (perl: $, is the output field separator, $= the
 # page length).  A nameless parameter is a $ followed by ) , or = INSIDE a
 # signature, and only there.
-TODO: {
-    local $TODO = 'PCL §32: $) is tokenized as Symbol:$ + Structure:) ANYWHERE once the signatures feature is on';
+{
     for my $r ( [ "use v5.36;\nmy \$s = \$,;", 'Magic=$,' ],
                 [ "use v5.36;\nprint \$=;",     'Magic=$=' ] ) {
         my ( $code, $want ) = @$r;
