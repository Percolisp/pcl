From a9b7a1ac114396f9c226dd5a004c63cfe20dd423 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Tue, 3 Nov 2026 23:55:19 +0200
Subject: [PATCH 118/127] TODO tests: a sub declared after a format body keeps
 its prototype
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl's t/op/write.t declares `sub has_format ($)` right after three
formats; perl reads the prototype as anywhere else.  The prototype test
(Token/Whitespace.pm) and the attribute test (Token/Unknown.pm) take
`sub NAME` as a declaration only after nothing, a Structure token or an
empty Whitespace -- the new Format token is none of them, so the
prototype came out as a List holding the magic variable $) and an
attribute as an Operator and a Word.

Two rows inside a fourth PCL §40 TODO block.  Plan 370 -> 372.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index aa029c5b..85bb2b7a 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 370 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 372 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -1667,6 +1667,17 @@ for my $code ( 'my %h = (format => 1);', '$h{format} = 2;', '$o->format(1);', 's
     my @s = stmts("format P =\n{ literal\n.\nprint 1;\n");
     is( scalar(@s), 2, 'a { opening a PICTURE line is text (control)' ) or diag join ' | ', @s;
 }
+# ... and a named sub declared right after a format takes its prototype and
+# its attributes as anywhere else (perl's t/op/write.t: `sub has_format ($)`
+# after three formats).
+TODO: {
+    local $TODO = 'PCL §40: a sub declared after a format body loses its prototype';
+    for my $case ( [ 'sub hf ($) { 1 }', 'Prototype=($)' ], [ 'sub hf :lvalue { $v }', 'Attribute=lvalue' ] ) {
+        my ( $rest, $want ) = @$case;
+        my @t = map { short_class($_) } toks("format A =\nx\n.\n$rest\n");
+        ok( grep( $_ eq $want, @t ), "after a format: $rest -- $want" ) or diag "got: @t";
+    }
+}
 
 # §41 -- an empty package segment is part of the name (toke.c scan_word6):
 # `sub foo::::bar { 7 } print foo::::bar()` prints 7.
