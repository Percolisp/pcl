From c64742cab62240d209f57b3bf80212d9f9848fed Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 31 Oct 2026 10:01:48 +0200
Subject: [PATCH 96/99] TODO tests: defer BLOCK is a compound statement of its
 own
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Under the defer feature (perl 5.36) `defer BLOCK` is a statement that
ends at its block (perly.y: barestmt: KW_DEFER mblock):

    perl -E 'use feature "defer"; no warnings; { defer { print "b\n" } print "a\n" }'
    # a, then b

PPI already tracks the feature (Include); the Lexer still builds one
plain statement that swallows the next one.  A type row inside the
existing PCL §52 TODO block, and a control: without the feature defer
is an ordinary word.  Plan 297 -> 299.
---
 t/ppi_bugs_pcl.t | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 54569895..7dddea36 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 300 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 302 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -1842,6 +1842,13 @@ TODO: {
     my @in = $blk ? map { squash( $_->content ) } $blk->schild(0)->schildren : ();
     is_deeply( \@in, [ 'defer { print "b\n" }', 'print "a\n";' ],
                'defer BLOCK ends at its block' );
+    my ($def) = $blk ? $blk->schild(0)->schildren : ();
+    is( $def && $def->isa('PPI::Statement::Compound') && $def->type, 'defer',
+        'defer BLOCK is a compound statement of type defer' );
+}
+{
+    my @s = stmts(q{defer { print "b\n" } print "a\n";});
+    is( scalar(@s), 1, 'without the feature defer is an ordinary word (control)' ) or diag join "\n", @s;
 }
 
 # §53 -- the class feature (perl 5.38): `class NAME BLOCK`, `field`,
