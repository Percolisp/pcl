--- a/t/07_token.t
+++ b/t/07_token.t
@@ -217,23 +217,20 @@ HEX_FLOAT: {
 	# perl 5.22+ hexadecimal floating point: perl -e 'print 0x1.8p+1'
 	# prints 3.  The binary exponent (p) is required; without it, 0x1.8
 	# is 0x1 concatenated with 8.
