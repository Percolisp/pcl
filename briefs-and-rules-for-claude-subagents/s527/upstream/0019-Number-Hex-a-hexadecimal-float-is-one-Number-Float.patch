From d93bd718bdb10a2b7c8a9174228b8fe9960cd3b8 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 24 Oct 2026 20:48:04 +0300
Subject: [PATCH 19/23] Number::Hex: a hexadecimal float is one Number::Float
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

After the hex digits, a . or a p that starts a binary exponent
(0x1.8p+1, 0x1p-3, 0x.8p1) continues the number, which becomes a
Number::Float; its literal() computes the value (hex digits times a
power of two).  Without an exponent nothing changes: 0x1.8 is still
0x1 followed by the . operator.

Fixes PCL §2 in t/ppi_bugs_pcl.t; reported as #449.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PPI/Token/Number/Float.pm |  9 +++++++++
 lib/PPI/Token/Number/Hex.pm   | 14 ++++++++++++++
 t/07_token.t                  | 31 ++++++++++++++-----------------
 t/ppi_bugs_pcl.t              |  3 +--
 4 files changed, 38 insertions(+), 19 deletions(-)

diff --git a/lib/PPI/Token/Number/Float.pm b/lib/PPI/Token/Number/Float.pm
index a9a91f07..ceda2e32 100644
--- a/lib/PPI/Token/Number/Float.pm
+++ b/lib/PPI/Token/Number/Float.pm
@@ -57,6 +57,15 @@ sub literal {
 	my $self = shift;
 	my $str = $self->_literal;
 	my $neg = $str =~ s/^\-//;
+	# A hexadecimal float: hex digits times a power of two
+	if ( $str =~ /^0[xX]([[:xdigit:]_]*)(?:\.([[:xdigit:]_]*))?[pP]([+-]?\d+)$/ ) {
+		my ( $int, $frac, $exp ) = ( $1, defined $2 ? $2 : '', $3 );
+		s/_//g for $int, $frac;
+		my $val = 0;
+		$val = $val * 16 + hex $_ for split //, $int . $frac;
+		$val *= 2 ** ( $exp - 4 * length $frac );
+		return $neg ? -$val : $val;
+	}
 	$str =~ s/^\./0./;
 	my $val = 0+$str;
 	return $neg ? -$val : $val;
diff --git a/lib/PPI/Token/Number/Hex.pm b/lib/PPI/Token/Number/Hex.pm
index ab300ad6..87135e73 100644
--- a/lib/PPI/Token/Number/Hex.pm
+++ b/lib/PPI/Token/Number/Hex.pm
@@ -78,6 +78,20 @@ sub __TOKENIZER__on_char {
 		return 1;
 	}
 
+	# A hexadecimal float (perl 5.22+): 0x1.8p+1, 0x1p-3, 0x.8p1.  The
+	# binary exponent is required; without it the . is an operator.
+	if ( $char eq '.' or $char eq 'p' or $char eq 'P' ) {
+		pos $t->{line} = $t->{line_cursor};
+		if ( $t->{line} =~ m/\G((?:\.[[:xdigit:]_]*)?[pP][+-]?\d+)/gc ) {
+			$t->{token}->{content} .= $1;
+			$t->{line_cursor} += length $1;
+			$t->{class} = $t->{token}->set_class( 'Number::Float' );
+			$t->_finalize_token;
+			return ( $t->{line_cursor} >= $t->{line_length} ) ? 0
+				: $t->{class}->__TOKENIZER__on_char( $t );
+		}
+	}
+
 	# Doesn't fit a special case, or is after the end of the token
 	# End of token.
 	$t->_finalize_token->__TOKENIZER__on_char( $t );
diff --git a/t/07_token.t b/t/07_token.t
