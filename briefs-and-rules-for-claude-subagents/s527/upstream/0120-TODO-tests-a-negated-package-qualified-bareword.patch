From e0f12cd15948942714094080cbe2eee013fdffeb Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sun, 8 Nov 2026 20:30:22 +0200
Subject: [PATCH 120/127] TODO tests: a negated package-qualified bareword
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perl reads a minus, then the whole word after it, package part and all
(toke.c yyl_hyphen: only a single letter before a non-word character
is a filetest), so -Foo::bar is unary minus applied to the bareword
Foo::bar -- the string "-Foo::bar", or the negated call when the sub is
declared:

    perl -e 'print -Foo::bar, "\n"; sub Foo::baz { 3 } print -Foo::baz, "\n"'
    # -Foo::bar
    # -3

PPI's dashed word stops at the first ::, so -Foo::bar is the two Words
-Foo and ::bar, and core Math::Complex's -CORE::exp(...) and
-CORE::log(...) come out as -CORE followed by ::exp / ::log.

Six rows inside a new PCL §62 TODO block and four controls (a filetest
letter before ::, a spaced minus, a plain dashed word, a subtraction).
Plan 372 -> 382.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 50ad5a16..cb1f6825 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 372 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 382 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -2063,3 +2063,28 @@ for my $case ( [ '${\ m{q}}', 'Regexp::Match=m{q}' ], [ 'm{q};', 'Regexp::Match=
     my @t = map { short_class($_) } toks($code);
     ok( grep( $_ eq $want, @t ), "$code: unchanged (control)" ) or diag "got: @t";
 }
+
+# §62 -- a NEGATED package-qualified bareword: perl reads the minus, then
+# the whole word, package part and all (toke.c yyl_hyphen: only a single
+# letter before a non-word character is a filetest):
+# `print -Foo::bar` prints -Foo::bar, or -3 when sub Foo::bar returns 3;
+# `-CORE::log(...)` negates the builtin.
+TODO: {
+    local $TODO = 'PCL §62: a negated qualified bareword is split at its first ::';
+    for my $case ( [ 'print -Foo::bar, "\n";', 'Word=-Foo::bar' ],
+                   [ 'my $v = -CORE::log(1);', 'Word=-CORE::log' ],
+                   [ 'print -foo::bar::baz;', 'Word=-foo::bar::baz' ],
+                   [ 'my %h = (-Foo::bar => 1);', 'Word=-Foo::bar' ],
+                   [ 'print -Foo::;', 'Word=-Foo::' ],
+                   [ 'f(-a::b);', 'Word=-a::b' ] ) {
+        my ( $code, $want ) = @$case;
+        my @t = map { short_class($_) } toks($code);
+        ok( grep( $_ eq $want, @t ), "$code: the negated qualified name is one Word" ) or diag "got: @t";
+    }
+}
+for my $case ( [ 'print -e::foo;', 'Operator=-e' ], [ 'print - Foo::bar;', 'Word=Foo::bar' ],
+               [ 'print -foo;', 'Word=-foo' ], [ '$x-Foo::bar;', 'Word=Foo::bar' ] ) {
+    my ( $code, $want ) = @$case;
+    my @t = map { short_class($_) } toks($code);
+    ok( grep( $_ eq $want, @t ), "$code: unchanged (control)" ) or diag "got: @t";
+}
