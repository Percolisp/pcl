From ba8fd795e1c5b843afa7fbe7217a281f1d5e32a5 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Sat, 24 Oct 2026 20:44:31 +0300
Subject: [PATCH 14/99] TODO tests: a $ scalar with a non-ASCII name is one
 Symbol

Under use utf8 a variable name may be made of any word characters, and
PPI already lexes @, %, * and & with such a name as one Symbol.  With
$ it splits the name off as a Word after a Cast.  A control keeps the
hash spelling.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_token_symbol.t | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/t/ppi_token_symbol.t b/t/ppi_token_symbol.t
index 28820fbd..0c26308e 100644
--- a/t/ppi_token_symbol.t
+++ b/t/ppi_token_symbol.t
@@ -4,7 +4,7 @@
 
 use lib 't/lib';
 use PPI::Test::pragmas;
-use Test::More tests => 216 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 228 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 use Helper 'safe_new';
@@ -57,6 +57,24 @@ CONSTRUCT_OWN_TOKEN: {
 }
 
 
+NON_ASCII_NAMES: {
+	# Under `use utf8` a variable name may be any word characters, and the
+	# @ % * & sigils already take them.  The $ sigil must too: with
+	# use utf8, perl -e '$X = 1; print $X' (a fullwidth X) prints 1.
+	my $x = "\x{ff38}";
+	TODO: {
+		local $TODO = 'a $ scalar with a non-ASCII name is lexed as a Cast and a Word';
+		for my $code ( "\$$x = 1;", "\$$x\{a} = 1;", "\$$x\[0] = 1;" ) {
+			my $doc = safe_new \$code;
+			my ($tok) = grep { $_->significant } $doc->tokens;
+			ok( $tok && ref($tok) eq 'PPI::Token::Symbol' && $tok->content eq "\$$x", 'the scalar is one Symbol' );
+		}
+	}
+	my $doc = safe_new \"\%$x = ();";
+	my ($tok) = grep { $_->significant } $doc->tokens;
+	ok( $tok && ref($tok) eq 'PPI::Token::Symbol' && $tok->content eq "\%$x", 'the hash is one Symbol (control)' );
+}
+
 sub parse_and_test {
 	local $Test::Builder::Level = $Test::Builder::Level+1;
 
