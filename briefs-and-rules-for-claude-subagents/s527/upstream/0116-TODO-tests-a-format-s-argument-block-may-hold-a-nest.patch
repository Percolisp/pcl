From 10d805e3797a4927026bf7aa4393e39a36e30a26 Mon Sep 17 00:00:00 2001
From: Bernt Budde <bernt.budde@gmail.com>
Date: Tue, 3 Nov 2026 23:09:20 +0200
Subject: [PATCH 116/127] TODO tests: a format's argument block may hold a
 nested format
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

perlform: the line after a picture line with a field supplies its values,
and it may spread over more lines when it starts with a {.  That block is
code, so a format declared inside it ends at its own lone . line, and the
outer format at the . after the block (perl's t/op/write.t 'nested
formats'):

    format NEST =
    @<<<
    {
        local *NEST = *BIRDS{FORMAT}; write NEST;
        format BIRDS =
    @<<<<<
    $birds;
    .
        "nest"
    }
    .

The Format token ends at the first lone . line, so the outer format stops
inside the block and the rest of it is lexed as code.

One row inside a third PCL §40 TODO block and a control (a { opening a
PICTURE line is text).  Plan 368 -> 370.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 t/ppi_bugs_pcl.t | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/t/ppi_bugs_pcl.t b/t/ppi_bugs_pcl.t
index 9ef3e57c..276b0a35 100644
--- a/t/ppi_bugs_pcl.t
+++ b/t/ppi_bugs_pcl.t
@@ -13,7 +13,7 @@
 use lib 't/lib';
 use PPI::Test::pragmas;
 use utf8;
-use Test::More tests => 368 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
+use Test::More tests => 370 + ($ENV{AUTHOR_TESTING} ? 1 : 0);
 
 use PPI ();
 
@@ -1656,6 +1656,18 @@ for my $code ( 'my %h = (format => 1);', '$h{format} = 2;', '$o->format(1);', 's
         ok( grep( $_ eq $want, @t ), "after a format: $rest -- a statement starts" ) or diag "got: @t";
     }
 }
+# ... and an argument line that opens a { runs to its matching } -- the block
+# is code, where a lone . may close a NESTED format (perlform; perl's
+# t/op/write.t 'nested formats').
+TODO: {
+    local $TODO = 'PCL §40: a lone . inside the braces of an argument line ends the format';
+    my @s = stmts("format NEST =\n\@<<<\n{\n    format BIRDS =\n\@<<<<<\n\$b;\n.\n    \"nest\"\n}\n.\nwrite NEST;\n");
+    is( scalar(@s), 2, 'a nested format inside an argument block: the format and write are two statements' ) or diag join ' | ', @s;
+}
+{
+    my @s = stmts("format P =\n{ literal\n.\nprint 1;\n");
+    is( scalar(@s), 2, 'a { opening a PICTURE line is text (control)' ) or diag join ' | ', @s;
+}
 
 # §41 -- an empty package segment is part of the name (toke.c scan_word6):
 # `sub foo::::bar { 7 } print foo::::bar()` prints 7.
