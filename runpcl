# runpcl — transpile and run an arbitrary Perl file through PCL.
#
# Usage:  ./runpcl file.pl          # run a Perl file
#         echo 'print 1+2' | ./runpcl   # run from stdin
#
# Generates /tmp/runpcl_N.lisp (transpiled CL code)
# Prints filtered output to stdout.

use strict;
use warnings;
use File::Basename qw(dirname);
use Cwd qw(abs_path);
use File::Temp qw(tempfile);
use FindBin;
use lib "$FindBin::RealBin/tools/lib";
use PCLSbcl ();   # the ONE builder of an SBCL command line (task #344)

my $root = abs_path(dirname($0));
my $lisp = "/tmp/runpcl_$$.lisp";

# Get input: file arg or stdin
my $input_file;
if (@ARGV) {
    $input_file = shift;
    -f $input_file or die "File not found: $input_file\n";
} else {
    # Read stdin to temp file
    my ($fh, $fname) = tempfile('/tmp/runpcl_stdin_XXXX', SUFFIX => '.pl', UNLINK => 1);
    print $fh $_ while <STDIN>;
    close $fh;
    $input_file = $fname;
}

# Transpile
system("perl -I$root $root/pl2cl --no-cache --lenient-ppi $input_file >$lisp 2>/tmp/runpcl_$$.err");
if ($? != 0) {
    my $err = do { local $/; open(my $f,'<',"/tmp/runpcl_$$.err") or die; <$f> };
    print STDERR "Transpile failed:\n$err";
    unlink $lisp, "/tmp/runpcl_$$.err";
    exit 1;
}
# A transpile can SUCCEED and still carry a diagnostic that must not be
# swallowed — above all the #339 drop announcement ("PCL: statement dropped at
# …"), whose whole point is that a deleted statement is never silent in a run
# context.  Forward those lines to stderr; a probe comparing this runner's
# output against perl must see them (s418 — before this, runpcl discarded the
# announcement and a dropped statement looked like a program that printed
# nothing).
if (open(my $ef, '<', "/tmp/runpcl_$$.err")) {
    while (my $line = <$ef>) {
        print STDERR $line if $line =~ /^PCL: /;
    }
    close $ef;
}

# Run SBCL.
# NB: we deliberately do NOT preload cl/pcl-test.lisp.  The test infrastructure
# is loaded on demand when (and only when) the program does `use Test::More`
# (p-ensure-test-lib in the runtime).  A non-test program — a fuzzer snippet, an
# arbitrary .pl — never pulls it in.
# quote => 0: this path was never shell-quoted here, and the #344 move is
# byte-identical by construction (see tools/lib/PCLSbcl.pm).
my $sbcl_cmd = PCLSbcl::sbcl_prefix_str(runtime => "$root/cl/pcl-runtime.lisp", quote => 0)
             . " --eval \"(setf pcl::*pcl-skip-cache* t)\" --load $lisp";
# PCL_SHOW_SBCL=1 prints the command line this runner spawns.  Four runners
# spawn SBCL and they must agree about what PCL *is* while code runs; when one
# drifts, the difference reads as a PCL bug in whichever measurement is the odd
# one out (task #324: the companion suite ran on a 2 MB stack).  This makes the
# comparison a one-liner instead of an investigation.
print STDERR "SBCL[runpcl]: $sbcl_cmd\n" if $ENV{PCL_SHOW_SBCL};

# THE TWO STREAMS STAY APART (task #504).  This used to be `2>&1`, and the
# merge is what falsified byte-compares against perl: SBCL writes a
# compilation NOTE as a BLOCK — one blank line, then a run of `;`-prefixed
# lines — and the filter below removed the `;` lines but not the blank one, so
# every note left an empty line wedged into the middle of the program's stdout.
#     print "1\n"; eval { my $x = 1/0 }; print "2\n";
# printed "1\n\n2\n" through this runner while the emitted CL run directly
# printed "1\n2\n".  Nothing in the program was wrong; the runner was.
#
# Splitting the streams removes the whole class, because ALL of SBCL's own
# output goes to *error-output*: the banner, the compilation notes, the style
# warnings, an unhandled condition's backtrace, and the runtime's own
# "PCL Runtime loaded" line (cl/pcl-runtime.lisp writes it to *error-output*).
# Measured in both modes — cached-core and PCL_NO_CORE=1 source — SBCL puts
# NOTHING on stdout.  So stdout below is printed VERBATIM: it is the program's
# stdout, byte for byte, including blank lines and lines that begin with `;`.
my $errfile = "/tmp/runpcl_$$.runerr";
my $out = `$sbcl_cmd 2>$errfile`;
my $err = '';
if (open(my $ef, '<', $errfile)) { local $/; $err = <$ef> // ''; close $ef }

# Cleanup
unlink $lisp, "/tmp/runpcl_$$.err", $errfile;

# stdout: the program's, unfiltered.
print $out;

# stderr: the program's, with SBCL's noise removed.  A note is taken out WHOLE
# — the empty line that opens the block goes with the `;` lines, so no
# separator is left behind on this side either.  The block must carry an SBCL
# HEADER (`; file:`, `; in:`, `; caught …`, `; compiling …`, `; wrote …`) to be
# dropped: a blanket `^;` strip also ate a line the PROGRAM wrote — perl prints
# `print STDERR "; x\n"`, so this runner has to as well, or a stderr compare is
# falsified in the other direction.  What survives is what the program wrote,
# plus any `PCL: …` diagnostic the runtime emits during the run (the #339 drop
# announcement above all), which must never be swallowed.
sub strip_sbcl_notes {
    my @lines = split /^/, shift;   # split keeps each line's newline
    my (@out, $i);
    for ($i = 0; $i < @lines; ) {
        my $start = $i;
        my $k = $i;
        $k++ if $lines[$k] eq "\n";                 # optional opening blank line
        if ($k < @lines && $lines[$k] =~ /^;/) {
            my $j = $k;
            $j++ while $j < @lines && $lines[$j] =~ /^;/;
            if (grep { /^;\s*(?:file:|in:|caught|compiling|wrote|processing|loading)\b/ }
                     @lines[$k .. $j - 1]) {
                $i = $j;                            # SBCL's — drop the block
                next;
            }
        }
        push @out, $lines[$start];
        $i = $start + 1;
    }
    return join '', @out;
}
$err = strip_sbcl_notes($err);
$err =~ s/^PCL (?:Runtime|Test)[^\n]*\n//gm;
$err =~ s/^STYLE-WARNING[^\n]*\n//gm;
print STDERR $err;
