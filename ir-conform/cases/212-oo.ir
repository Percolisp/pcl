(|p-data-form| 1 "212-oo.pl" "program" "v2-830")
(|p-bucket| 0 |:decls| |:compile|)
(|p-declare-sub| |pl-hi|)
(|p-bucket| 0 |:defs| |:compile|)
(|p-sub| |pl-hi| (|&rest| |%_args|) (|:returns| |:str| |:wantarray-insensitive| |t| |:writes-args| |nil| |:needs| ()) (|p-args-body| (|block| |nil| "hi")))
(|p-bucket| 0 |:captured| |:compile|)
(|p-cl-text| ";; use parent qw( -norequire Foo )")
(|p-cl-text| "(p-eval-always (p-defpackage :Foo))")
(|p-cl-text| "(defclass plc-bar (Foo::plc-foo) ())")
(|p-cl-text| "(p-defcell @ISA (make-array 0 :adjustable t :fill-pointer 0))")
(|p-bucket| 0 |:run| |:run|)
(|p-cl-text| "(p-push @ISA \"Foo\")")
(|p-bucket| 0 |:run| |:run|)
(|p-print| (|p-string-concat| "ISA=[" (|p-join| |$"| |Bar::@ISA|) "]\n"))
(|p-print| "isa_foo=" (|p-if| (|p-scalar-ctx| (|p-method-call| "Bar" "isa" "Foo")) 1 0) "\n")
(|p-print| "isa_nore=" (|p-if| (|p-scalar-ctx| (|p-method-call| "Bar" "isa" "-norequire")) 1 0) "\n")
(|p-data-form-end| 10 5)
