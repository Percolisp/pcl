(|p-data-form| 1 "318-string.pl" "program" "v2-830")
(|p-bucket| 0 |:captured| |:compile|)
(|p-cl-text| "(p-defcell $name (make-p-box nil))")
(|p-cl-text| "(p-defcell $name_utf8 (make-p-box nil))")
(|p-cl-text| "(p-eval-always (p-note-inc \"strict\"))")
(|p-bucket| 0 |:run| |:run|)
(|p-scalar-=| |$name_utf8| (|p-scalar-=| |$name| (|p-chr| 9787)))
(|p-void-ctx| (|utf8::pl-encode| |$name_utf8|))
(|p-print| "len name=" (|p-list-ctx| (|p-length| |$name|)) " len utf8=" (|p-list-ctx| (|p-length| |$name_utf8|)) "\n")
(|p-setf| (|p-cast-$| |$name|) "Face")
(|p-print| "via unicode=" (|p-if| (|p-defined| (|p-cast-$| |$name|)) (|p-cast-$| |$name|) "undef") "\n")
(|p-print| "via octets=" (|p-if| (|p-defined| (|p-cast-$| |$name_utf8|)) (|p-cast-$| |$name_utf8|) "undef") "\n")
(|p-data-form-end| 9 3)
