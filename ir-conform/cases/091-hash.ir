(|p-data-form| 1 "091-hash.pl" "program" "v2-830")
(|p-bucket| 0 |:decls| |:compile|)
(|p-declare-sub| |pl-c|)
(|p-bucket| 0 |:defs| |:compile|)
(|p-sub| |pl-c| (|&rest| |%_args|) (|:returns| |:str| |:wantarray-insensitive| |t| |:writes-args| |nil| |:needs| ()) (|p-args-body| (|block| |nil| "code")))
(|p-bucket| 0 |:captured| |:compile|)
(|p-cl-text| "(p-defcell $s (make-p-box nil))")
(|p-cl-text| "(p-defcell @a (make-array 0 :adjustable t :fill-pointer 0))")
(|p-cl-text| "(p-defcell %h (make-hash-table :test 'equal))")
(|p-bucket| 0 |:run| |:run|)
(|p-scalar-=| |$s| 5)
(|p-array-=| |@a| (|vector| 9))
(|p-scalar-ctx| (|p-hash-=| |%h| (|vector| "k" 1)))
(|p-undef| (|p-make-typeglob| "main" "s"))
(|p-undef| (|p-make-typeglob| "main" "a"))
(|p-undef| (|p-make-typeglob| "main" "h"))
(|p-undef| (|p-make-typeglob| "main" "c"))
(|p-print| "scalar: " (|p-if| (|p-defined| |$s|) (|p-string-concat| "STILL " |$s|) "cleared") "\n")
(|p-print| "array:  " (|p-if| |@a| (|p-string-concat| "STILL " (|p-join| |$"| |@a|)) "cleared") "\n")
(|p-print| "hash:   " (|p-if| |%h| (|p-.| "STILL " (|p-list-ctx| (|p-join| "," |%h|))) "cleared") "\n")
(|p-print| "code:   " (|p-if| (|p-sub-defined| "main" "c") (|p-.| "STILL " (|pl-c|)) "cleared") "\n")
(|p-data-form-end| 16 3)
