(|p-cl-text| ";; use overload q(<) => sub { my ($s,$o,$sw)=@_; $sw ? 1 : 0 },              q(-) => sub { \"AB-MINUS\" }, q(\"\") => sub { \"AB\" } ...\n(p-register-overloads \"AB\" (p-flatten-args (list \"<\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"AB\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-void-ctx (p-let (($s :box (make-p-box nil)) ($o :box (make-p-box nil)) ($sw :box (make-p-box nil))) (p-scalar-ctx (p-list-= (vector $s $o $sw) @_)) (p-caller-ctx (p-if $sw 1 0)))))))) \"-\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"AB\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil \"AB-MINUS\")))) \"\\\"\\\"\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"AB\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil \"AB\")))))))")
(|p-bucket| 1 |:run| |:run|)
(|p-cl-text| ";; use overload q(bool) => sub { 0 }, q(\"\") => sub { \"BL\" } ...\n(p-register-overloads \"BL\" (p-flatten-args (list \"bool\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"BL\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil 0)))) \"\\\"\\\"\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"BL\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil \"BL\")))))))")
(|p-print| (|p-list-ctx| (|p-abs| (|p-scalar-ctx| (|p-method-call| "AB" "new")))) "\n")
(|p-print| (|p-if| (|p-!| (|p-scalar-ctx| (|p-method-call| "BL" "new"))) "T" "F") "\n")
(|p-print| (|p-list-ctx| (|p-abs| -7)) " " (|p-list-ctx| (|p-abs| 7)) " " (|p-list-ctx| (|p-abs| -7.5)) "\n")
