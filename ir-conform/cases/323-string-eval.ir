(|p-data-form| 1 "323-string-eval.pl" "program" "v2-830")
(|p-bucket| 0 |:captured| |:compile|)
(|p-cl-text| "(p-eval-always (p-note-inc \"re\"))")
(|p-bucket| 0 |:run| |:run|)
(|p-let| ((|@s| |:array| (|p-cl-text| "(make-array 0 :adjustable t :fill-pointer 0)"))) (|p-cl-text| ";; push @s, sub { eval \"1\" } for 1,2\n(p-foreach ($_ (vector 1 2)) (p-push @s (p-cloned-sub (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"main\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-eval \"1\" (list (cons \"@s\" @s))))))))))") (|p-print| "eval:  " (|p-if| (|p-==| (|p-aref| |@s| 0) (|p-aref| |@s| 1)) "same" "different") "\n") (|p-let| ((|@t| |:array| (|p-cl-text| "(make-array 0 :adjustable t :fill-pointer 0)"))) (|p-cl-text| ";; push @t, sub { use re \"eval\"; my $x; s/$x/1/ } for 1,2\n(p-foreach ($_ (vector 1 2)) (p-push @t (p-cloned-sub (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"main\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-void-ctx (p-let (($x :scalar (p-undef))) (p-caller-ctx (p-=~ $_ (p-subst :pat $x :rep \"1\" :flags \"\" :tier :dynamic))))))))))))") (|p-print| "reev:  " (|p-if| (|p-==| (|p-aref| |@t| 0) (|p-aref| |@t| 1)) "same" "different") "\n") (|p-let| ((|@u| |:array| (|p-cl-text| "(make-array 0 :adjustable t :fill-pointer 0)"))) (|p-cl-text| ";; push @u, sub { s/1/1/ee } for 1,2\n(p-foreach ($_ (vector 1 2)) (p-push @u (p-cloned-sub (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"main\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-=~ $_ (p-subst :pat \"1\" :rep (lambda () (p-eval 1 (list (cons \"@s\" @s) (cons \"@t\" @t) (cons \"@u\" @u)))) :flags \"e\" :tier :native)))))))))") (|p-print| "ee:    " (|p-if| (|p-==| (|p-aref| |@u| 0) (|p-aref| |@u| 1)) "same" "different") "\n") (|p-let| ((|@v| |:array| (|p-cl-text| "(make-array 0 :adjustable t :fill-pointer 0)"))) (|p-cl-text| ";; push @v, sub { 1 } for 1,2\n(p-foreach ($_ (vector 1 2)) (p-push @v (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"main\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil 1))))))") (|p-print| "plain: " (|p-if| (|p-==| (|p-aref| |@v| 0) (|p-aref| |@v| 1)) "same" "different") "\n")))))
