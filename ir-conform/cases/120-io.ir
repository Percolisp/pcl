(|p-data-form| 1 "120-io.pl" "program" "v2-830")
(|p-bucket| 0 |:run| |:run|)
(|p-print| "1 before: " (|p-if| (|p-exists| |%INC| "./t.pl") "yes" "no") "\n")
(|p-let| ((|$r| |:box| (|p-cl-text| "(make-p-box nil)"))) (|p-my-=| |$r| (|p-scalar-ctx| (|p-do| "./t.pl"))) (|p-print| "2 do ret=" (|p-if| (|p-defined| |$r|) |$r| "U") (|p-string-concat| " v=" |main::$v| "\n")) (|p-print| "3 INC{./t.pl}=" (|p-if| (|p-exists| |%INC| "./t.pl") (|vector| (|p-//| (|p-gethash| |%INC| "./t.pl") "UNDEF")) "ABSENT") "\n") (|p-print| "4 keys matching t.pl: " (|p-list-ctx| (|p-join| "|" (|p-list-ctx| (|p-grep| (|lambda| (|$_|) (|p-=~| |$_| (|p-regex| |:pat| "t\\.pl" |:flags| "" |:tier| |:native|))) (|p-list-ctx| (|p-keys| |%INC|)))))) "\n") (|p-scalar-=| |main::$v| 0) (|p-let| ((|$q| |:box| (|p-cl-text| "(make-p-box nil)"))) (|p-my-=| |$q| (|p-require-file| "./t.pl")) (|p-print| "5 require ret=" (|p-if| (|p-defined| |$q|) |$q| "U") (|p-string-concat| " v=" |main::$v| "\n")) (|p-let| ((|$s| |:box| (|p-cl-text| "(make-p-box nil)"))) (|p-my-=| |$s| (|p-scalar-ctx| (|p-do| "./nope-xyz.pl"))) (|p-print| "6 faildo ret=" (|p-if| (|p-defined| |$s|) |$s| "U") " INC=" (|p-if| (|p-exists| |%INC| "./nope-xyz.pl") (|vector| (|p-//| (|p-gethash| |%INC| "./nope-xyz.pl") "UNDEF")) "ABSENT") "\n") (|p-let| ((|$f| |:box| (|p-cl-text| "(make-p-box nil)"))) (|p-or| (|p-open| |$f| ">" "./dies.pl") (|p-die| |:loc| "120-io.pl line 20")) (|p-print| |:fh $f| "die \"boom\\n\";\n") (|p-close| |$f|) (|p-let| ((|$u| |:box| (|p-cl-text| "(make-p-box nil)"))) (|p-my-=| |$u| (|p-scalar-ctx| (|p-do| "./dies.pl"))) (|p-print| "7 diedo ret=" (|p-if| (|p-defined| |$u|) |$u| "U") (|p-string-concat| " err=[" |$@| "] INC=") (|p-if| (|p-exists| |%INC| "./dies.pl") (|vector| (|p-//| (|p-gethash| |%INC| "./dies.pl") "UNDEF")) "ABSENT") "\n") (|p-let| ((|$g| |:box| (|p-cl-text| "(make-p-box nil)"))) (|p-or| (|p-open| |$g| ">" "./false.pl") (|p-die| |:loc| "120-io.pl line 24")) (|p-print| |:fh $g| "0;\n") (|p-close| |$g|) (|p-let| ((|$w| |:box| (|p-cl-text| "(make-p-box nil)"))) (|p-my-=| |$w| (|p-scalar-ctx| (|p-do| "./false.pl"))) (|p-print| "8 falsedo ret=" (|p-if| (|p-defined| |$w|) |$w| "U") " INC=" (|p-if| (|p-exists| |%INC| "./false.pl") (|vector| (|p-//| (|p-gethash| |%INC| "./false.pl") "UNDEF")) "ABSENT") "\n") (|p-let| ((|$w2| |:box| (|p-cl-text| "(make-p-box nil)"))) (|p-my-=| |$w2| (|p-scalar-ctx| (|p-eval-block| (|p-cl-text| ";; require \"./false.pl\"\n(p-eval-always\n  (p-require-file \"./false.pl\"))")))) (|p-print| "9 require-after-false ret=" (|p-if| (|p-defined| |$w2|) |$w2| "U") (|p-string-concat| " err=[" |$@| "]\n"))))))))))
(|p-data-form-end| 2 9)
