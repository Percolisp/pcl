(|p-cl-text| ";; use overload '0+' => sub { $_[0]{v} }, '\"\"' => sub { 'P(' . $_[0]{v} . ')' },              '+'  => sub { AoPlus->new($_[0]{v} + (ref($_[1]) ? $_[1]{v} : $_[1])) },              '-'  => sub { my ($a__excl__0,$b__excl__1,$sw)=@_; my $o = ref($b__excl__1) ? $b__excl__1->{v} : $b__excl__1;                            AoPlus->new($sw ? $o - $a__excl__0->{v} : $a__excl__0->{v} - $o) },              fallback => 1 ...\n(p-register-overloads \"AoPlus\" (p-flatten-args (list \"0+\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"AoPlus\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-gethash (p-aref @_ 0) \"v\"))))) \"\\\"\\\"\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"AoPlus\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-. (p-. \"P(\" (p-gethash (p-aref @_ 0) \"v\")) \")\"))))) \"+\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"AoPlus\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-method-call \"AoPlus\" \"new\" (p-+ (p-gethash (p-aref @_ 0) \"v\") (p-if (p-ref (p-aref @_ 1)) (p-gethash (p-aref @_ 1) \"v\") (p-aref @_ 1)))))))) \"-\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"AoPlus\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-void-ctx (p-let (($a__excl__0 :box (make-p-box nil) :perl \"$a\" :why :exception-global) ($b__excl__1 :box (make-p-box nil) :perl \"$b\" :why :exception-global) ($sw :box (make-p-box nil))) (p-scalar-ctx (p-list-= (vector $a__excl__0 $b__excl__1 $sw) @_)) (p-let (($o :box (make-p-box nil))) (p-my-= $o (p-if (p-ref $b__excl__1) (p-gethash-deref $b__excl__1 \"v\") $b__excl__1)) (p-caller-ctx (p-method-call \"AoPlus\" \"new\" (p-if $sw (p-- $o (p-gethash-deref $a__excl__0 \"v\")) (p-- (p-gethash-deref $a__excl__0 \"v\") $o))))))))))) \"fallback\" 1)))")
