(|p-cl-text| ";; use overload '0+' => sub { $_[0]{v} }, '\"\"' => sub { 'M(' . $_[0]{v} . ')' },              '++' => sub { $_[0]{v} += 10; 'INCED' },              '--' => sub { $_[0]{v} -= 10; 'DECED' }, fallback => 1 ...\n(p-register-overloads \"AoMut\" (p-flatten-args (list \"0+\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"AoMut\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-gethash (p-aref @_ 0) \"v\"))))) \"\\\"\\\"\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"AoMut\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-. (p-. \"M(\" (p-gethash (p-aref @_ 0) \"v\")) \")\"))))) \"++\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"AoMut\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-void-ctx (p-incf (p-gethash (p-aref @_ 0) \"v\") 10) (p-caller-ctx \"INCED\")))))) \"--\" (lambda (&rest %_args) (let ((@_ (p-flatten-args %_args)) (*pcl-current-package* \"AoMut\") (*pcl-caller-wantarray* *wantarray*)) (p-sub-frame (block nil (p-void-ctx (p-decf (p-gethash (p-aref @_ 0) \"v\") 10) (p-caller-ctx \"DECED\")))))) \"fallback\" 1)))")
