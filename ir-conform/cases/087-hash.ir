(|p-data-form| 1 "087-hash.pl" "program" "v2-830")
(|p-bucket| 0 |:decls| |:compile|)
(|p-declare-sub| |pl-gcdret|)
(|p-bucket| 0 |:defs| |:compile|)
(|p-sub| |pl-gcdret| (|&rest| |%_args|) (|:writes-args| |nil| |:needs| (|:nonlocal_exit.return|)) (|p-raw-params| ((|$x| |:scalar|) (|$y| |:scalar|)) (|block| |nil| (|p-void-ctx| (|p-if| (|p-==| |$x| |$y|) (|progn| (|p-return| |$x|))) (|p-caller-ctx| (|p-tail-value| (|p-if| (|p->| |$x| |$y|) (|pl-gcdret| (|p--| |$x| |$y|) |$y|) (|pl-gcdret| |$x| (|p--| |$y| |$x|)))))))))
