(|p-let| ((|$n| |:box| (|p-cl-text| "(make-p-box nil)"))) (|p-my-=| |$n| (|p-gethash| |%ENV| "N")) (|p-let| ((|$r| |:box| (|p-cl-text| "(make-p-box nil)"))) (|p-my-=| |$r| 0) (|p-cl-text| ";; $r += gcdret($_ % 97 + 1, 89) for 1..$n\n(p-foreach ($_ (p-.. 1 $n)) (p-incf $r (p-void-ctx (pl-gcdret (p-+ (p-% $_ 97) 1) 89))))") (|p-print| (|p-string-concat| |$r| "\n"))))
