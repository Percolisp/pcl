(|p-data-form| 1 "180-loops-exits.pl" "program" "v2-830")
(|p-bucket| 0 |:decls| |:compile|)
(|p-declare-sub| |pl-f|)
(|p-bucket| 0 |:defs| |:compile|)
(|p-sub| |pl-f| (|&rest| |%_args|) (|:wantarray-insensitive| |t| |:writes-args| |nil| |:captures| (|$n|) |:needs| ()) (|p-args-body| (|block| |nil| (|p-void-ctx| (|p-post++| |$n|) (|%p-dyn-loop-exit| |:last|)))))
(|p-bucket| 0 |:captured| |:compile|)
(|p-cl-text| "(p-defcell $n (make-p-box nil))")
(|p-bucket| 0 |:run| |:run|)
(|p-scalar-=| |$n| 0)
(|p-cl-text| ";; f() for 1..3\n(p-foreach ($_ (p-.. 1 3)) :dyn t (p-void-ctx (pl-f)))")
(|p-print| (|p-string-concat| "n=" |$n| "\n"))
(|p-data-form-end| 6 2)
