# pclperl-for-tests — a perl-lookalike CLI that runs the program under PCL.
#
# FOR THE TEST HARNESS ONLY.  test.pl's fresh_perl_*/runperl helpers spawn a
# child "perl"; historically that was $^X (the real perl), which made every
# child assertion compare perl-to-perl — passing by construction and testing
# nothing about PCL.  The harness now points those helpers here (via the
# PCLPERL env var, see perl-tests/t/test.pl), so the child program is
# transpiled and executed under PCL.
#
# The switches are perl's, parsed by tools/lib/PCLSwitches.pm -- the SAME
# parser `pcl` uses -- and the source-changing ones (-n -p -a -F -l -0 -g -i
# -s -x -E -M -m) are handed to pl2cl, whose ONE expansion merges them with
# the program's own #! line (s506f).  -v/-h/-V/-d/-u are answered by `pcl`
# itself.  An unknown switch dies with perl's message and status.
# PERL5OPT is honored (switches prepended), matching perl; PERL5LIB reaches
# the child's @INC for free because the perl that runs pl2cl honors it.
#
# SBCL startup: reuses PCLCore::sbcl_prefix — a fresh PCL_TEST_CORE (as built
# by tools/prove-core or tools/run-perl-suite.pl) makes each child ~0.2s;
# without one the runtime is source-loaded (~1.2s/child).
use strict;
use warnings;
use File::Temp qw(tempdir);
use FindBin qw($RealBin);
use lib "$RealBin/../Pl/t";
use lib "$RealBin/lib";
use PCLCore;
use PCLPaths ();   # the ONE root resolver (task #1302)
use PCLSwitches ();   # perl's argv grammar + the ONE expansion (s506f)

# The two `use lib` lines above are the BOOTSTRAP; the root itself comes from
# the one resolver, which also honours $PCL_ROOT.  It answers with the
# CANONICAL path, where this used to spell it "$RealBin/.." — the same
# directory, and the one every other runner names.
my $root    = PCLPaths::root($RealBin);
my $pl2cl   = "$root/pl2cl";
my $runtime = "$root/cl/pcl-runtime.lisp";

my @args = @ARGV;
# A harness child compares its stderr BYTE FOR BYTE with perl's (fresh_perl
# with 2>&1), so pcl's one-line taint announcement (-T/-t, which PCL does not
# model) is silenced here -- the ONE documented switch for it.  Measured: it
# cost op/utftaint.t two verified rows (s507).
$ENV{PCL_TAINT_QUIET} = 1;
unshift @args, split(' ', $ENV{PERL5OPT}) if defined $ENV{PERL5OPT} && length $ENV{PERL5OPT};

# --- perl's argv grammar: tools/lib/PCLSwitches.pm, the ONE parser (s506f) --
# This wrapper used to carry its own cluster parser and its own copy of the
# -n/-p/-a/-F/-l/-0/-i/-x source rewriting; both are now the shared ones, so
# a harness child and a `pcl` run of the same command line compile the same
# program.  An unknown switch now DIES as perl's does (it used to be ignored).
my $sw = PCLSwitches::parse_argv(\@args);
my @incs;
for my $e (@{ $sw->{events} }) {
  my ($k, $arg, $status) = @$e;
  if ($k eq '!') { print STDERR $arg; exit $status }
  # -v -h -? -V -d -u -S: `pcl` answers these exactly (the version and config
  # texts, the refusals, the PATH search) -- one implementation, not two.
  if ($k =~ /^[vh?Vdu]\z/) { exec($^X, "$root/pcl", @args) or die "pclperl-for-tests: exec pcl: $!\n" }
  if ($k eq 'D') {
    print STDERR "Recompile perl with -DDEBUGGING to use -D switch (did you mean -d ?)\n";
  }
  push @incs, $arg if $k eq 'I';
}
my @rest = @{ $sw->{args} };

# --- the program source ------------------------------------------------------
# -e text and a program on STDIN go to a temp file compiled `--as` -e / -,
# so $0, __FILE__ and every location say what perl's do; a program FILE is
# compiled in place under its own name.  The source-changing switches travel
# to pl2cl as they are (--switches), where they meet the program's own #! line
# in the ONE expansion (PCLSwitches::expand_program).
my $dir  = tempdir(CLEANUP => 1);
my $lisp = "$dir/prog.lisp";
my ($pl, $progname, @as);
if (@{ $sw->{code} }) {
  ($pl, $progname, @as) = ("$dir/prog.pl", '-e', '--as=-e');
  open(my $ofh, '>', $pl) or die "pclperl-for-tests: $pl: $!\n";
  print $ofh join("\n", @{ $sw->{code} }), "\n"; close $ofh;
} else {
  $progname = defined $sw->{program} ? $sw->{program} : '-';
  if ($progname eq '-') {
    ($pl, @as) = ("$dir/prog.pl", '--as=-');
    local $/; my $src = <STDIN> // '';
    open(my $ofh, '>', $pl) or die "pclperl-for-tests: $pl: $!\n";
    print $ofh $src; close $ofh;
  } else {
    if (!-f $progname) {
      print STDERR "Can't open perl script \"$progname\": No such file or directory\n";
      exit 2;
    }
    $pl = $progname;
  }
}
my $source_events = PCLSwitches::source_events($sw->{events});
my @switches = @$source_events
  ? ('--switches=' . PCLSwitches::encode_events($source_events)) : ();

# --- Transpile --------------------------------------------------------------
my @inc_flags = map { "-I$_" } @incs;
my $tr = system(join(' ',
  map { "\Q$_\E" } ($^X, @inc_flags, $pl2cl, '--no-cache', '--lenient-ppi', @as, @switches, $pl))
  . " > \Q$lisp\E 2> \Q$dir\E/terr");
if ($tr != 0) {
  open(my $efh, '<', "$dir/terr");
  print STDERR do { local $/; <$efh> // '' } if $efh;
  exit 255;                                       # perl's compile-error exit
}
# (-c is a source-changing switch: the expansion ends the program with a BEGIN
# that says "NAME syntax OK" and exits, so the compile phase runs, as perl's.)

# --- Run --------------------------------------------------------------------
# Stdout passes through untouched; stderr is captured and scrubbed of
# SBCL/runtime noise (compiler notes, style-warnings, "PCL Runtime loaded")
# before re-emission — fresh_perl_is compares EXACT child output (usually
# with 2>&1), and a real perl child prints none of that.  The cost is
# stdout/stderr interleaving, which no runperl caller depends on (perl's own
# runperl_and_capture separates the streams anyway).
my @sbcl = ('sbcl', PCLCore::sbcl_prefix($runtime));
my @argv_form = @rest
  ? ('--eval', '(setf pcl::@ARGV (make-array ' . scalar(@rest)
       . ' :adjustable t :fill-pointer ' . scalar(@rest) . ' :initial-contents (list '
       . join(' ', map { my $s = $_; $s =~ s/(["\\])/\\$1/g; "\"$s\"" } @rest) . ')))')
  : ();
# An uncaught die must behave like perl: the message alone on stderr, exit
# 255 — not an SBCL backtrace with exit 1.  The load is wrapped so the
# condition's report (the die string, already carrying perl's " at FILE
# line N." suffix) is printed and the exit code forced.
# Errors escaping a toplevel form arrive wrapped in sb-c::input-error-in-load,
# whose report prepends "While evaluating the form ..." — unwrap to the
# original condition so only the perl-shaped message prints.
#
# NOT `load` (task #346).  `load` holds the .lisp file OPEN for as long as the
# program runs inside it, so the child program sees descriptors a real perl
# child does not: measured, fd 3 AND fd 4 both point at prog.lisp, and
# `open(my $t, "<&=3")` SUCCEEDS here where perl fails it with EBADF.  For a
# test file that is ABOUT descriptors (t/run/cloexec.t opens fd 3 on purpose)
# that is not noise, it is the thing under test.
#
# So: slurp the source, CLOSE the file, then read-and-eval one form at a time
# from a string stream.  Reading incrementally is what keeps `(in-package …)`
# working — it is a READ-time effect, so reading all forms up front under one
# *package* would mis-read every form after a package switch.
my $load_form = sprintf(
  '(handler-case'
. '  (let ((src (with-open-file (s "%s" :direction :input :external-format :utf-8)'
. '               (let ((buf (make-string (file-length s))))'
. '                 (subseq buf 0 (read-sequence buf s))))))'
. '    (with-input-from-string (in src)'
. '      (let ((eof (quote #:eof)) (*load-pathname* (pathname "%s")) (*load-truename* (probe-file "%s")))'
. '        (loop for form = (read in nil eof) until (eq form eof) do (eval form)))))'
. '  (error (e) (when (typep e (quote sb-int:encapsulated-condition)) (setf e (sb-int:encapsulated-condition e))) (format *error-output* "~A" e) (finish-output *error-output*) (sb-ext:exit :code 255)))',
  $lisp, $lisp, $lisp);
my $cmd = join(' ', map { "\Q$_\E" } (@sbcl, @argv_form, '--eval', $load_form))
        . " 2> \Q$dir\E/err";
# `exec`: the wait status must be SBCL's OWN -- under dash a signal death
# would come back as an ordinary exit of 128 + N (task #2107).
system("exec $cmd");
my $status = $?;
if (open(my $efh, '<', "$dir/err")) {
  my ($skip_block, $seen_real) = (0, 0);
  while (my $line = <$efh>) {
    # Multi-line compiler-note blocks: "; ..." bodies, "compilation unit
    # finished" trailers, and their indented continuation lines.
    if ($line =~ /^;/ or $line =~ /^compilation unit/ or $line =~ /^caught \d/) {
      $skip_block = 1; next;
    }
    if ($skip_block and $line =~ /^\s(?:\s|caught|Undefined|%|p-|\S+$)/) { next }
    # A note block is FRAMED by blank lines (one before "; file: …", one after
    # its "; compilation unit finished" trailer).  Without this the frame
    # survived the scrub and a trivial program printed 56 empty lines on stderr
    # — task #346.  A blank line the PROGRAM itself printed is still passed
    # through: only the ones adjacent to a skipped block are dropped, and the
    # flag is cleared by the first line of real output.
    if ($line =~ /^\s*$/ and ($skip_block or !$seen_real)) { next }
    $skip_block = 0;
    $seen_real = 1;
    next if $line =~ /^PCL Runtime loaded$/;
    next if $line =~ /^STYLE-WARNING:/;
    # SBCL's loader prints an eager two-line context note when an error
    # escapes a toplevel form; the second line's tail is the real message.
    next if $line =~ /^While evaluating the form starting at line/;
    $line =~ s/^\s+of #P"[^"]*"://;
    $line =~ s/\Q$pl\E/$progname/g if $pl ne $progname;   # a temp file is -e or -
    print STDERR $line;
  }
}
# A signal death is re-raised, so the test that ran this "perl" reads it as
# `$? & 127`, like a real perl child (PCLSbcl::exit_like).  The temp dir goes
# first: a signal death skips the END block File::Temp cleans up in.
File::Temp::cleanup();
require PCLSbcl;
PCLSbcl::exit_like($status);
