# install-pcl — install PCL onto this machine (task #277, release phase 1).
#
# THE MODEL (USER ruling, docs/release-plan-v0.1.md): the runtime and its saved
# SBCL core are COMPILED AT INSTALL TIME on the target machine — the same model
# the XS bridge already uses (docs/xs-artifact-cache.md), never at first use.
# A first run that pays a compile is a first run that behaves differently from
# every later one, and a compile inside a user's program is a compile whose
# failure surfaces as their bug.
#
# WHAT GETS INSTALLED
#
#   $PREFIX/lib/pcl/        the tree the runners need, in its REPO-RELATIVE
#                           shape: pcl, pl2cl, runpcl, Pl/, lib/, cl/,
#                           tools/lib/.  The layout is not cosmetic — every
#                           script finds the tree beside its own REAL path
#                           (PCLPaths::root, task #1302), so the relative
#                           arrangement IS the lookup mechanism.
#   $PREFIX/lib/pcl/pcl.core   the saved core, built here from the INSTALLED
#                           runtime (so it can never reflect a different one).
#   $PREFIX/lib/pcl/VERSION the release this tree is, written here because an
#                           installed tree has no .git and no CHANGELOG; it is
#                           what `pcl --version` reads.
#   $PREFIX/bin/pcl         wrapper scripts that exec the real ones.  Not
#   $PREFIX/bin/pl2cl       symlinks: each script takes its root from its own
#   $PREFIX/bin/runpcl      real path, which a symlink here would answer with
#                           $PREFIX/bin.
#
# What is NOT installed: the development runners (tools/runt, tools/clt,
# tools/sweep-perl-tests.pl, tools/run-perl-suite.pl), the gate (Pl/t), the
# corpora and the docs.  An installation is the three commands and what they
# need to run.
#
# Usage:
#   tools/install-pcl                     # into $HOME/.local
#   tools/install-pcl --prefix /opt/pcl
#   tools/install-pcl --no-core           # skip the core build (slower runs)
#   tools/install-pcl --dry-run           # print what it would do
#   tools/install-pcl --uninstall         # remove what it installed
#
# The install FAILS, loudly and before copying anything, when a dependency is
# missing or too old, and it fails after copying when the smoke test does not
# produce exactly what it must.  A half-installed PCL that "mostly works" is
# the thing this script exists to prevent.

use v5.20;
use strict;
use warnings;
use File::Basename qw(dirname basename);
use File::Path qw(make_path remove_tree);
use File::Spec;
use File::Copy qw(copy);
use Cwd qw(abs_path);
use Getopt::Long;
use lib dirname(abs_path($0)) . '/lib';
use PCLPaths ();   # the ONE root resolver (task #1302)

# The tree this installer is PART OF is what it installs, so the derivation is
# root_of (the tree that owns this script) and never root() — an installer
# whose SOURCE could be redirected by an environment variable would copy a
# different PCL than the checkout the operator typed the command in.  The
# `use lib` above is the bootstrap that finds tools/lib.
my $root = PCLPaths::root_of($0)
    or die "install-pcl: cannot find the PCL tree this script belongs to "
         . "(no cl/pcl-runtime.lisp beside or above " . abs_path($0) . ").\n";

my %opt = (prefix => $ENV{PREFIX} // "$ENV{HOME}/.local", core => 1);
GetOptions(\%opt, 'prefix=s', 'core!', 'dry-run', 'force', 'uninstall', 'quiet', 'help')
    or die "usage: $0 [--prefix DIR] [--no-core] [--force] [--dry-run] [--uninstall]\n";
if ($opt{help}) {
    print <<"USAGE";
usage: $0 [--prefix DIR] [--no-core] [--force] [--dry-run] [--quiet]
       $0 --uninstall [--prefix DIR] [--dry-run]

  --prefix DIR   install root (default: \$HOME/.local, or \$PREFIX)
  --no-core      do not build the saved SBCL core (runs stay correct, but
                 every sbcl spawn then recompiles the runtime, ~1.2 s)
  --force        REPLACE an existing installed tree (it is removed first, so
                 a shim that no longer exists cannot survive into the new
                 install and shadow a core module)
  --uninstall    remove <prefix>/lib/pcl and the wrappers this script wrote
                 (pcl, pl2cl, runpcl).  It refuses when <prefix>/lib/pcl is
                 not a PCL install, and it never touches a per-user cache --
                 `pcl --clear-cache` is what empties that.
  --dry-run      print the steps, change nothing
  --quiet        only warnings and errors

Installs pcl, pl2cl and runpcl into <prefix>/bin as small sh wrappers, and the
runtime tree they need into <prefix>/lib/pcl.  Development runners, the test
gate and the corpora are NOT installed.

Caches.  The SBCL core is compiled HERE, at install time, into
<prefix>/lib/pcl/pcl.core -- the same model perl uses for its own library,
and the reason no user's first program pays for it.  The per-module cache is
per USER and is built on first use, under \$PCL_CACHE_DIR (default
~/.pcl-cache, created with mode 0700); nothing under the install prefix is
written at run time.  `pcl --cache-info` says where a given user's cache is
and what is in it, and `pcl --clear-cache` empties it.

Environment.
  PREFIX          the default for --prefix
  PCL_ROOT        overrides where an INSTALLED script looks for its tree.  It
                  is a debugging and packaging escape hatch, not something an
                  ordinary install needs: every command finds its tree beside
                  its own real path.  (This script ignores it deliberately --
                  what it installs is the tree it is part of.)
  PCL_CACHE_DIR   where each user's caches go (default ~/.pcl-cache)
USAGE
    exit 0;
}

my $prefix  = abs_path_maybe($opt{prefix});
my $libdir  = "$prefix/lib/pcl";
my $bindir  = "$prefix/bin";

# The three commands an installation IS.  One list: @TREE copies them, the
# wrapper loop writes them, --uninstall removes them, and the smoke test runs
# them.  A fourth command added here is installed, wrapped, removed and tested
# by construction.
my @COMMANDS = qw(pcl pl2cl runpcl);

sub say_step { say "==> $_[0]" unless $opt{quiet} }
sub say_info { say "    $_[0]"  unless $opt{quiet} }

# abs_path fails on a path that does not exist yet; resolve what we can.
sub abs_path_maybe {
    my ($p) = @_;
    return abs_path($p) if -e $p;
    my $parent = dirname($p);
    return -e $parent ? abs_path($parent) . '/' . basename($p) : $p;
}

# ---------------------------------------------------------------- dependencies

# Each row: name, how to get its version, the minimum, why PCL needs it.
# A missing OPTIONAL row warns; a missing required row is fatal, and ALL of
# them are checked before the first one is reported, so one run tells the user
# everything they have to install.
sub check_deps {
    my @missing;
    my @found;

    my $perl_min = 5.020;
    if ($] < $perl_min) { push @missing, "perl >= 5.20 (this is $])" }
    else                { push @found,   sprintf("perl %vd", $^V) }

    # PPI has a FLOOR: PCL's token repairs are keyed on the stream PPI 1.291
    # produces (docs/ppi-upstream-bugs.md -- `-` glued to an identifier, the
    # glob disambiguation, `~~`, ...), and the gate is validated on it.  Distro
    # packages lag (Ubuntu 24.04 ships 1.277), so the floor is checked, with
    # the same remedy the README gives: `cpanm PPI`.
    my %min = (PPI => 1.291);
    for my $m (qw(PPI Moo Test::More File::Temp)) {
        my $v = module_version($m);
        if (!defined $v)            { push @missing, "$m (perl module)" }
        elsif ($min{$m} && $v < $min{$m}) {
            push @missing, "$m >= $min{$m} (this is $v; `cpanm $m` installs the current one)";
        }
        else                        { push @found, "$m $v" }
    }

    my $sbcl = qx{sbcl --version 2>/dev/null};
    chomp $sbcl;
    if ($sbcl =~ /SBCL\s+(\d+)\.(\d+)\.(\d+)/) {
        my @v = ($1, $2, $3);
        push @found, "sbcl $v[0].$v[1].$v[2]";
        # The supported floor is what the suite is actually validated against
        # (CLAUDE.md Dependencies), not a guessed range.
        my $have = sprintf('%d%03d%03d', @v);
        push @missing, "sbcl >= 2.5.2 (this is $v[0].$v[1].$v[2])"
            if $have < 2_005_002;
    }
    else { push @missing, "sbcl (not on PATH, or --version unrecognised)" }

    say_info($_) for @found;
    return @missing;
}

sub module_version {
    my ($m) = @_;
    my $out = qx{$^X -M$m -e 'print \$${m}::VERSION // "?"' 2>/dev/null};
    return ($? == 0 && length $out) ? $out : undef;
}

# ------------------------------------------------------------------ the copy

# The runtime subset, in repo-relative form.  Everything else in the checkout
# (Pl/t, perl-tests, docs, the other tools) is development material.
my @TREE = (@COMMANDS, qw(Pl lib cl tools/lib));

sub copy_tree {
    my ($src, $dst) = @_;
    if (-d $src) {
        make_path($dst) unless -d $dst || $opt{'dry-run'};
        opendir(my $dh, $src) or die "opendir $src: $!\n";
        for my $e (sort grep { !/^\.\.?$/ } readdir $dh) {
            # `t` under Pl/ is the gate; it is not part of an installation.
            next if $e eq 't' && basename($src) eq 'Pl';
            copy_tree("$src/$e", "$dst/$e");
        }
        closedir $dh;
        return;
    }
    return unless -f $src;
    return if $opt{'dry-run'};
    make_path(dirname($dst)) unless -d dirname($dst);
    copy($src, $dst) or die "copy $src -> $dst: $!\n";
    my $mode = (stat $src)[2] & 07777;
    chmod $mode, $dst;
}

# The version, written down ONCE — here, where a checkout is still in reach.
# An installed tree has no .git and no CHANGELOG, so without this file
# `pcl --version` can only say "unknown", and a bug report loses the one
# number that says which PCL is running (task #1300).  There is exactly one
# reader (pcl's pcl_version) and exactly one writer, this.
#
# Two sources, in order: `git describe --tags`, and — when the tree being
# installed is itself a tarball or an archive extraction with no .git, which
# is how the container test and a release tarball reach this code —
# CHANGELOG.md's top heading.  Never a guess: a wrong version in a bug report
# is worse than none, so the last resort says plainly that it does not know.
sub write_version_file {
    return if $opt{'dry-run'};
    my $v = qx{git -C \Q$root\E describe --tags --always --dirty 2>/dev/null};
    chomp $v if defined $v;
    $v = changelog_version() unless defined $v && length $v;
    $v = "unknown (installed from a tree with no git history)"
        unless defined $v && length $v;
    open my $fh, '>', "$libdir/VERSION" or die "write $libdir/VERSION: $!\n";
    say {$fh} $v;
    close $fh;
    say_info("VERSION $v");
}

# CHANGELOG.md's first `## ` heading, which is the release this tree claims to
# be (the file's own convention: `## Unreleased` while a tag is pending, `##
# v0.1.0 — ...` once one is cut).  Marked as its source, because "0.1.0" read
# from a changelog and "v0.1.0-428-gb5e9f845" read from git answer the same
# question with different precision and a bug report needs to know which.
sub changelog_version {
    open my $fh, '<', "$root/CHANGELOG.md" or return undef;
    while (my $line = <$fh>) {
        next unless $line =~ /^##\s+(\S.*?)\s*$/;
        close $fh;
        return "$1 (from CHANGELOG.md; the installed tree had no git history)";
    }
    close $fh;
    return undef;
}

# ------------------------------------------------------------------- wrappers

sub write_wrapper {
    my ($name) = @_;
    my $path = "$bindir/$name";
    return if $opt{'dry-run'};
    open my $fh, '>', $path or die "write $path: $!\n";
    print $fh wrapper_text($name);
    close $fh;
    chmod 0755, $path;
}

# ONE spelling of a wrapper: write_wrapper writes it and --uninstall
# recognises it.  Recognition is what makes the uninstall safe — it removes a
# file in <prefix>/bin only when that file is the one this script wrote for
# THIS libdir, never a `pcl` somebody else put there.
sub wrapper_text {
    my ($name) = @_;
    return <<"SH";
#!/bin/sh
# PCL $name — installed by tools/install-pcl.  Execs the real script, which
# finds Pl/, lib/, cl/ and tools/lib/ relative to ITSELF; a symlink here would
# make it resolve its root to this bin directory instead.
exec "$libdir/$name" "\$\@"
SH
}

# --------------------------------------------------------------- the core build

sub build_core {
    my $runtime = "$libdir/cl/pcl-runtime.lisp";
    my $core    = "$libdir/pcl.core";
    return if $opt{'dry-run'};
    my $tmp = "$core.new.$$";
    my $cmd = sprintf('sbcl --noinform --non-interactive --load %s --eval %s',
                      quotemeta($runtime),
                      quotemeta(qq{(sb-ext:save-lisp-and-die "$tmp" :executable nil)}));
    my $out = qx{$cmd 2>&1};
    unless ($? == 0 && -f $tmp) {
        unlink $tmp;
        die "install-pcl: building the saved core FAILED — the install is not "
          . "usable as it stands.  Re-run with --no-core to install without "
          . "it (every run then recompiles the runtime).\n\n$out\n";
    }
    # Atomic: a half-written core is a core that loads and then dies inside a
    # user's program, which is the failure this rename prevents.
    rename $tmp, $core or die "install-pcl: rename $tmp -> $core: $!\n";
}

# ------------------------------------------------------- artifact staleness

# The three checked-in transpiled artifacts carry the compiler generation they
# were built with on line 1 (ir-spec.md §9.2).  The gate has a test for this
# (Pl/t/artifact-staleness-01.t); here it is a WARNING, because an installer
# is not the place to refuse a checkout the developer chose to ship.
sub check_artifacts {
    my $gen;
    if (open my $rt, '<', "$root/cl/pcl-runtime.lisp") {
        while (<$rt>) { ($gen) = /\*pcl-cache-generation\*\s+"([^"]+)"/ and last }
        close $rt;
    }
    return unless defined $gen;
    my @stale;
    opendir(my $dh, "$root/cl") or return;
    for my $f (sort grep { /\.lisp$/ } readdir $dh) {
        open my $a, '<', "$root/cl/$f" or next;
        my $line1 = <$a>;
        close $a;
        next unless defined $line1 && $line1 =~ /^;;; pcl: .*\bgen=(\S+)/;
        push @stale, "$f (gen=$1)" if $1 ne $gen;
    }
    closedir $dh;
    warn "install-pcl: WARNING — checked-in artifacts are older than the "
       . "compiler in this checkout (generation $gen): @stale.  They will run "
       . "on the codegen that built them; `tools/rebuild-pack` and its "
       . "siblings regenerate them.\n" if @stale;
}

# ------------------------------------------------------------------ smoke test

# The install is not finished until the INSTALLED tools transpile and run a
# program.  All three of them, because they exercise different halves: pl2cl
# alone (does the tree resolve?), runpcl (does the core/runtime load and
# run?), and pcl — the everyday command, and the one a user actually types, so
# an install where only the other two work is an install that is broken for
# everybody.  `pcl -e` also goes through a path neither of the others does:
# inline code, with no file to take a directory from.
sub smoke {
    my $tmp = File::Spec->tmpdir . "/pcl-install-smoke.$$.pl";
    open my $fh, '>', $tmp or die "write $tmp: $!\n";
    print $fh qq{my \@w = map { uc } qw(pcl works);\nprint "\@w\\n";\n};
    close $fh;

    my $cl = qx{$bindir/pl2cl $tmp 2>&1};
    unless ($? == 0 && $cl =~ /\(p-print/) {
        unlink $tmp;
        die "install-pcl: SMOKE TEST FAILED — the installed pl2cl did not "
          . "transpile a two-line program.\n\n$cl\n";
    }

    my $out = qx{$bindir/runpcl $tmp 2>&1};
    unless ($? == 0 && $out eq "PCL WORKS\n") {
        unlink $tmp;
        die "install-pcl: SMOKE TEST FAILED — the installed runpcl ran the "
          . "program but printed:\n$out\nexpected: PCL WORKS\n";
    }

    my $ran = qx{$bindir/pcl $tmp 2>&1};
    unless ($? == 0 && $ran eq "PCL WORKS\n") {
        unlink $tmp;
        die "install-pcl: SMOKE TEST FAILED — the installed pcl ran the "
          . "program but printed:\n$ran\nexpected: PCL WORKS\n";
    }
    unlink $tmp;

    my $inline = qx{$bindir/pcl -e 'print "PCL WORKS\\n"' 2>&1};
    unless ($? == 0 && $inline eq "PCL WORKS\n") {
        die "install-pcl: SMOKE TEST FAILED — the installed `pcl -e` printed:\n"
          . "$inline\nexpected: PCL WORKS\n";
    }
}

# ------------------------------------------------------------------ the PATH
#
# Printed ONLY when $bindir is not already on $PATH, and it is the exact line
# to paste — "add it to your PATH" is advice, `export PATH=...` is the answer.
# No rc file is edited, ever: a program that writes to a shell's startup file
# is a program the user has to audit.
sub path_hint {
    my @path = grep { length } split /:/, ($ENV{PATH} // '');
    my $want = $bindir;
    $want =~ s{/+\z}{};
    for my $p (@path) {
        $p =~ s{/+\z}{};
        return if $p eq $want;
    }
    say_step("$bindir is not on your PATH");
    say_info(qq{add it with:  export PATH="$bindir:\$PATH"});
    say_info("(put that line in your shell's startup file; install-pcl does not edit one)");
}

# -------------------------------------------------------------- --uninstall
#
# Removes what this script wrote and nothing else: the tree at <prefix>/lib/pcl
# and, in <prefix>/bin, exactly the wrapper files whose content is the one
# write_wrapper produces for THIS libdir.  A per-user cache is not part of an
# installation (it lives under $PCL_CACHE_DIR, one per user, and other PCLs may
# share it), so it is left alone and said to be left alone.
sub do_uninstall {
    unless (-f "$libdir/cl/pcl-runtime.lisp") {
        die "install-pcl: $libdir is not a PCL installation "
          . (-d $libdir ? "(no cl/pcl-runtime.lisp in it)" : "(it does not exist)")
          . " — refusing to remove anything.\n";
    }

    say_step($opt{'dry-run'} ? "would remove the installed tree $libdir"
                             : "removing the installed tree $libdir");
    remove_tree($libdir) unless $opt{'dry-run'};

    for my $name (@COMMANDS) {
        my $path = "$bindir/$name";
        next unless -f $path;
        my $have = do { open my $fh, '<', $path or next; local $/; <$fh> };
        if (defined $have && $have eq wrapper_text($name)) {
            say_info($opt{'dry-run'} ? "would remove $path" : "removed $path");
            unlink $path unless $opt{'dry-run'};
        }
        else {
            say_info("left $path alone — it is not the wrapper this script wrote");
        }
    }

    # <prefix>/lib may now be empty; leave it.  Removing directories the
    # installer did not create is how an uninstall takes something with it.
    say_step("done");
    say_info("the per-user compiled-module cache is untouched "
           . "(it is not part of an installation) — `pcl --clear-cache` empties it");
}

# ------------------------------------------------------------------------ main

# --uninstall comes first and asks for nothing: removing an installation must
# not depend on PPI, Moo or SBCL still being present — the usual reason to
# uninstall is that something about the machine changed.
if ($opt{uninstall}) {
    say_step("PCL uninstall: $prefix");
    do_uninstall();
    exit 0;
}

say_step("PCL install: $root -> $prefix");
say_step("checking dependencies");
my @missing = check_deps();
die "install-pcl: missing dependencies:\n" . join('', map { "    - $_\n" } @missing)
  . "install nothing until these are present.\n" if @missing;

check_artifacts();

# An EXISTING tree is replaced, never merged.  A copy-over leaves behind any
# file the checkout has since deleted — and a stale `lib/Foo.pm` shim is not
# inert, it is an @INC entry that shadows the core module PCL now uses.
if (-d $libdir && !$opt{'dry-run'}) {
    die "install-pcl: $libdir already exists.  Re-run with --force to replace "
      . "it (a merge would leave stale shims behind, which is worse than "
      . "either state).\n" unless $opt{force};
    die "install-pcl: $libdir exists but does not look like a PCL install "
      . "(no pl2cl, no cl/pcl-runtime.lisp) — refusing to remove it.\n"
        unless -f "$libdir/pl2cl" || -f "$libdir/cl/pcl-runtime.lisp";
    say_step("replacing the existing install in $libdir");
    File::Path::remove_tree($libdir);
}

say_step($opt{'dry-run'} ? "would copy the runtime tree to $libdir" : "copying the runtime tree to $libdir");
say_info($_) for @TREE;
copy_tree("$root/$_", "$libdir/$_") for @TREE;
write_version_file();

say_step($opt{'dry-run'} ? "would write wrappers in $bindir" : "writing wrappers in $bindir");
say_info(join ' ', @COMMANDS);
make_path($bindir) unless -d $bindir || $opt{'dry-run'};
write_wrapper($_) for @COMMANDS;

if ($opt{core}) {
    say_step($opt{'dry-run'} ? "would build the saved core" : "compiling the runtime into $libdir/pcl.core");
    build_core();
    say_info(sprintf("%.0f MB", (-s "$libdir/pcl.core") / (1024 * 1024)))
        if !$opt{'dry-run'} && -f "$libdir/pcl.core";
}
else {
    say_step("skipping the saved core (--no-core): runs use the per-user cached core instead (built on first use under ~/.pcl-cache/core; source mode if that fails)");
}

unless ($opt{'dry-run'}) {
    say_step("smoke test");
    smoke();
}

say_step("done");
path_hint() unless $opt{quiet};
