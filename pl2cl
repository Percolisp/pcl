# pl2cl - Convert Perl expressions to Common Lisp
# Usage: pl2cl [options] <file.pl>
#    or: echo '$x = 1' | pl2cl
#
# Modes:
#   (default)      Transpile to stdout
#   --bundle       Compile to single .fasl with all dependencies
#   --executable   Create standalone executable

use v5.20;
use strict;
use warnings;

# ---- THE TRANSPILE CLIENT (task #1545) ------------------------------------
#
# The gate is this project's throughput constraint — a batch runs it six to
# nine times — and ~3200 of its rows spawn this script.  Measured s473u
# (#1544): one spawn costs 0.13 CPU-s of perl plus PPI plus every Pl::* module
# BEFORE it reads a byte of the snippet, so ~420 CPU-s of a 2900 CPU-s gate run
# is that load, paid over and over on inputs of a few dozen characters.
#
# So: when PCL_XSERVER names a socket, ask the pl2cl ALREADY LOADED there and
# print its answer.  This block sits above the `use Pl::Parser` chain on
# purpose — it runs before that chain is compiled, so a served request never
# pays the load at all; what is left is perl's own start and one round trip.
#
# THE STATE QUESTION, answered once instead of per variable: the server forks a
# child per request from a process that has never transpiled, so a request
# begins from exactly the module state a freshly spawned pl2cl has — the
# renamed-lexical counters, the announce-once hashes, Pl::Environment, all of
# it.  An enumeration of things to reset would drift the first time a counter
# is added; a fork cannot.
#
# WHAT IS NOT SERVED falls through to the ordinary path, which is always
# correct — declining is free, guessing is not:
#   * --server / --xserver / --bundle / --executable / --help: not transpiles.
#   * --output / --eval-pkg: both mean stdin, and deciding whether pl2cl would
#     READ stdin needs the option spec — reading it when pl2cl would not can
#     block on a pipe nobody closes.  The bare stdin form (`echo … | pl2cl`) is
#     declined for the same reason; it is three call sites in the whole gate.
#   * PCL_SHOW_MEM_CAP / PCL_NO_MEM_CAP / PCL_MEM_CAP_MB: the cap is a property
#     of THIS process (the `ulimit -v` exec below), which no other process can
#     honour on its behalf.
#   * any argv this block cannot classify without re-implementing GetOptions.
#     It serves exactly one shape: one non-flag argument that is an existing
#     file.  `--deps FILE` is the one value-taking option it understands, so
#     the `pl2cl --module --deps …` the RUNTIME spawns on a module cache miss
#     is served too; Pl/t/gate-cost-01.t holds that list against pl2cl's own
#     GetOptions spec so the two cannot drift.
#
# The flags, the whole environment and the working directory travel in the
# request.  The environment is ALSO part of the socket name, because a variable
# read at module-load time (Pl::Passes reads PCL_FACTS there) cannot be
# answered by a server started under a different one.  What the name does NOT
# carry is perl's own switches: the server is exec'd as `$^X $0 --xserver`, so
# a caller that runs `perl -I<dir> pl2cl` would get a server without that -I.
# No such caller sets PCL_XSERVER today (the sweep does not), and PERL5LIB is
# in the key; if one ever does, it belongs in the key too.
BEGIN {
  # Helper subs live INSIDE this block so they are compiled with it: a sub
  # further down the file does not exist yet when an early BEGIN runs.

  # FNV-1a over the sorted compiler-relevant assignments PLUS this script's own
  # path and interpreter.  An XS digest module costs more to load than this
  # costs to compute, and separating the handful of environments one gate run
  # uses is all it has to do.  The SCRIPT PATH is in the key because
  # PCL_XSERVER is inherited by everything a test file spawns, and some of
  # those run a pl2cl from ANOTHER tree (an installed copy, a `git archive`
  # extraction) — that one must get its own server, never this one's answers.
  sub _xc_key {
    my ($script) = @_;
    my $s = join "\0", "$^X\0$script",
                       map { "$_=" . (defined $ENV{$_} ? $ENV{$_} : '') }
                       sort grep { /^PCL/ || $_ eq 'PERL5LIB' } keys %ENV;
    my $h = 2166136261;
    for my $c (unpack 'C*', $s) { $h = (($h ^ $c) * 16777619) & 0xFFFFFFFF }
    return sprintf '%08x', $h;
  }

  sub _xc_connect {
    my ($path) = @_;
    return undef if !-S $path;
    socket(my $fh, Socket::PF_UNIX(), Socket::SOCK_STREAM(), 0) or return undef;
    if (!connect($fh, Socket::pack_sockaddr_un($path))) { close $fh; return undef }
    binmode($fh, ':raw');
    my $old = select($fh); $| = 1; select($old);
    return $fh;
  }

  sub _xc_readn {
    my ($fh, $n) = @_;
    my $buf = '';
    while (length($buf) < $n) {
      my $got = sysread($fh, my $c, $n - length($buf));
      return undef if !defined $got || $got == 0;
      $buf .= $c;
    }
    return $buf;
  }

  sub _xc_readline {
    my ($fh) = @_;
    my $line = '';
    while (1) {
      my $got = sysread($fh, my $c, 1);
      return undef if !defined $got || $got == 0;
      last if $c eq "\n";
      $line .= $c;
      return undef if length($line) > 64;
    }
    return $line;
  }

  # A server that cannot be reached says so ONCE, on stderr, and the run
  # continues on the spawn path.  Both halves matter: a silently slow gate is
  # exactly the drift #324 cost this project months of wrong measurements, and
  # a fallback that DIED would turn a performance problem into a broken gate.
  #   $path.warned  gates the line (O_EXCL, so concurrent clients say it once
  #                 between them, not once each).
  #   $path.down    is written only when no server could be STARTED, and makes
  #                 every later client in this test process decline at once —
  #                 without it each of the ~3200 calls pays the start timeout
  #                 again, which is a hang in all but name.
  # A server that dies mid-request does NOT get `.down`: the next client starts
  # a fresh one and the run recovers, which is why the two markers are separate.
  sub _xc_down {
    my ($path, $why, $fatal) = @_;
    require Errno;                     # %! below; this path is never hot
    my $first = 1;
    if (sysopen(my $w, "$path.warned",
                POSIX::O_WRONLY() | POSIX::O_CREAT() | POSIX::O_EXCL(), 0600)) {
      close $w;
    }
    elsif ($!{EEXIST}) { $first = 0 }   # someone already said it
    # Any OTHER reason the marker could not be written (an unwritable socket
    # directory is itself a way for the server to be unreachable) still warns:
    # saying it more than once is a nuisance, saying it never is the failure.
    if ($first) {
      $why =~ s/\s+$//;
      warn "pl2cl: transpile server unavailable ($why) -- falling back to a "
         . "spawn per call; this run is CORRECT but slow\n";
    }
    if ($fatal) { if (open my $d, '>', "$path.down") { close $d } }
    return;
  }

  # Double fork: the middle process exits at once, so the client never waits on
  # the server and has no zombie to reap.  Liveness after that is the server's
  # own business, exactly as it is for `--server` (ruled s397).
  sub _xc_spawn {
    my ($path, $owner, $script) = @_;
    my $pid = fork();
    return undef if !defined $pid;
    if (!$pid) {
      my $g = fork();
      POSIX::_exit(127) if !defined $g;
      if (!$g) {
        POSIX::setsid();
        open(STDIN,  '<', '/dev/null');
        open(STDOUT, '>', '/dev/null');
        # `or do {…}`, not a statement after exec(): the latter is what perl
        # warns "Statement unlikely to be reached" about — on EVERY transpile,
        # which would put a line on the stderr this script must keep clean.
        exec($^X, $script, '--xserver', '--xsock', $path, '--xowner', $owner)
          or do { POSIX::_exit(127) };
      }
      POSIX::_exit(0);
    }
    waitpid($pid, 0);
    # 10 s.  The load it is waiting for is 0.13 CPU-s (measured #1544), so this
    # is ~60x even on a box running the gate at -j8; and because the wait is
    # paid at most ONCE per test process (`.down` below), a bigger number would
    # only make a broken server look like a hang.
    for (1 .. 200) {
      my $fh = _xc_connect($path);
      return $fh if $fh;
      select(undef, undef, undef, 0.05);
    }
    return undef;
  }

  XCLIENT: {
    my $base = $ENV{PCL_XSERVER};
    last XCLIENT if !defined $base || !length $base;
    # This block runs ABOVE the memory-cap re-exec below, so a call that
    # declines here runs it a SECOND time in the re-exec'd incarnation — which
    # would pay the start timeout twice and say the warning twice.  The flag is
    # DELETED as it is read, so it is gone from the %ENV the re-exec carries and
    # from every child's.
    last XCLIENT if delete $ENV{PCL_XSERVER_TRIED};
    # The socket's directory holds the server AND the markers below; if it is
    # not there, nothing can be started and nothing can be remembered, so say so
    # at once rather than paying the start timeout on every single call.
    my $bdir = $base;
    $bdir =~ s{/[^/]*$}{};
    $bdir = '.' if !length $bdir;
    if (!-d $bdir) {
      warn "pl2cl: PCL_XSERVER=$base names no existing directory -- "
         . "transpiling without the server\n";
      $ENV{PCL_XSERVER_TRIED} = 1;
      last XCLIENT;
    }
    last XCLIENT if $ENV{PCL_SHOW_MEM_CAP} || $ENV{PCL_NO_MEM_CAP}
                 || defined $ENV{PCL_MEM_CAP_MB};
    last XCLIENT if grep {
      m{^--?(?:server|xserver|xsock|xowner|bundle|executable|h|help|o|output|eval-pkg)(?:=|$)}
    } @ARGV;
    my @nonflag;
    for (my $i = 0; $i < @ARGV; $i++) {
      my $a = $ARGV[$i];
      if ($a =~ /^-/) { $i++ if $a eq '--deps'; next }
      push @nonflag, $a;
    }
    last XCLIENT if @nonflag != 1 || !-f $nonflag[0];

    my ($status, $out, $err, $path, $reached);
    my $ok = eval {
      require Socket;
      require POSIX;
      require Cwd;
      # A server that exits between our connect and our write would otherwise
      # kill this process with SIGPIPE, where the contract is that ANY failure
      # falls through to the ordinary path.
      local $SIG{PIPE} = 'IGNORE';
      my $script = Cwd::abs_path($0);
      die "no script path\n" if !defined $script;
      $path = "$base-" . _xc_key($script) . ".sock";
      # Already declined, already announced: decline again without paying the
      # start timeout a second time.
      die "server marked down\n" if -e "$path.down";
      my $fh = _xc_connect($path);
      if (!$fh) {
        $fh = _xc_spawn($path, ($ENV{PCL_XSERVER_OWNER} || getppid()), $script);
        _xc_down($path, 'it did not start', 1) if !$fh;
      }
      die "no server\n" if !$fh;
      $reached = 1;
      my @field = (Cwd::getcwd(), scalar(@ARGV), @ARGV,
                   scalar(keys %ENV), map { ($_, $ENV{$_}) } sort keys %ENV);
      my $blob = join '', map { length($_) . ':' . $_ . ',' } @field;
      print {$fh} "PCLXS2 " . length($blob) . "\n" . $blob or die "write\n";
      my $hdr = _xc_readline($fh);
      die "no reply\n" if !defined $hdr;
      die "bad reply\n" if $hdr !~ /^PCLXS2 (\d+) (\d+) (\d+)$/;
      my ($st, $ol, $el) = ($1, $2, $3);
      $out = $ol ? _xc_readn($fh, $ol) : '';
      $err = $el ? _xc_readn($fh, $el) : '';
      close $fh;
      die "short reply\n" if !defined $out || !defined $err;
      $status = $st;
      1;
    };
    # ANY failure — no server, a short read, a protocol mismatch — falls through
    # to the ordinary path.  A slow transpile beats a missing one; a SILENT slow
    # transpile is what _xc_down is for.
    if (!$ok) {
      _xc_down($path, ($@ || 'unknown'), 0) if $reached;
      $ENV{PCL_XSERVER_TRIED} = 1;   # read and deleted by the re-exec'd copy
      last XCLIENT;
    }
    binmode(STDOUT, ':raw');
    binmode(STDERR, ':raw');
    my $o = select(STDOUT); $| = 1; select(STDERR); $| = 1; select($o);
    print STDOUT $out;
    print STDERR $err;
    # The reply carries the child's RAW wait status, so a child that died of a
    # signal kills US with that signal rather than exiting 128+n: a caller's $?
    # must say the same thing either way, and quietly turning a signal death
    # into an exit code is the substitution rule 12 exists to forbid.
    if (my $sig = $status & 127) {
      kill $sig, $$;
      POSIX::_exit(128 + $sig);   # blocked or ignored: say it the other way
    }
    POSIX::_exit($status >> 8);
  }
}

# ---- THE COMPILER SIDE'S MEMORY CAP (task #471) ----------------------------
#
# Before this, a runaway anywhere in Pl/** cost the MACHINE, not the run.
# Measured 2026-08-23: an in-flight edit left one helper calling itself, perl
# has no tail-call elimination, and the process climbed to 7.76 GB anon RSS /
# 9.7 GB VM, exhausted the 4 GB swap and hung the desktop until the kernel's
# global OOM killer took it.  Under a cap the SAME bug dies in ~5 s naming
# itself ("Deep recursion on subroutine …" + "Out of memory in perl").  Note
# that the deep-recursion WARNING fired unbounded too, at depth 100, scrolled
# past and changed nothing: A WARNING DOES NOT STOP AN ALLOCATION.  A cap is
# also the only guard that covers the runaways no warning exists for — a
# growing string, an unterminated parse loop.
#
# WHY HERE: every compiler-side tool spawns ./pl2cl (the gate, the sweep, the
# suite runner, corpus-diff, drop-census, gate-set-scan, emission-ab, and the
# runtime's own p-transpile-file), so this file is the perl-side analogue of
# tools/lib/PCLSbcl.pm — the ONE seam (ruled s435).  perl cannot lower its own
# RLIMIT_AS without BSD::Resource (not core), so the cap is a one-time re-exec
# through `sh -c 'ulimit -v N; exec …'`, before PPI is loaded.  Cost when
# nothing is wrong: one sh fork against a ~1 s transpile, and the cap itself
# is free — it only fires on a runaway.
#
#   PCL_MEM_CAP_MB=N   change the cap (default 4096, matching the ulimit
#                      tools/run-perl-suite.pl already puts on its children)
#   PCL_NO_MEM_CAP=1   run uncapped (a deliberate big compile)
#   PCL_SHOW_MEM_CAP=1 print the cap actually in force, like PCL_SHOW_SBCL
#
# THE NUMBER IS MEASURED, not guessed: the heaviest legitimate transpiles peak
# at ~140 MB of address space (perl-tests/signatures.t 140 MB, re/pat.t 103,
# perl-tests/pack.t 96, cl/pack-impl.pl 86), so 4 GB is ~30x headroom.
#
# NOT applied to --bundle/--executable: those spawn SBCL, which RESERVES a
# multi-gigabyte address space up front, and `ulimit -v` counts reservations.
# RESIDUE: the ~40 Pl/t files that `use Pl::Parser` IN PROCESS are not covered
# by this seam (they never spawn pl2cl); see #471.
BEGIN { CAP: {
  last CAP if $ENV{PCL_MEM_CAPPED} || $ENV{PCL_NO_MEM_CAP};
  my $mb = $ENV{PCL_MEM_CAP_MB} // 4096;
  last CAP if $mb !~ /^[0-9]+$/ || $mb == 0 || !-x '/bin/sh';
  last CAP if grep { $_ eq q{--bundle} || $_ eq '--executable' } @ARGV;
  # Re-exec the ORIGINAL argv, so perl's own switches (-I, -w, …) survive; the
  # naive ($^X, $0, @ARGV) form silently drops them, and the suite runner
  # spawns us as `perl -I<root> pl2cl …`.
  my @cmd;
  if (open my $c, '<', '/proc/self/cmdline') {
    local $/; my $s = <$c> // ''; close $c;
    @cmd = grep { length } split /\0/, $s;
  }
  @cmd = ($^X, $0, @ARGV) if !@cmd;
  $ENV{PCL_MEM_CAPPED} = 1;
  # `or do {…}` rather than a statement after exec(): the latter is what perl
  # warns "Statement unlikely to be reached" about, on every single transpile.
  exec('/bin/sh', '-c', 'ulimit -v "$1" 2>/dev/null; shift; exec "$@"',
       'pcl-mem-cap', $mb * 1024, @cmd)
    or do {
      # exec failed: transpiling uncapped beats not transpiling at all.
      delete $ENV{PCL_MEM_CAPPED};
      warn "pl2cl: memory cap NOT applied (exec /bin/sh: $!)\n";
    };
} }
if ($ENV{PCL_SHOW_MEM_CAP}) {
  my $lim = 'unknown';
  if (open my $l, '<', '/proc/self/limits') {
    while (<$l>) { $lim = $1 eq 'unlimited' ? 'none' : "$1 bytes"
                     if /^Max address space\s+(\S+)/ }
    close $l;
  }
  warn "pl2cl: memory cap = $lim\n";
}

use Getopt::Long;
use File::Spec;
use File::Basename;
use Cwd qw(abs_path);
use POSIX ();

# Output UTF-8 so non-ASCII chars (from \xNN escapes) are valid for SBCL's reader
binmode(STDOUT, ":utf8");
binmode(STDERR, ":utf8");

# Find Pl::Parser relative to this script, not cwd
use lib dirname(abs_path($0));

# The ONE root resolver (task #1302).  tools/lib joins @INC only for the
# duration of the require -- the same shape Pl/ProtoCache.pm's cache_dir uses,
# and for the same reason twice over:
#   * this script's @INC is EMITTED into every program preamble
#     (*p-core-inc-dirs*, so that code replacing @INC still resolves core
#     modules), so a permanent `use lib "<root>/tools/lib"` here would change
#     the compiler's OUTPUT;
#   * `local @INC` keeps %INC keyed "PCLPaths.pm", so the `require PCLPaths`
#     in Pl/ProtoCache.pm and tools/lib/PCLSbcl.pm finds it already loaded.
#     Requiring it by ABSOLUTE PATH instead keys %INC on the path, the sibling
#     requires read the file a SECOND time, and every sub is redefined -- ten
#     warnings on the stderr of EVERY transpile, which broke five gate files
#     (measured, s470bz).
# The `use lib` above is the bootstrap that finds the tree; $ROOT is what every
# later derivation in this file uses, and it honours $PCL_ROOT.
BEGIN {
  local @INC = (@INC, dirname(abs_path($0)) . '/tools/lib');
  require PCLPaths;
}
my $ROOT = PCLPaths::root($0);

use Pl::Parser;
use Pl::CLForm ();   # build_eval_preamble's designator rule (cl_pkg) — rule 11
use Pl::ProtoCache ();  # the ONE reader of *pcl-cache-generation* (task #560)
use Pl::Passes ();      # --facts: the licence annotation switch (task #1213)

# v2 (Pl::Parser2 → Pl::CLForm structured emission) is the ONLY pipeline
# (default since session 273/W9; the v1 escape hatch and the whole-file
# fallback were removed at E4.1 step 2, task #242).  `PCL_V1`/`PCL_V1_FILES`
# no longer exist: anything v2 cannot lower is now a hard error, which is the
# point — a gap used to become a silent re-transpile through a second
# compiler with different semantics.  `PCL_V2=1` is still accepted as a
# harmless no-op so existing scripts keep working.
#
# `Pl::Parser` is still LOADED (v1's expression seam is called from inside
# v2); what is gone is the file-level v1 ENTRY.  Step 3 (#243) deletes the
# file-level chunks that this commit made unreachable.
require Pl::Parser2;

# (The v2 whole-file fallback lived here until E4.1 step 2.  It caught a
# "Parser2 TODO: …" and re-transpiled the file through v1 — which meant a v2
# gap silently changed compilers mid-run, and any resulting divergence was
# attributed to the program rather than to the fallback.  The gaps are now
# hard errors.  The audit side-channel that measured this (PCL_V2_AUDIT_LOG /
# PCL_V2_AUDIT_KEEP) went with it: with one pipeline there is no route to
# count.  History: docs/v1-live-share-audit.md, docs/v2-endgame-plan.md §5a.)

# What the last parse_source consulted — the outermost dependency walk frame
# (task #1261).  Read by --deps (the runtime's cache sidecar) and --manifest
# (`depends`); undef before the first transpile.
our $LAST_WALK;

# The ONE parser entry.  Anything v2 cannot lower dies here, and
# the die IS the answer — there is no second compiler to retry on.  Modes are
# whitelisted rather than ignored, so an unknown mode is a loud error instead
# of a silently-dropped option.
sub parse_source {
  my ($method, @args) = @_;
  my %opts = @args[1 .. $#args];
  # `lenient_ppi` never had a v2 implementation — it only ever worked by
  # routing to v1, whose parser truncates at the first unparseable line.  The
  # flag stays ACCEPTED (runpcl / tools/runt / the sweep all pass it) and inert; what it
  # used to paper over now dies naming the file, from Parser2's PPI check.
  delete $opts{lenient_ppi};
  my %known = (eval_mode => 1, eval_pkg => 1, eval_captures => 1, eval_features => 1);
  my @unknown = sort grep { !$known{$_} } keys %opts;
  die "pl2cl: unknown transpile mode(s): @unknown\n" if @unknown;
  # One process can transpile many sources (`--server` answers every string
  # eval of a whole run), and a transpile that DIES could leave the prototype
  # walk's frame stack half-unwound — after which the next transpile's
  # dependency bookkeeping would be recorded against a dead walk.  Start each
  # source from an empty stack (task #560).
  Pl::ProtoCache::reset_walks();
  # THE DEPENDENCY MANIFEST (task #1261).  One OUTERMOST walk frame around the
  # whole transpile, so the frames that already record what each nested
  # prototype walk resolved also report to a frame that stands for THIS source.
  # `end_walk` then hands back the transitive list of every module and file
  # whose prototypes/exports this transpile read — the ONE dependency walk
  # (rule 11), which `--deps` writes beside the cached emission and
  # `--manifest` publishes as `depends`.
  Pl::ProtoCache::begin_walk();
  my $out = eval { Pl::Parser2->$method($args[0], %opts) };
  my $err = $@;
  $LAST_WALK = Pl::ProtoCache::end_walk();
  die $err if $err;
  return pipeline_marker(v2 => $out);
}

# T0.1 pipeline marker (docs/v2-transfer-plan.md): every transpile carries one
# leading comment line naming the pipeline that produced it, so the dialect
# mix of a corpus — and of ~/.pcl-cache — is auditable.  gen= is read from the
# runtime's *pcl-cache-generation* (the single source of truth; do NOT
# duplicate the string here — a wrong gen in the marker would be worse than
# none when debugging stale-cache problems).  ONE reader: Pl::ProtoCache keys
# its entries by the same string and does the reading (task #560).
sub cache_generation { return Pl::ProtoCache::generation() }

sub pipeline_marker {
  my ($pipeline, $out) = @_;
  return $out unless defined $out;
  return ";;; pcl: pipeline=$pipeline gen=" . cache_generation() . "\n" . $out;
}

# Parse command line options
my $no_cache = $ENV{PCL_NO_CACHE} // 0;
my $cache_lisp = 0;
my $is_module = 0;      # When true, skip preamble (for dynamic module loading)
my $is_extension = 0;   # When true, skip preamble (checked-in artifact build)
my $bundle_mode = 0;    # Compile to single .fasl
my $executable_mode = 0; # Create standalone executable
my $output_file;        # Output file for bundle/executable
my $lenient_ppi = 0;    # DEBUG: truncate at first PPI-unparseable line (test runner only)
my $eval_pkg;           # When set, emit minimal preamble for eval-string mode
my $server_mode = 0;    # Persistent transpiler server mode
my $xserver_mode = 0;   # Persistent COMMAND-LINE server for the test harness
my $xsock;              # ... its socket path
my $xowner;             # ... the pid whose death ends it
my $manifest_mode = 0;  # Print the per-program manifest as JSON, not the CL
my $facts_mode = 0;     # Annotate the emission with every Kind-A/B licence
my $sexp_mode = 0;      # Print the lowered tree as PORTABLE S-expressions
my $deps_file;          # Write the dependency manifest sidecar here (#1261)
my $want_help = 0;      # --help; without it GetOptions answered "Unknown option: help"
# my $use_cache = 0;    # Opt-in caching (disabled by default) - COMMENTED OUT FOR NOW

# ONE usage text, printed by --help (exit 0) and by a run with no source at
# all (exit 1) — they used to be one text and one absence.
sub usage_text {
  return <<'USAGE';
Usage: pl2cl [options] <file.pl>
   or: pl2cl '$x = 1;'
   or: echo '$x = 1;' | pl2cl

Transpiles Perl to Common Lisp on stdout.  `pcl` is the everyday command --
it runs the result; this is the compiler behind it.

Modes:
  (default)       Transpile to stdout
  --bundle        Compile to single .fasl with runtime + all dependencies
  --executable    Create standalone executable (bonus feature!)

Options:
  -h, --help      This message
