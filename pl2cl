# Option parsing is a SUB rather than top-level code because `--xserver`
# (task #1545) runs it a second time, in a forked child, on the argv of a
# request — so a flag cannot mean something different when it arrives over a
# socket than it does on a command line.  Called once at the bottom of this
# file for the ordinary run.
sub _parse_options {
GetOptions(
  'h|help'       => \$want_help,
  'no-cache'     => \$no_cache,
  'cache-lisp'   => \$cache_lisp,
  'module'       => \$is_module,
  'extension'    => \$is_extension,  # build a checked-in cl/*.lisp artifact
  'bundle'       => \$bundle_mode,
  'executable'   => \$executable_mode,
  'output|o=s'   => \$output_file,
  'lenient-ppi'  => \$lenient_ppi,   # DEBUG: for test runner use only
  'eval-pkg=s'   => \$eval_pkg,      # eval "string" mode: minimal preamble for named package
  'server'       => \$server_mode,   # persistent transpiler server mode
  'xserver'      => \$xserver_mode,  # persistent COMMAND-LINE server (#1545)
  'xsock=s'      => \$xsock,         # ... its socket path
  'xowner=i'     => \$xowner,        # ... the pid whose death ends it
  "manifest"     => \$manifest_mode, # print the JSON manifest INSTEAD of the CL
  "facts"        => \$facts_mode,    # wrap licensed forms in (p-fact (NAME) FORM)
  "emit-sexp"    => \$sexp_mode,     # print the data form INSTEAD of the CL
  "deps=s"       => \$deps_file,     # write the dependency manifest sidecar
  # 'cache'      => \$use_cache,  # COMMENTED OUT - caching disabled by default
) or do {
  # An EXPLICIT exit code, not `die`: perl's exit status for an uncaught die is
  # "$! if nonzero, else $?>>8 if nonzero, else 255", i.e. whatever errno the
  # option parser happened to leave behind -- 255 on perl 5.40, ENOENT (2) on
  # 5.38's Getopt::Long -- so two paths that both die can exit DIFFERENTLY
  # on one perl and identically on another.  CI (perl 5.38) read 2 from a
  # spawned pl2cl and 255 from the transpile server's child for the same
  # unknown option (Pl/t/gate-cost-01.t row 16, s478).  A usage error is exit
  # 2 everywhere, on purpose.
  print STDERR usage_text();
  exit 2;
};

if ($want_help) { print usage_text(); exit 0 }

# THE PER-PROGRAM MANIFEST (task #1171; docs/plan-speed-and-ir-s470.md Part B
# item B2, grammar in docs/ir-spec.md §10b).  `--manifest` prints JSON saying
# what the program demands of a target — uses / needs / facts — INSTEAD of the
# CL, so it cannot contaminate an output file.  The counts come from ONE walk
# of the lowered CLForm tree, hooked into Pl::Passes::run; with the flag absent
# nothing is loaded and nothing is walked.
if ($manifest_mode) {
  require Pl::Manifest;
  Pl::Manifest::enable();
}

# `--facts` (task #1213; docs/plan-speed-and-ir-s470.md §B.3): every Kind-A /
# Kind-B licence that HELD is printed as `(p-fact (NAME) FORM)` around the form
# it licensed, so `PCL_OPT=none --facts` is the general-form IR with the
# compiler's proofs attached — what a foreign backend needs in order to pick
# ITS own fast shapes.  `p-fact` expands to FORM, so the annotation costs
# nothing at run time; the flag is off by default, so the emission cannot move.
Pl::Passes::facts_on(1) if $facts_mode;

# `--emit-sexp` (task #1215; Part B item B5, grammar in docs/ir-spec.md §12b):
# print the lowered CLForm tree as PORTABLE S-expressions — every symbol
# pipe-quoted, every string 7-bit and one line, no comments — INSTEAD of the
# CL, so a consumer parses the program with a ~50-line reader in any language
# instead of implementing CL's five reader rules (ir-spec §11b).  It is a
# SECOND PRINTER over the same tree, so the default emission cannot move.
#
# `--manifest` and `--emit-sexp` both install the observer hook, and there is
# ONE hook slot: asking for both is an error naming both rather than a silent
# win for whichever registered last.
die "pl2cl: --manifest and --emit-sexp cannot be combined (one observer hook)\n"
  if $manifest_mode && $sexp_mode;
if ($sexp_mode) {
  require Pl::DataForm;
  Pl::DataForm::enable();
}

# The #138-family drop announcement (task #339) is a diagnostic for the person
# running a transpile.  `--module` is the RUNTIME transpiling a module in the
# middle of a program run (p-transpile-file), so its stderr is the PROGRAM's —
# and it only happens on a cold module cache, which would make the line
# nondeterministic on top of noisy.  Off there; PCL_DROP_ANNOUNCE=all forces it
# back on (that is how you see the drop inside a CPAN module).
$Pl::Parser::ANNOUNCE_DROPS = 0 if $is_module;
return;
}   # _parse_options

# Get path to this script for runtime to use
my $script_path = abs_path($0);

# Get Perl's @INC (filter to existing directories)
my @perl_inc = grep { $_ && -d $_ } @INC;

# Build preamble to inject after (in-package :pcl)
sub build_preamble {
  my ($source_file) = @_;
  my @lines;

  # Set pl2cl path for dynamic requires
  push @lines, "(setf pcl::*pcl-pl2cl-path* #P\"$script_path\")";

  # $0 — the program name, which is the script AS GIVEN, exactly as perl
  # reports it (task #512).  The runtime's own default is argv[0], i.e. the
  # SBCL binary, which no Perl program means by $0; a program read from stdin
  # is "-", as under `perl` with no file.  This is a PROGRAM preamble only —
  # `--module` and `--extension` skip it, so loading a module cannot clobber
  # the program's $0.
  my $dollar0 = (defined $source_file && length $source_file) ? $source_file : '-';
  $dollar0 =~ s/\\/\\\\/g;
  $dollar0 =~ s/"/\\"/g;
  push @lines, "(pcl::box-set pcl::\$0 \"$dollar0\")";

  # Cache settings
  push @lines, "(setf pcl::*pcl-skip-cache* t)" if $no_cache;
  push @lines, "(setf pcl::*pcl-cache-fasl* nil)" if $cache_lisp;

  # Initialize @INC from Perl's @INC
  push @lines, ";; Initialize \@INC from Perl";
  push @lines, "(setf pcl::\@INC (make-array 0 :adjustable t :fill-pointer 0))";

  # Add source file directory first (like Perl does)
  if ($source_file && -f $source_file) {
    my $source_dir = File::Spec->rel2abs(
      (File::Spec->splitpath($source_file))[1] || '.'
    );
    push @lines, "(vector-push-extend \"$source_dir\" pcl::\@INC)";
  }

  # Add current directory
  push @lines, "(vector-push-extend \".\" pcl::\@INC)";

  # Add PCL's lib/ directory (for our stub modules like Config.pm)
  my $pcl_lib = "$ROOT/lib";
  if (-d $pcl_lib) {
    push @lines, "(vector-push-extend \"$pcl_lib\" pcl::\@INC)";
  }

  # Add Perl's @INC paths
  my @core_inc;
  push @core_inc, $pcl_lib if -d $pcl_lib;
  for my $path (@perl_inc) {
    # Escape backslashes and quotes
    $path =~ s/\\/\\\\/g;
    $path =~ s/"/\\"/g;
    push @lines, "(vector-push-extend \"$path\" pcl::\@INC)";
    push @core_inc, $path;
  }

  # Record the "built-in" module paths (PCL lib/ shims + system perl's libs).
  # They play the role of perl's compiled-in default @INC: user code that
  # REPLACES @INC (`BEGIN { @INC = '../lib' }` in t/run/*) must still resolve
  # core modules, whose PCL equivalents live in these dirs.
  push @lines, "(setf pcl::*p-core-inc-dirs* (list "
    . join(" ", map { "\"$_\"" } @core_inc) . "))";

  # Switch to main package for user code (Perl's default package)
  # main uses :cl and :pcl so runtime functions are accessible
  push @lines, ";; Switch to main package (Perl's default for code without 'package' statement)";
  push @lines, "(p-defpackage :main)";
  push @lines, "(in-package :main)";

  return join("\n", @lines);
}

# Build MINIMAL preamble for eval-string mode.
# Only switches to the named package — all other state (@INC, *pcl-pl2cl-path*,
# etc.) is already live in the running SBCL image.
sub build_eval_preamble {
  my ($pkg_name) = @_;
  # $pkg_name is the Perl package name (e.g. "main", "Foo", "Bar::Baz").  The
  # designator rule lives in ONE place, Pl::CLForm::cl_pkg (rule 11), and this
  # is the EVAL-mode twin of Parser::_cl_pkg_designator: it must answer
  # identically or a string eval resolves its globals in a different CL package
  # than the file that called it.  Single-segment ASCII names stay bare (the
  # reader case-folds, :main -> MAIN, :Foo -> Foo); a multi-segment name is
  # pipe-quoted to preserve '::' and case; and so is a name carrying a
  # non-ASCII character (task #418 — a bare token is NFKC-normalized AND
  # :invert-ed, so a fullwidth designator reads as an all-lowercase ASCII
  # package name that no runtime string ever spells).  Measured s423: without
  # the last rule, `our $z` inside `package <fullwidth>` read back undef from
  # a string eval in that same package.
  my $desig = ':' . Pl::CLForm::cl_pkg($pkg_name);
  return "(p-defpackage $desig)\n(in-package $desig)";
}

sub _run_server {
  # Persistent transpiler server: read requests from stdin, write CL to stdout.
  # Character-based protocol (UTF-8 on both sides, lengths = char counts):
  #   Request:  "<pkg>\n<captures>\n<features>\n<deps-path>\n<char-count>\n<perl-code: exactly char-count chars>"
  #   Response: "ok\n<char-count>\n<cl-code: exactly char-count chars>"
  #          or "err\n<char-count>\n<error: exactly char-count chars>"
  # <deps-path>, when non-empty, is where this transpile's DEPENDENCY MANIFEST
  # goes (task #1200): the runtime's string-eval disk cache keeps the emitted
  # CL beside a `.deps` sidecar and validates it with exactly the reader the
  # module cache uses (#1261), so an eval whose text `use`s a module is
  # re-transpiled when that module changes.  Written BEFORE the response, for
  # the same reason the file path writes it before the emission reaches the
  # caller: the sidecar must already be there when the .lisp becomes valid.
  # <captures> is the space-separated list of the caller's in-scope lexical
  # names (the eval capture alist's keys), possibly empty.  Only ONE decision
  # reads it — #296-B1, "is this exception-partition name the caller's `my $a`
  # or the dynamic special" — and the runtime keys its eval cache on the same
  # list, because it is compiler INPUT.
  # <features> is the space-separated list of perl features in effect at the
  # eval SITE (#364).  perl's feature pragmas are lexical and a string eval
  # inherits them; this parse only sees the bare text, so the site has to say.
  # Compiler input in the same sense, and keyed into the same cache.
  binmode(STDIN,  ':encoding(utf-8)');
  binmode(STDOUT, ':encoding(utf-8)');

  # LIVENESS (task #273, ruled s397).  This loop looks at STDIN only BETWEEN
  # requests, so a server whose client SBCL is SIGKILLed while a transpile is
  # in flight never sees the EOF: it is reparented (to init, or to the
  # session's subreaper -- `systemd --user` on a desktop login, which is why
  # a PPID==1 test in the callers never fired) and grinds on holding
  # gigabytes (s396: two orphans at 4.8 GB and 4.6 GB for half an hour).  The
  # one process that KNOWS the client is gone is this one, so it asks: a
  # once-a-second tick compares getppid() with the client's pid, and a
  # changed answer means the reply would go nowhere.  Safe signals deliver
  # the tick between perl ops, so it fires inside a long transpile too (worst
  # case: after the current op -- a long regex match -- completes); the
  # blocking reads below are EINTR-safe (PerlIO retries after the handler).
  # _exit, not exit: nothing to flush, no partial reply to a dead pipe.
  my $client = getppid();
  $SIG{ALRM} = sub { POSIX::_exit(0) if getppid() != $client; alarm 1 };
  alarm 1;

  while (1) {
    my $pkg = <STDIN>;
    last unless defined $pkg;
    chomp $pkg;

    my $caps_str = <STDIN>;
    last unless defined $caps_str;
    chomp $caps_str;
    my @caps = split ' ', $caps_str;

    my $feat_str = <STDIN>;
    last unless defined $feat_str;
    chomp $feat_str;
    my @feats = split ' ', $feat_str;

    my $deps_path = <STDIN>;
    last unless defined $deps_path;
    chomp $deps_path;

    my $len_str = <STDIN>;
    last unless defined $len_str;
    chomp $len_str;
    my $len = $len_str + 0;

    my $code = '';
    my $got = read(STDIN, $code, $len);
    last unless defined $got && $got == $len;

    my $cl = eval {
      my $output = parse_source('parse_code', $code,
                                       eval_mode => 1, eval_pkg => $pkg,
                                       eval_captures => \@caps,
                                       eval_features => \@feats);
      my $preamble = build_eval_preamble($pkg);
      $output =~ s/\(in-package :pcl\)/$preamble/;
      $output
    };

    # The sidecar, before the response (see the protocol note above).  The
    # "source" this manifest names is the cache entry itself: an eval has no
    # source file, and the only lines the runtime reads back are the `dep`
    # ones.
    Pl::ProtoCache::write_deps_file($deps_path, $deps_path, $LAST_WALK)
      if length $deps_path && !$@;

    my ($status, $body);
    if ($@) {
      $status = 'err';
      $body   = "$@";
    } else {
      $status = 'ok';
      $body   = $cl;
    }

    print STDOUT "$status\n" . length($body) . "\n$body";
    STDOUT->flush;
  }
}

# Get runtime content for bundling
sub get_runtime_content {
  my $runtime_path = "$ROOT/cl/pcl-runtime.lisp";

  open my $fh, '<', $runtime_path
    or die "Cannot read runtime: $runtime_path: $!";
  local $/;
  my $content = <$fh>;
  close $fh;

  return $content;
}

# Bundle mode: compile main file + all dependencies into single output
sub do_bundle {
  my ($source_file, $output_file, $executable) = @_;

  # Default output name
  unless ($output_file) {
    my $base = basename($source_file, '.pl', '.pm');
    $output_file = $executable ? $base : "$base.fasl";
  }

  my $lisp_file = "$output_file.lisp";

  say STDERR "Bundling: $source_file -> $output_file";

  # Transpile the main file (dependencies are loaded at run time via p-use).
  # E4.1 step 1: bundle mode used to call Pl::Parser->parse_file directly — the
  # one v1-ONLY bypass left in pl2cl.  It now goes through the same entry as
  # every other file transpile, so the gate flip in step 2 covers it too.
  my $transpiled = parse_source('parse_file', $source_file);

  # Inject preamble
  my $preamble = build_preamble($source_file);
  $transpiled =~ s/(\(in-package :pcl\))/$1\n$preamble/;

  # Build the bundle
  open my $out, '>', $lisp_file
    or die "Cannot write $lisp_file: $!";

  # 1. Runtime first
  print $out ";; === PCL Runtime ===\n";
  print $out get_runtime_content();
  print $out "\n\n";

  # 2. Transpiled code (includes all dependencies via 'use')
  print $out ";; === Transpiled: $source_file ===\n";
  print $out $transpiled;
  print $out "\n";

  close $out;

  say STDERR "  Written: $lisp_file";

  if ($executable) {
    # Create standalone executable
    # NOTE: one --eval = ONE expression for SBCL, hence the progn.
    my $save_code = qq{
      (progn
      (load "$lisp_file")
      (sb-ext:save-lisp-and-die "$output_file"
        :toplevel (lambda ()
                    (handler-case
                      (sb-ext:exit :code 0)
                      (error (e)
                        (format *error-output* "Error: ~A~%" e)
                        (sb-ext:exit :code 1))))
        :executable t))
    };

    say STDERR "  Creating executable...";
    system('sbcl', '--noinform', '--non-interactive',
           '--eval', $save_code);

    if ($? == 0) {
      say STDERR "  Created: $output_file";
      # Clean up intermediate file
      unlink $lisp_file;
    } else {
      die "Failed to create executable (sbcl exit code: $?)\n";
    }
  } else {
    # Compile to FASL - load the file first (which loads ASDF/cl-ppcre), then compile
    say STDERR "  Compiling to FASL...";
    system('sbcl', '--noinform', '--non-interactive',
           '--load', $lisp_file,
           '--eval', qq{(compile-file "$lisp_file" :output-file "$output_file")},
           '--eval', '(sb-ext:exit)');

    if ($? == 0) {
      say STDERR "  Created: $output_file";
    } else {
      die "Failed to compile (sbcl exit code: $?)\n";
    }
  }
}

# Print the manifest for whatever was just transpiled and exit.  ONE place, so
# the file path and the mode label cannot drift between the two entry points.
# The data form for whatever was just transpiled, and exit.  ONE place, like
# print_manifest, so the two entry points cannot drift.
sub print_sexp {
  my ($file) = @_;
  binmode(STDOUT, ':raw');
  print Pl::DataForm::program(
    file       => $file,
    mode       => ($is_module ? 'module' : $is_extension ? 'extension'
                              : defined $eval_pkg ? 'eval' : 'program'),
    generation => cache_generation(),
  );
  return;
}

sub print_manifest {
  my ($file) = @_;
  require JSON::PP;   # core
  my $m = Pl::Manifest::report(
    file       => $file,
    mode       => ($is_module ? 'module' : $is_extension ? 'extension'
                              : defined $eval_pkg ? 'eval' : 'program'),
    generation => cache_generation(),
    # `depends` comes from the SAME walk the cache sidecar is written from
    # (task #1261) — one walk, two consumers.
    depends    => Pl::ProtoCache::depends_records($LAST_WALK),
  );
  binmode(STDOUT, ':raw');
  print JSON::PP->new->utf8->canonical->pretty->encode($m);
  return;
}

# ONE run of the command line, called from the bottom of this file for an
# ordinary invocation and from a forked child for each `--xserver` request
# (task #1545).  The body is left at column 0: it moved into this sub
# unchanged, and a re-indent would have hidden that in the diff.
sub _run_cli {

if ($server_mode) {
  _run_server();
  exit 0;
}

my $code;
my $source_file;

# Handle bundle/executable modes
if ($bundle_mode || $executable_mode) {
  die "Bundle/executable mode requires a source file\n" unless @ARGV && -f $ARGV[0];
  do_bundle($ARGV[0], $output_file, $executable_mode);
  exit 0;
}

if (@ARGV && -f $ARGV[0]) {
  $source_file = $ARGV[0];
  my $output = parse_source('parse_file', $source_file,
    ($lenient_ppi ? (lenient_ppi => 1) : ()));

  # THE DEPENDENCY MANIFEST SIDECAR (task #1261).  Written BEFORE the emission
  # reaches the caller, because the runtime writes the cached .lisp from what
  # it reads on stdout: the sidecar must already be there when the .lisp
  # becomes valid, or the very next run would see a manifest-less entry and
  # re-transpile.  A manifest is only ever written when asked for.
  Pl::ProtoCache::write_deps_file($deps_file, $source_file, $LAST_WALK)
    if defined $deps_file;

  if ($manifest_mode) { print_manifest($source_file); exit 0 }
  if ($sexp_mode)     { print_sexp($source_file);     exit 0 }

  if ($is_module || $is_extension) {
    # Module / extension mode: skip full preamble (@INC etc. are already live in
    # the running SBCL), but still inject the default package switch so subs are
    # defined in :main, not :pcl.  Any explicit 'package Foo' in the module will
    # override this immediately.
    #
    # --extension is the ARTIFACT build (cl/pcl-pack.lisp & co., task #349).  An
    # extension is `load`ed INTO a running program by p-load-extension, so a
    # program preamble there is not merely redundant, it is WRONG: it REPLACED
    # the running program's @INC with the build machine's list at the first
    # pack/mro/warnings call, silently losing a runtime `push @INC` (probed vs
    # perl on the task), and it is why the checked-in artifacts embedded this
    # machine's absolute paths at all (task #217).  It differs from --module
    # only in that it is a DEVELOPER-run build, so the drop announcement stays
    # on (see the $Pl::Parser::ANNOUNCE_DROPS note above).
    $output =~ s/(\(in-package :pcl\))/$1\n(p-defpackage :main)\n(in-package :main)/;
  } else {
    my $preamble = build_preamble($source_file);
    $output =~ s/(\(in-package :pcl\))/$1\n$preamble/;
  }

  print $output;
}
elsif (@ARGV) {
  # Treat arguments as code (no @INC init needed for one-liners)
  $code = join(' ', @ARGV);
  print parse_source('parse_code', $code);
}
elsif (!-t STDIN) {
  # Read from stdin.  SCOPE the slurp: a bare `local $/;` here stays in effect
  # for the whole branch — including the parse below — and PPI's tokenization
  # of a trailing `__END__`/`__DATA__` section DEPENDS on `$/` (measured:
  # the same bytes gain one newline when parsed with `$/` undef, see
  # docs/ppi-upstream-bugs.md §13).  That silently added an empty line to the
  # DATA handle of every program transpiled through the stdin path — which is
  # how tools/emission-ab.pl feeds files.
  $code = do { local $/; <STDIN> };
  my $output = parse_source('parse_code', $code,
                 (defined $eval_pkg ? (eval_mode => 1, eval_pkg => $eval_pkg) : ()));

  if ($manifest_mode) { print_manifest("-"); exit 0 }
  if ($sexp_mode)     { print_sexp("-");     exit 0 }

  if (defined $eval_pkg) {
    # eval-string mode: REPLACE (in-package :pcl) with just the package switch.
    # @INC, *pcl-pl2cl-path* etc. are already live in the running SBCL.
    my $preamble = build_eval_preamble($eval_pkg);
    $output =~ s/\(in-package :pcl\)/$preamble/;
  } else {
    # Normal stdin: inject full preamble after (in-package :pcl)
    my $preamble = build_preamble(undef);
    $output =~ s/(\(in-package :pcl\))/$1\n$preamble/;
  }

  print $output;
}
else {
  print usage_text();
  exit 1;
}

print "\n";
return;
}   # _run_cli

# ---- THE TRANSPILE SERVER FOR THE TEST HARNESS (task #1545) ---------------
#
# NOT `--server`, and the two must never merge: that one answers the RUNTIME's
# string-eval requests, in eval mode, in its own process, over a protocol the
# runtime speaks.  This one answers whole COMMAND LINES from Pl/t — one
# already-loaded pl2cl per test process — and it answers each of them in a
# FORKED CHILD.  The fork is the entire correctness argument: the parent never
# transpiles, so every request starts from the module state of a freshly
# spawned pl2cl (the renamed-lexical counters, the announce-once hashes,
# Pl::Environment), and the child re-parses the request's argv with the same
# GetOptions the command line uses.
#
# LIVENESS is the same rule as `--server` (ruled s397): the process that can
# outlive its client is the one that knows it did.  The owner is the TEST
# process, named on our own command line — not our parent, since the client
# double-forked away from us.
sub _run_xserver {
  my ($path, $owner) = @_;
  die "pl2cl --xserver: --xsock PATH is required\n" if !defined $path;
  require Socket;
  require Errno;   # %! below — loaded here, not lazily inside a signal path
  socket(my $srv, Socket::PF_UNIX(), Socket::SOCK_STREAM(), 0)
    or die "pl2cl --xserver: socket: $!\n";
  # Losing a start race is a SUCCESS: the client that spawned us is polling a
  # socket someone else already answers.  ASK before unlinking — the naive
  # `unlink; bind` pair removes a LIVE server's socket file and then binds
  # happily, which leaves two servers with the second one shadowing the first
  # and no bind failure to notice it by.
  if (my $live = _xc_connect($path)) { close $live; POSIX::_exit(0) }
  unlink $path;
  bind($srv, Socket::pack_sockaddr_un($path)) or POSIX::_exit(0);
  listen($srv, 32) or die "pl2cl --xserver: listen: $!\n";
  $SIG{ALRM} = sub {
    POSIX::_exit(0) if !defined $owner || !kill(0, $owner);
    alarm 1;
  };
  alarm 1;
  $SIG{PIPE} = 'IGNORE';
  my $dir = $path;
  $dir =~ s{/[^/]*$}{};
  while (1) {
    my $ok = accept(my $conn, $srv);
    next if !$ok;                # EINTR from the liveness tick
    binmode($conn, ':raw');
    _xserve($conn, $dir);
    close $conn;
  }
  return;
}

# One request: fork, run it as an ordinary pl2cl, ship back stdout, stderr and
# the exit status.  The child's output goes through FILES rather than pipes
# because two pipes need a select loop to avoid deadlocking on a big write, and
# the emission is the one thing here that is reliably big.
sub _xserve {
  my ($conn, $dir) = @_;
  my $req = _xread_request($conn);
  return if !$req;
  my ($cwd, $argv, $env) = @$req;
  my ($out, $err) = ("$dir/o.$$", "$dir/e.$$");
  my $pid = fork();
  if (!defined $pid) { print {$conn} "PCLXS2 256 0 0\n"; return }   # exit 1
  if (!$pid) {
    open(STDIN,  '<', '/dev/null');
    open(STDOUT, '>', $out) or POSIX::_exit(1);
    open(STDERR, '>', $err) or POSIX::_exit(1);
    binmode(STDOUT, ':utf8');   # reopening dropped the layers set at load
    binmode(STDERR, ':utf8');
    # The child must look like a fresh pl2cl in every way a transpile can
    # observe: the liveness tick and the SIGPIPE policy are the SERVER's, not
    # a compiler's.  (The alarm TIMER is already cleared by fork; the handlers
    # are not.)
    $SIG{ALRM} = 'DEFAULT';
    $SIG{PIPE} = 'DEFAULT';
    %ENV = %$env;
    chdir($cwd) or POSIX::_exit(1);
    @ARGV = @$argv;
    # A freshly spawned pl2cl starts with $! and $? clear; this child inherited
    # whatever the server's socket work left in them, and perl's exit code for
    # an uncaught die is "$! if nonzero, else $?>>8 if nonzero, else 255" — so
    # without this an uncaught die here exited 25 (ENOTTY from accept).  Even
    # with it, a die's exit code is errno NOISE in BOTH paths (perl-defined, and
    # perl-version-dependent: s478's CI red), so no row asserts it exactly; the
    # one failure a row compares, the usage error, is an explicit `exit 2`.
    ($!, $?) = (0, 0);
    ($xserver_mode, $xsock, $xowner) = (0, undef, undef);
    _parse_options();
    _run_cli();
    exit 0;
  }
  # The once-a-second liveness tick interrupts this wait, and perl does NOT
  # retry an EINTR'd waitpid — it returns -1 and leaves $? meaningless, which
  # would report a wrong exit status for every transpile longer than a second.
  my $got;
  do { $got = waitpid($pid, 0) } while ($got == -1 && $!{EINTR});
  # The RAW wait status travels, not a cooked exit code: the client re-raises a
  # signal death as a signal death, so the caller's $? is what a spawn's would
  # have been in both halves of its word.
  my $st = $?;
  my ($o, $e) = (_xslurp($out), _xslurp($err));
  unlink $out, $err;
  print {$conn} "PCLXS2 $st " . length($o) . " " . length($e) . "\n" . $o . $e;
  return;
}

sub _xslurp {
  my ($p) = @_;
  open my $fh, '<:raw', $p or return '';
  local $/;
  my $s = <$fh>;
  close $fh;
  return defined $s ? $s : '';
}

# "PCLXS2 <len>\n" then <len> bytes of length-prefixed fields:
#   cwd, argc, argv…, envc, (key, value)…
# Length prefixes rather than a separator character, because an argument or an
# environment value may contain anything at all.
sub _xread_request {
  my ($conn) = @_;
  # Every read here can be interrupted by the liveness tick, so EINTR is a
  # RETRY, never a dropped request.
  my $hdr = '';
  while (1) {
    my $got = sysread($conn, my $c, 1);
    next if !defined $got && $!{EINTR};
    return undef if !defined $got || $got == 0;
    last if $c eq "\n";
    $hdr .= $c;
    return undef if length($hdr) > 64;
  }
  return undef if $hdr !~ /^PCLXS2 (\d+)$/;
  my $len = $1;
  my $blob = '';
  while (length($blob) < $len) {
    my $got = sysread($conn, my $c, $len - length($blob));
    next if !defined $got && $!{EINTR};
    return undef if !defined $got || $got == 0;
    $blob .= $c;
  }
  my @f;
  while (length $blob) {
    return undef if $blob !~ s/^(\d+)://s;
    my $n = $1;
    push @f, substr($blob, 0, $n);
    substr($blob, 0, $n + 1) = '';
  }
  return undef if @f < 2;
  my $cwd  = shift @f;
  my $na   = shift @f;
  my @argv = splice(@f, 0, $na);
  my $ne   = @f ? shift @f : 0;
  my %env  = splice(@f, 0, 2 * $ne);
  return [ $cwd, \@argv, \%env ];
}

# ---- the ordinary run -----------------------------------------------------
_parse_options();
_run_xserver($xsock, $xowner) if $xserver_mode;   # never returns
_run_cli();
